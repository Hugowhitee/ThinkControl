<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <AnalysisLevel>latest</AnalysisLevel>

    <Product>ThinkControl</Product>
    <Authors>ThinkControl Project</Authors>
    <Company>ThinkControl Project</Company>
    <RepositoryUrl>https://github.com/Hugowhitee/ThinkControl</RepositoryUrl>

    <!-- version.json is the repository source of truth. Package CI may override the
         informational version with APP_VERSION for dev artifacts while tagged builds
         resolve to the exact source version. This keeps normal local/CI builds from
         silently reporting an old hard-coded alpha version. -->
    <ThinkControlVersionJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.json'))</ThinkControlVersionJson>
    <ThinkControlSourceVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(ThinkControlVersionJson)', '(?s).*&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;.*', '$1'))</ThinkControlSourceVersion>
    <Version Condition="'$(APP_VERSION)' != ''">$(APP_VERSION)</Version>
    <Version Condition="'$(APP_VERSION)' == ''">$(ThinkControlSourceVersion)</Version>

    <AssemblyVersion Condition="'$(NUMERIC_VERSION)' != ''">$(NUMERIC_VERSION)</AssemblyVersion>
    <AssemblyVersion Condition="'$(NUMERIC_VERSION)' == ''">0.1.0.0</AssemblyVersion>
    <FileVersion Condition="'$(NUMERIC_VERSION)' != ''">$(NUMERIC_VERSION)</FileVersion>
    <FileVersion Condition="'$(NUMERIC_VERSION)' == ''">0.1.0.0</FileVersion>
  </PropertyGroup>
</Project>
