<Window x:Class="ThinkControl.UI.TelemetryDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
        Title="ThinkControl · Details"
        Width="720" Height="600" MinWidth="540" MinHeight="430"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Tc.Window}"
        Foreground="{DynamicResource Tc.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Margin="0,5,0,0" FontSize="10.5" Foreground="{DynamicResource Tc.TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,12">
            <StackPanel>
                <UniformGrid x:Name="MetricsGrid" Rows="1" Margin="0,0,0,14" />

                <Border x:Name="SecondaryChartCard" Style="{StaticResource TcSection}" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="145" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock x:Name="SecondaryChartTitleText" FontWeight="SemiBold" />
                            <TextBlock HorizontalAlignment="Right" FontSize="9.5" Foreground="{DynamicResource Tc.TextFaint}" Text="Battery level over the same session" />
                        </Grid>
                        <controls:TimeSeriesChart x:Name="SecondaryDetailChart" Grid.Row="1" Margin="0,8,0,0" IncludeZero="False" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource TcSection}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="200" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock x:Name="ChartTitleText" FontWeight="SemiBold" />
                            <TextBlock x:Name="ChartHintText" HorizontalAlignment="Right" FontSize="9.5" Foreground="{DynamicResource Tc.TextFaint}" Text="Hover for exact values" />
                        </Grid>
                        <controls:TimeSeriesChart x:Name="DetailChart" Grid.Row="1" Margin="0,10,0,0" IncludeZero="True" />
                    </Grid>
                </Border>
                <TextBlock x:Name="FooterText" Margin="2,10,2,0" FontSize="9.5" Foreground="{DynamicResource Tc.TextFaint}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Close" Style="{StaticResource TcButton}" HorizontalAlignment="Right" Padding="14,6" Click="Close_Click" />
    </Grid>
</Window>
