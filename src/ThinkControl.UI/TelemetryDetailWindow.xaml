<Window x:Class="ThinkControl.UI.TelemetryDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
        Title="ThinkControl · Details"
        Width="760" Height="620" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Tc.Window}"
        Foreground="{DynamicResource Tc.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Margin="0,5,0,0" FontSize="10.5" Foreground="{DynamicResource Tc.TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,12">
            <StackPanel>
                <UniformGrid x:Name="MetricsGrid" Columns="3" Margin="0,0,0,10" />

                <Border Style="{StaticResource TcSection}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="220" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ChartTitleText" FontWeight="SemiBold" />
                                <TextBlock x:Name="ChartHintText" Margin="0,3,0,0" FontSize="9.5" Foreground="{DynamicResource Tc.TextFaint}" Text="Hover for exact values" />
                            </StackPanel>
                            <StackPanel x:Name="ChartModePanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button x:Name="PrimaryChartButton" Content="Power" Style="{StaticResource TcButton}" Padding="10,4" MinWidth="68" Click="PrimaryChart_Click" />
                                <Button x:Name="SecondaryChartButton" Content="Battery" Style="{StaticResource TcButton}" Padding="10,4" MinWidth="68" Margin="6,0,0,0" Click="SecondaryChart_Click" />
                            </StackPanel>
                        </Grid>
                        <controls:TimeSeriesChart x:Name="DetailChart" Grid.Row="1" Margin="0,10,0,0" IncludeZero="True" GapThresholdMinutes="0" />
                    </Grid>
                </Border>
                <TextBlock x:Name="FooterText" Margin="2,10,2,0" FontSize="9.5" Foreground="{DynamicResource Tc.TextFaint}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Close" Style="{StaticResource TcButton}" HorizontalAlignment="Right" Padding="14,6" Click="Close_Click" />
    </Grid>
</Window>
