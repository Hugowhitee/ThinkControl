<UserControl x:Class="ThinkControl.UI.Controls.ModesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ThinkControl.UI"
             xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
             MinWidth="520">
    <UserControl.Resources>
        <Style x:Key="ModeRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Tc.Text}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="2,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Tc.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Tc.SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Tc.Text}" />
            <Setter Property="Background" Value="{DynamicResource Tc.SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tc.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="CaretBrush" Value="{DynamicResource Tc.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Tc.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <controls:AdvancedPageHeader x:Name="Header"
                                     Title="Modes"
                                     Subtitle="Switch several settings together, manually or automatically." />

        <StackPanel x:Name="ListView">
            <Border Style="{StaticResource TcSection}" Padding="0">
                <StackPanel>
                    <Grid Margin="14,12,12,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Saved modes"
                                       FontSize="{x:Static ui:TypographyScale.SectionTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Choose a mode, or edit it to change what it controls."
                                       Foreground="{DynamicResource Tc.TextMuted}"
                                       FontSize="{x:Static ui:TypographyScale.Caption}"
                                       Margin="0,4,140,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="NewModeButton"
                                Content="New mode ▾"
                                Style="{StaticResource TcButton}"
                                Padding="10,4"
                                FontSize="{x:Static ui:TypographyScale.Caption}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="NewMode_Click" />
                    </Grid>

                    <StackPanel x:Name="ModeRows" />

                    <TextBlock x:Name="EmptyModesText"
                               Text="No saved modes yet."
                               Foreground="{DynamicResource Tc.TextMuted}"
                               FontSize="{x:Static ui:TypographyScale.Secondary}"
                               Margin="14,10,14,14"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ListStatusText"
                       Foreground="{DynamicResource Tc.TextMuted}"
                       FontSize="{x:Static ui:TypographyScale.Caption}"
                       Margin="2,9,2,0"
                       Visibility="Collapsed" />
        </StackPanel>

        <StackPanel x:Name="EditorView" Visibility="Collapsed">
            <Border Style="{StaticResource TcSection}">
                <StackPanel>
                    <TextBlock Text="Mode details"
                               FontSize="{x:Static ui:TypographyScale.SectionTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Name"
                               Foreground="{DynamicResource Tc.TextMuted}"
                               FontSize="{x:Static ui:TypographyScale.Caption}"
                               Margin="0,13,0,0" />
                    <TextBox x:Name="ModeNameTextBox"
                             Style="{StaticResource ModeTextBox}"
                             MaxWidth="520"
                             HorizontalAlignment="Stretch"
                             MaxLength="32"
                             Margin="0,7,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TcSection}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Controls"
                                       FontSize="{x:Static ui:TypographyScale.SectionTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Only these settings are temporarily changed while the mode is active."
                                       Foreground="{DynamicResource Tc.TextMuted}"
                                       FontSize="{x:Static ui:TypographyScale.Caption}"
                                       Margin="0,4,130,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="AddSettingButton"
                                Content="Add setting"
                                Style="{StaticResource TcInlineButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="AddSetting_Click" />
                    </Grid>
                    <StackPanel x:Name="EditorSettings" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TcSection}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Automation"
                                       FontSize="{x:Static ui:TypographyScale.SectionTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Turn this mode on when one of its triggers matches."
                                       Foreground="{DynamicResource Tc.TextMuted}"
                                       FontSize="{x:Static ui:TypographyScale.Caption}"
                                       Margin="0,4,70,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="AutomationSwitch"
                                  Style="{StaticResource TcSwitch}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Click="AutomationSwitch_Click" />
                    </Grid>

                    <StackPanel x:Name="AutomationBody" Margin="0,16,0,0">
                        <Grid>
                            <TextBlock Text="Triggers"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="AddTriggerButton"
                                    Content="Add trigger"
                                    Style="{StaticResource TcInlineButton}"
                                    HorizontalAlignment="Right"
                                    Click="AddTrigger_Click" />
                        </Grid>
                        <StackPanel x:Name="EditorTriggers" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="2,10,2,0">
                <Button x:Name="DeleteButton"
                        Content="Delete mode"
                        Style="{StaticResource TcInlineButton}"
                        HorizontalAlignment="Left"
                        Click="Delete_Click"
                        Visibility="Collapsed" />
                <TextBlock x:Name="EditorStatusText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Tc.TextMuted}"
                           FontSize="{x:Static ui:TypographyScale.Caption}"
                           Visibility="Collapsed" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>    </StackPanel>
</UserControl>