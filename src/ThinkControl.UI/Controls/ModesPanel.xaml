<UserControl x:Class="ThinkControl.UI.Controls.ModesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ThinkControl.UI"
             xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
             MinWidth="520">
    <UserControl.Resources>
        <Style x:Key="ModeTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Tc.Text}" />
            <Setter Property="Background" Value="{DynamicResource Tc.SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tc.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="CaretBrush" Value="{DynamicResource Tc.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Tc.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <controls:AdvancedPageHeader x:Name="Header"
                                     Title="Modes"
                                     Subtitle="Saved settings and the rules that activate them." />

        <StackPanel x:Name="ListView">
            <Border Style="{StaticResource TcSection}" Padding="0">
                <StackPanel>
                    <Grid Margin="14,12,12,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Saved modes"
                                       FontSize="{x:Static ui:TypographyScale.SectionTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Select a mode to apply it. The rows below show its settings."
                                       Foreground="{DynamicResource Tc.TextMuted}"
                                       FontSize="{x:Static ui:TypographyScale.Caption}"
                                       Margin="0,4,140,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="NewModeButton"
                                Content="New mode"
                                Style="{StaticResource TcButton}"
                                Padding="10,4"
                                FontSize="{x:Static ui:TypographyScale.Caption}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="NewMode_Click" />
                    </Grid>

                    <ComboBox x:Name="ModeSelector"
                              Style="{StaticResource TcComboBox}"
                              DisplayMemberPath="Name"
                              MinHeight="38"
                              Margin="14,0,14,10"
                              SelectionChanged="ModeSelector_SelectionChanged" />
                    <StackPanel x:Name="ModeRows" />

                    <TextBlock x:Name="EmptyModesText"
                               Text="No saved modes yet."
                               Foreground="{DynamicResource Tc.TextMuted}"
                               FontSize="{x:Static ui:TypographyScale.Secondary}"
                               Margin="14,10,14,14"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ListStatusText"
                       Foreground="{DynamicResource Tc.Accent}"
                       FontSize="{x:Static ui:TypographyScale.Secondary}"
                       TextWrapping="Wrap"
                       Margin="2,9,2,0"
                       Visibility="Collapsed" />

            <Border Style="{StaticResource TcSection}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Automation rules" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="NewRuleButton" Content="New rule" Style="{StaticResource TcInlineButton}"
                                HorizontalAlignment="Right" Click="NewRule_Click" />
                    </Grid>
                    <TextBlock x:Name="AutomationStatusText" Foreground="{DynamicResource Tc.TextMuted}"
                               TextWrapping="Wrap" Margin="0,8,0,10" />
                    <Button x:Name="ResumeAutomationButton" Content="Resume automation" Style="{StaticResource TcInlineButton}"
                            HorizontalAlignment="Left" Click="ResumeAutomation_Click" Visibility="Collapsed" />
                    <StackPanel x:Name="RuleRows" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="EditorView" Visibility="Collapsed">
            <Border Style="{StaticResource TcSection}">
                <StackPanel>
                    <TextBlock x:Name="EditorTitleText" Text="Mode details"
                               FontSize="{x:Static ui:TypographyScale.SectionTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Name"
                               Foreground="{DynamicResource Tc.TextMuted}"
                               FontSize="{x:Static ui:TypographyScale.Caption}"
                               Margin="0,13,0,0" />
                    <TextBox x:Name="ModeNameTextBox"
                             Style="{StaticResource ModeTextBox}"
                             HorizontalAlignment="Stretch"
                             MaxLength="32"
                             Margin="0,7,0,0" />
                    <StackPanel x:Name="RuleTargetPanel" Visibility="Collapsed" Margin="0,13,0,0">
                        <TextBlock Text="Activate mode" Foreground="{DynamicResource Tc.TextMuted}" />
                        <ComboBox x:Name="RuleTargetCombo" DisplayMemberPath="Name" Style="{StaticResource TcComboBox}"
                                  Margin="0,7,0,0" MinHeight="38" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="ModeControlsSection" Style="{StaticResource TcSection}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Controls"
                                       FontSize="{x:Static ui:TypographyScale.SectionTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Only these settings are temporarily changed while the mode is active."
                                       Foreground="{DynamicResource Tc.TextMuted}"
                                       FontSize="{x:Static ui:TypographyScale.Caption}"
                                       Margin="0,4,130,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="AddSettingButton"
                                Content="Add setting"
                                Style="{StaticResource TcInlineButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="AddSetting_Click" />
                    </Grid>
                    <StackPanel x:Name="EditorSettings" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="RuleConditionsSection" Style="{StaticResource TcSection}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Conditions"
                                       FontSize="{x:Static ui:TypographyScale.SectionTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Restores your previous settings when conditions stop matching."
                                       Foreground="{DynamicResource Tc.TextMuted}"
                                       FontSize="{x:Static ui:TypographyScale.Caption}"
                                       Margin="0,4,70,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="AutomationSwitch"
                                  AutomationProperties.Name="Enable rule"
                                  Style="{StaticResource TcSwitch}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Click="AutomationSwitch_Click" />
                    </Grid>

                    <StackPanel x:Name="AutomationBody" Margin="0,16,0,0">
                        <Grid Margin="0,0,0,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="155" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Match" FontWeight="SemiBold" />
                                <TextBlock Text="Any condition or all conditions."
                                           Foreground="{DynamicResource Tc.TextMuted}"
                                           FontSize="{x:Static ui:TypographyScale.Caption}" />
                            </StackPanel>
                            <ComboBox x:Name="TriggerMatchCombo" Grid.Column="1"
                                      Style="{StaticResource TcComboBox}"
                                      MinHeight="38" SelectionChanged="TriggerMatch_Changed">
                                <ComboBoxItem Content="Any condition" />
                                <ComboBoxItem Content="All conditions" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="155" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Priority" FontWeight="SemiBold" />
                                <TextBlock Text="When several rules match."
                                           Foreground="{DynamicResource Tc.TextMuted}"
                                           FontSize="{x:Static ui:TypographyScale.Caption}" />
                            </StackPanel>
                            <ComboBox x:Name="TriggerPriorityCombo" Grid.Column="1"
                                      Style="{StaticResource TcComboBox}"
                                      MinHeight="38" SelectionChanged="TriggerPriority_Changed">
                                <ComboBoxItem Content="Low" />
                                <ComboBoxItem Content="Normal" />
                                <ComboBoxItem Content="High" />
                            </ComboBox>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Triggers"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="AddTriggerButton"
                                    Content="Add trigger"
                                    Style="{StaticResource TcInlineButton}"
                                    HorizontalAlignment="Right"
                                    Click="AddTrigger_Click" />
                        </Grid>
                        <StackPanel x:Name="EditorTriggers" Margin="0,8,0,0" />
                        <TextBlock Margin="0,12,0,0"
                                   Text="Higher priority wins. Ties use app, Wi-Fi, battery, power, then time. A manual selection pauses automation until the winning context changes."
                                   Foreground="{DynamicResource Tc.TextMuted}"
                                   FontSize="{x:Static ui:TypographyScale.Caption}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="2,10,2,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button x:Name="DeleteButton"
                        Content="Delete mode"
                        Style="{StaticResource TcInlineButton}"
                        HorizontalAlignment="Left"
                        Click="Delete_Click"
                        Visibility="Collapsed" />
                <TextBlock x:Name="EditorStatusText"
                           Grid.Column="1" Margin="12,0,0,0" TextWrapping="Wrap"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Tc.TextMuted}"
                           FontSize="{x:Static ui:TypographyScale.Caption}"
                           Visibility="Collapsed" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
