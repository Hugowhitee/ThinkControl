<UserControl x:Class="ThinkControl.UI.Controls.CompactDashboard" xmlns:ui="clr-namespace:ThinkControl.UI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ThinkControl.UI.Controls" MinWidth="420" MinHeight="501" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <Style x:Key="CompactSelect" TargetType="ComboBox" BasedOn="{StaticResource TcComboBox}">
      <Setter Property="Height" Value="38" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="FontSize" Value="{x:Static ui:TypographyScale.Secondary}" />
    </Style>
    <Style x:Key="CompactCaptionButton" TargetType="Button" BasedOn="{StaticResource TcButton}"><Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="MinWidth" Value="40" /><Setter Property="Padding" Value="8,0" /></Style>
    <Style x:Key="CompactNotificationButton" TargetType="Button" BasedOn="{StaticResource TcInlineButton}"><Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="MinWidth" Value="40" /><Setter Property="Padding" Value="8,0" /></Style>
    <Style x:Key="CompactInlineButton" TargetType="Button" BasedOn="{StaticResource TcInlineButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Tc.SurfaceHover}" />
          <Setter Property="Foreground" Value="{DynamicResource Tc.Text}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource Tc.SurfaceAlt}" />
          <Setter Property="Foreground" Value="{DynamicResource Tc.Accent}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CompactQuickCard" TargetType="Border" BasedOn="{StaticResource TcSection}">
      <Setter Property="Padding" Value="12,11" />
    </Style>
    <Style x:Key="CompactMetricSlot" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="MetricRoot" Background="Transparent" CornerRadius="4" SnapsToDevicePixels="True">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MetricRoot" Property="Background" Value="{DynamicResource Tc.SurfaceHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="MetricRoot" Property="Background" Value="{DynamicResource Tc.SurfaceAlt}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Border Background="{DynamicResource Tc.Window}" BorderBrush="{DynamicResource Tc.Border}" BorderThickness="1" CornerRadius="8" Padding="16" SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46" />
        <RowDefinition Height="16" />
        <RowDefinition Height="90" />
        <RowDefinition Height="22" />
        <RowDefinition Height="192" />
        <RowDefinition Height="24" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,2,0,1">
          <controls:BrandWordmark Width="190" Height="44" Margin="-30,0,0,0" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="CompactExpandButton" Style="{StaticResource CompactCaptionButton}" Width="96" Click="Expand_Click" ToolTip="Advanced view" AutomationProperties.AutomationId="CompactExpand" />
          <Button Style="{StaticResource CompactCaptionButton}" Click="Hide_Click" ToolTip="Hide to tray" Margin="8,0,0,0">
            <controls:PackIconLucide Kind="Close" Width="18" Height="18" />
          </Button>
        </StackPanel>
      </Grid>
      <Border x:Name="CompactMetricsCard" Grid.Row="2" Style="{StaticResource TcSection}" Padding="0" Margin="0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="1" />
            <ColumnDefinition />
            <ColumnDefinition Width="1" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Button x:Name="CompactMetricSlot0" Style="{StaticResource CompactMetricSlot}" Tag="0" Click="CompactMetricSlot_Click" />
          <Border Grid.Column="1" Width="1" Background="{DynamicResource Tc.Border}" Margin="0,7" />
          <Button x:Name="CompactMetricSlot1" Grid.Column="2" Style="{StaticResource CompactMetricSlot}" Tag="1" Click="CompactMetricSlot_Click" />
          <Border Grid.Column="3" Width="1" Background="{DynamicResource Tc.Border}" Margin="0,7" />
          <Button x:Name="CompactMetricSlot2" Grid.Column="4" Style="{StaticResource CompactMetricSlot}" Tag="2" Click="CompactMetricSlot_Click" />
        </Grid>
      </Border>
      <Grid Grid.Row="4" Margin="0" x:Name="CompactControlsGrid">
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource CompactQuickCard}" Margin="0,0,6,6">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Power profile" FontSize="{x:Static ui:TypographyScale.ControlLabel}" FontWeight="SemiBold" Margin="0" />
            </StackPanel>
            <ComboBox x:Name="CompactPerformanceCombo" Style="{StaticResource CompactSelect}" Margin="0,10,0,0" SelectionChanged="CompactPerformance_SelectionChanged" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource CompactQuickCard}" Margin="6,0,0,6">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Cooling" FontSize="{x:Static ui:TypographyScale.ControlLabel}" FontWeight="SemiBold" Margin="0" />
            </StackPanel>
            <ComboBox x:Name="CompactFanCombo" Style="{StaticResource CompactSelect}" Margin="0,10,0,0" SelectionChanged="CompactFan_SelectionChanged" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource CompactQuickCard}" Margin="0,6,6,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Refresh rate" FontSize="{x:Static ui:TypographyScale.ControlLabel}" FontWeight="SemiBold" Margin="0" />
            </StackPanel>
            <ComboBox x:Name="CompactRefreshCombo" Style="{StaticResource CompactSelect}" Margin="0,10,0,0" SelectionChanged="CompactRefresh_SelectionChanged" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactQuickCard}" Margin="6,6,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Keyboard light" FontSize="{x:Static ui:TypographyScale.ControlLabel}" FontWeight="SemiBold" Margin="0" />
            </StackPanel>
            <ComboBox x:Name="CompactKeyboardCombo" Style="{StaticResource CompactSelect}" Margin="0,10,0,0" SelectionChanged="CompactKeyboard_SelectionChanged" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CompactQuickCard}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="Mode" FontSize="{x:Static ui:TypographyScale.ControlLabel}" FontWeight="SemiBold" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <ComboBox x:Name="CompactModeCombo" Style="{StaticResource CompactSelect}" DisplayMemberPath="Name" SelectionChanged="CompactMode_SelectionChanged" />
              <Button x:Name="CompactModeOffButton" Grid.Column="1" Style="{StaticResource CompactInlineButton}" Width="32" MinWidth="32" Padding="4,0" ToolTip="Turn off mode and restore previous settings" AutomationProperties.Name="Turn off mode" Click="CompactModeOff_Click"><controls:PackIconLucide Kind="Close" Width="20" Height="20" /></Button>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CompactQuickCard}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="Automation" FontSize="{x:Static ui:TypographyScale.ControlLabel}" FontWeight="SemiBold" />
            <CheckBox x:Name="CompactAutomationSwitch" Style="{StaticResource TcSwitch}" MinHeight="38" Margin="0,10,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Enable automation triggers" Click="CompactAutomation_Click" />
          </StackPanel>
        </Border>
      </Grid>
      <Border Grid.Row="6" Style="{StaticResource TcSection}" Padding="0" BorderThickness="0" Background="Transparent">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition />
            <ColumnDefinition Width="0" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Brightness" FontSize="{x:Static ui:TypographyScale.Secondary}" FontWeight="Normal" Foreground="{DynamicResource Tc.TextMuted}" VerticalAlignment="Center" />
          <Slider x:Name="CompactBrightnessSlider" Grid.Column="1" Style="{StaticResource TcSlider}" Value="{Binding Brightness}" IsEnabled="{Binding BrightnessAvailable}" PreviewMouseLeftButtonUp="CompactBrightness_Commit" PreviewKeyUp="CompactBrightness_KeyCommit" />
          <TextBlock Grid.Column="2" Text="{Binding BrightnessText}" FontSize="{x:Static ui:TypographyScale.Secondary}" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
          <TextBlock Grid.Row="1" Text="Volume" FontSize="{x:Static ui:TypographyScale.Secondary}" FontWeight="Normal" Foreground="{DynamicResource Tc.TextMuted}" VerticalAlignment="Center" />
          <Slider x:Name="CompactVolumeSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource TcSlider}" Minimum="0" Maximum="100" PreviewMouseLeftButtonUp="CompactVolume_Commit" PreviewKeyUp="CompactVolume_KeyCommit" />
          <TextBlock x:Name="CompactVolumeText" Grid.Row="1" Grid.Column="2" Text="—" FontSize="{x:Static ui:TypographyScale.Secondary}" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
      </Border>
      <Border Grid.Row="1" Height="1" Background="{DynamicResource Tc.Divider}" VerticalAlignment="Top" />
      <Border Grid.Row="3" Height="1" Background="{DynamicResource Tc.Divider}" VerticalAlignment="Center" />
      <Border Grid.Row="5" Height="1" Background="{DynamicResource Tc.Divider}" VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
