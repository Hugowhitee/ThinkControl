<UserControl x:Class="ThinkControl.UI.Controls.DiagnosticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="560">
    <StackPanel Margin="0,14,0,0">
        <Border Style="{StaticResource TcSection}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Device compatibility" FontWeight="SemiBold" />
                        <TextBlock x:Name="CompatibilityStateText"
                                   Text="Checking device profile…"
                                   Foreground="{DynamicResource Tc.TextMuted}"
                                   FontSize="11"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <CheckBox x:Name="DiagnosticsSwitch"
                              Grid.Column="1"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Style="{StaticResource TcSwitch}"
                              Click="DiagnosticsSwitch_Click"
                              ToolTip="Allow ThinkControl to prepare compatibility reports locally. Nothing is uploaded automatically." />
                </Grid>

                <TextBlock Text="Known devices load normally. On a new device, ThinkControl quietly learns provider and control compatibility while you use the app. It prepares one compact redacted report only when the evidence is stable."
                           Foreground="{DynamicResource Tc.TextMuted}"
                           FontSize="10.5"
                           TextWrapping="Wrap"
                           Margin="0,9,0,0" />

                <Border x:Name="LearningCard"
                        Background="{DynamicResource Tc.SurfaceAlt}"
                        BorderBrush="{DynamicResource Tc.Border}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="11,10"
                        Margin="0,13,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="LearningTitleText" Text="Background learning" FontWeight="SemiBold" FontSize="11" />
                            <TextBlock x:Name="LearningProgressText" Grid.Column="1" Text="0/5" FontSize="10.5" Foreground="{DynamicResource Tc.TextMuted}" />
                        </Grid>
                        <ProgressBar x:Name="LearningProgress"
                                     Minimum="0" Maximum="5" Value="0" Height="4" Margin="0,9,0,0"
                                     Background="{DynamicResource Tc.Border}" Foreground="{DynamicResource Tc.Accent}">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid x:Name="PART_Track" Background="{TemplateBinding Background}" Height="4" ClipToBounds="True">
                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                        <TextBlock x:Name="CompatibilityDetailText"
                                   Text="Learning starts after hardware discovery settles."
                                   Foreground="{DynamicResource Tc.TextMuted}"
                                   FontSize="10"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SharingStateText"
                               Text="No report needed yet"
                               VerticalAlignment="Center"
                               FontSize="10.5"
                               Foreground="{DynamicResource Tc.TextMuted}"
                               TextWrapping="Wrap" />
                    <Button x:Name="ShareDeviceButton"
                            Grid.Column="1"
                            Content="Review report"
                            Style="{StaticResource TcButton}"
                            Margin="14,0,0,0"
                            Click="ShareDeviceReport_Click"
                            IsEnabled="False" />
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="CrashCard" Style="{StaticResource TcSection}" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="Previous crash" FontWeight="SemiBold" />
                    <TextBlock x:Name="CrashSummaryText"
                               Text="ThinkControl saved a redacted crash envelope locally."
                               FontSize="10.5"
                               Foreground="{DynamicResource Tc.TextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                    <TextBlock Text="Nothing is uploaded automatically. Review the pre-filled GitHub issue before submitting it."
                               FontSize="9.5"
                               Foreground="{DynamicResource Tc.TextFaint}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Dismiss" Style="{StaticResource TcInlineButton}" Margin="0,0,6,0" Click="DismissCrash_Click" />
                    <Button Content="Report crash" Style="{StaticResource TcButton}" Click="ReportCrash_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource TcSection}" Margin="0,10,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="LOCAL EVENTS" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                        <TextBlock x:Name="EventCountText" Text="0" FontSize="17" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,12,0">
                        <TextBlock Text="LAST EVENT" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                        <TextBlock x:Name="LastEventText" Text="—" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="RETENTION" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                        <TextBlock Text="Local · up to 7 days" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Routine troubleshooting history stays bounded on this PC. It is separate from the compact compatibility report and is never uploaded automatically."
                           FontSize="10"
                           Foreground="{DynamicResource Tc.TextMuted}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />

                <Expander Header="Advanced diagnostics" Margin="0,10,0,0" Foreground="{DynamicResource Tc.TextMuted}">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <WrapPanel>
                            <Button Content="Preview data" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="Preview_Click" />
                            <Button Content="Export bundle" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="Export_Click" />
                            <Button Content="Hardware log" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="OpenHardwareLog_Click" ToolTip="Open the local ThinkControl hardware-service log" />
                            <Button Content="Bug report" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="OpenBugReport_Click" />
                        </WrapPanel>
                        <Button Grid.Column="1" Content="Delete local data" Style="{StaticResource TcButton}" Margin="8,0,0,7" VerticalAlignment="Top" Click="Delete_Click" />
                    </Grid>
                </Expander>

                <TextBlock x:Name="StatusText"
                           Text="Diagnostics are local unless you explicitly open a reviewed report on GitHub."
                           Foreground="{DynamicResource Tc.TextFaint}"
                           FontSize="9.5"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
