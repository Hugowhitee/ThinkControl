<UserControl x:Class="ThinkControl.UI.Controls.DiagnosticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="470">
    <Border Style="{StaticResource TcSection}" Margin="0,14,0,0">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Compatibility diagnostics" FontWeight="SemiBold" />
                    <TextBlock x:Name="ValidationStateText"
                               Text="Not validated · compatibility checks available"
                               Foreground="{DynamicResource Tc.Accent}"
                               FontSize="11"
                               Margin="0,4,0,0" />
                </StackPanel>
                <CheckBox x:Name="DiagnosticsSwitch"
                          Grid.Column="1"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Style="{StaticResource TcSwitch}"
                          Click="DiagnosticsSwitch_Click" />
            </Grid>

            <TextBlock x:Name="ConsentDescription"
                       Text="With compatibility sharing enabled, ThinkControl keeps a small redacted history and automatically prepares a hardware-only report when discovery is useful. This helps ThinkControl support more devices. Nothing is uploaded automatically; GitHub submission remains your explicit choice."
                       Foreground="{DynamicResource Tc.TextMuted}"
                       FontSize="10.5"
                       TextWrapping="Wrap"
                       Margin="0,9,0,0" />

            <Border Background="{DynamicResource Tc.SurfaceAlt}" BorderBrush="{DynamicResource Tc.Border}" BorderThickness="1" CornerRadius="4" Padding="10,9" Margin="0,13,0,0">
                <StackPanel>
                    <Grid Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Detect" FontSize="9.5" FontWeight="SemiBold" />
                        <Line Grid.Column="1" X1="2" X2="100" Y1="7" Y2="7" Stretch="Fill" Stroke="{DynamicResource Tc.TextFaint}" StrokeThickness="1" StrokeDashArray="2,3" Margin="7,0" />
                        <TextBlock Grid.Column="2" Text="Useful data" FontSize="9.5" FontWeight="SemiBold" />
                        <Line Grid.Column="3" X1="2" X2="100" Y1="7" Y2="7" Stretch="Fill" Stroke="{DynamicResource Tc.TextFaint}" StrokeThickness="1" StrokeDashArray="2,3" Margin="7,0" />
                        <TextBlock Grid.Column="4" Text="Ready to share" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Tc.Accent}" />
                    </Grid>
                    <TextBlock x:Name="DiscoveryReadinessText" Text="Still learning · the report is prepared when useful provider data is stable"
                               Foreground="{DynamicResource Tc.TextMuted}" FontSize="10" Margin="2,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Height="1" Background="{DynamicResource Tc.Border}" Margin="0,13" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="LOCAL EVENTS" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                    <TextBlock x:Name="EventCountText" Text="0" FontSize="17" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,12,0">
                    <TextBlock Text="LAST EVENT" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                    <TextBlock x:Name="LastEventText" Text="—" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="SHARING" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                    <TextBlock x:Name="UploadStatusText" Text="Not ready yet" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{DynamicResource Tc.Border}" Margin="0,13" />

            <WrapPanel>
                <Button x:Name="ShareDeviceButton" Content="Share to GitHub" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="ShareDeviceReport_Click" IsEnabled="False" ToolTip="Available after useful hardware discovery" />
            </WrapPanel>

            <Expander Header="Advanced diagnostics" Margin="0,5,0,0" Foreground="{DynamicResource Tc.TextMuted}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <WrapPanel>
                        <Button Content="Preview data" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="Preview_Click" />
                        <Button Content="Export bundle" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="Export_Click" />
                        <Button Content="Hardware log" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="OpenHardwareLog_Click" ToolTip="Open the local ThinkControl hardware-service log" />
                        <Button Content="Bug report" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="OpenBugReport_Click" />
                    </WrapPanel>
                    <Button Grid.Column="1" Content="Delete local data" Style="{StaticResource TcButton}" Margin="8,0,0,7" VerticalAlignment="Top" Click="Delete_Click" />
                </Grid>
            </Expander>

            <TextBlock x:Name="StatusText"
                       Text="ThinkControl prepares the redacted report locally. Share to GitHub opens a pre-filled draft; nothing is submitted until you press Submit on GitHub."
                       Foreground="{DynamicResource Tc.TextFaint}"
                       FontSize="9.5"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0" />
        </StackPanel>
    </Border>
</UserControl>
