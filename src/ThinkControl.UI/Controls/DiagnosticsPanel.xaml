<UserControl x:Class="ThinkControl.UI.Controls.DiagnosticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:ThinkControl.UI"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="520">
    <Border Style="{StaticResource TcSection}" Margin="0,14,0,0">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Device support"
                               FontSize="{x:Static ui:TypographyScale.SectionTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="CompatibilityStateText"
                               Text="Checking device profile…"
                               FontSize="{x:Static ui:TypographyScale.Body}"
                               Foreground="{DynamicResource Tc.TextMuted}"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox x:Name="DiagnosticsSwitch"
                          Grid.Column="1"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Style="{StaticResource TcSwitch}"
                          Click="DiagnosticsSwitch_Click"
                          ToolTip="Prepare a compact compatibility report locally for this new device. Nothing is uploaded automatically." />
            </Grid>

            <TextBlock x:Name="CompatibilityDetailText"
                       Text="Known devices start normally. New devices learn compatibility quietly while you use ThinkControl."
                       FontSize="{x:Static ui:TypographyScale.Secondary}"
                       Foreground="{DynamicResource Tc.TextMuted}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />

            <StackPanel x:Name="LearningCard" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="LearningTitleText"
                               Text="Learning compatibility"
                               FontSize="{x:Static ui:TypographyScale.Body}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="LearningProgressText"
                               Grid.Column="1"
                               Text="0/5"
                               FontSize="{x:Static ui:TypographyScale.Caption}"
                               Foreground="{DynamicResource Tc.TextMuted}" />
                </Grid>
                <ProgressBar x:Name="LearningProgress"
                             Minimum="0" Maximum="5" Value="0" Height="4" Margin="0,9,0,0"
                             Background="{DynamicResource Tc.Border}" Foreground="{DynamicResource Tc.Accent}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track" Background="{TemplateBinding Background}" Height="4" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </StackPanel>

            <Grid x:Name="SharingRow" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="SharingStateText"
                           Text="No compatibility report needed"
                           FontSize="{x:Static ui:TypographyScale.Secondary}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Tc.TextMuted}"
                           TextWrapping="Wrap" />
                <Button x:Name="ShareDeviceButton"
                        Grid.Column="1"
                        Content="Review report"
                        Style="{StaticResource TcButton}"
                        Margin="14,0,0,0"
                        Click="ShareDeviceReport_Click"
                        IsEnabled="False" />
            </Grid>

            <Border x:Name="CrashSeparator"
                    Height="1"
                    Background="{DynamicResource Tc.Border}"
                    Margin="0,18,0,16"
                    Visibility="Collapsed" />

            <Grid x:Name="CrashCard" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Previous crash"
                               FontSize="{x:Static ui:TypographyScale.SectionTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="CrashSummaryText"
                               Text="ThinkControl closed unexpectedly."
                               FontSize="{x:Static ui:TypographyScale.Body}"
                               Foreground="{DynamicResource Tc.TextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                    <TextBlock Text="A small redacted crash envelope is stored on this PC. Review it before opening a GitHub draft; nothing is uploaded automatically."
                               FontSize="{x:Static ui:TypographyScale.Secondary}"
                               Foreground="{DynamicResource Tc.TextFaint}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Dismiss" Style="{StaticResource TcInlineButton}" Margin="0,0,6,0" Click="DismissCrash_Click" />
                    <Button Content="Review crash" Style="{StaticResource TcButton}" Click="ReportCrash_Click" />
                </StackPanel>
            </Grid>

            <Border Height="1"
                    Background="{DynamicResource Tc.Border}"
                    Margin="0,18,0,8" />

            <Expander x:Name="TroubleshootingExpander"
                      Header="Troubleshooting data"
                      FontSize="{x:Static ui:TypographyScale.Body}"
                      Foreground="{DynamicResource Tc.TextMuted}">
                <StackPanel Margin="0,11,0,0">
                    <TextBlock Text="Routine support history stays on this PC for up to 7 days in three rotating files. Shared bundles collapse repetitive bursts and are capped at 240 focused events."
                               FontSize="{x:Static ui:TypographyScale.Secondary}"
                               Foreground="{DynamicResource Tc.TextMuted}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LastEventText"
                               Text="No local troubleshooting activity yet"
                               FontSize="{x:Static ui:TypographyScale.Caption}"
                               Foreground="{DynamicResource Tc.TextFaint}"
                               Margin="0,6,0,0" />

                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Preview data" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="Preview_Click" />
                        <Button Content="Export support bundle" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="Export_Click" />
                        <Button Content="Hardware log" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="OpenHardwareLog_Click" ToolTip="Open the local ThinkControl hardware-service log" />
                        <Button Content="New bug report" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="OpenBugReport_Click" />
                        <Button Content="Delete local data" Style="{StaticResource TcInlineButton}" Margin="2,0,0,7" Click="Delete_Click" />
                    </WrapPanel>

                    <TextBlock x:Name="StatusText"
                               Text="Diagnostics stay local unless you explicitly open a reviewed GitHub draft."
                               FontSize="{x:Static ui:TypographyScale.Caption}"
                               Foreground="{DynamicResource Tc.TextFaint}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
