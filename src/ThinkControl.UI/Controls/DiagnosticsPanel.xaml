<UserControl x:Class="ThinkControl.UI.Controls.DiagnosticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="410">
    <Border Style="{StaticResource TcSection}" Margin="0,14,0,0">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Compatibility diagnostics" FontWeight="SemiBold" />
                    <TextBlock x:Name="ValidationStateText"
                               Text="Not validated · compatibility checks available"
                               Foreground="{DynamicResource Tc.Accent}"
                               FontSize="11"
                               Margin="0,4,0,0" />
                </StackPanel>
                <CheckBox x:Name="DiagnosticsSwitch"
                          Grid.Column="1"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Style="{StaticResource TcSwitch}"
                          Click="DiagnosticsSwitch_Click" />
            </Grid>

            <TextBlock x:Name="ConsentDescription"
                       Text="ThinkControl can keep a small redacted compatibility history locally. It helps distinguish known providers from genuinely new hardware behavior. Nothing is uploaded automatically."
                       Foreground="{DynamicResource Tc.TextMuted}"
                       FontSize="10.5"
                       TextWrapping="Wrap"
                       Margin="0,9,0,0" />

            <Border Background="{DynamicResource Tc.SurfaceAlt}" BorderBrush="{DynamicResource Tc.Border}" BorderThickness="1" CornerRadius="4" Padding="10,9" Margin="0,13,0,0">
                <StackPanel>
                    <Grid Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Detect" FontSize="9.5" FontWeight="SemiBold" />
                        <Line Grid.Column="1" X1="2" X2="100" Y1="7" Y2="7" Stretch="Fill" Stroke="{DynamicResource Tc.TextFaint}" StrokeThickness="1" StrokeDashArray="2,3" Margin="7,0" />
                        <TextBlock Grid.Column="2" Text="Compare" FontSize="9.5" FontWeight="SemiBold" />
                        <Line Grid.Column="3" X1="2" X2="100" Y1="7" Y2="7" Stretch="Fill" Stroke="{DynamicResource Tc.TextFaint}" StrokeThickness="1" StrokeDashArray="2,3" Margin="7,0" />
                        <TextBlock Grid.Column="4" Text="New data" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Tc.Accent}" />
                        <Line Grid.Column="5" X1="2" X2="100" Y1="7" Y2="7" Stretch="Fill" Stroke="{DynamicResource Tc.TextFaint}" StrokeThickness="1" StrokeDashArray="2,3" Margin="7,0" />
                        <TextBlock Grid.Column="6" Text="Review" FontSize="9.5" FontWeight="SemiBold" />
                        <Line Grid.Column="7" X1="2" X2="100" Y1="7" Y2="7" Stretch="Fill" Stroke="{DynamicResource Tc.TextFaint}" StrokeThickness="1" StrokeDashArray="2,3" Margin="7,0" />
                        <TextBlock Grid.Column="8" Text="Share" FontSize="9.5" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock x:Name="DiscoveryReadinessText" Text="Still learning · share unlocks after useful provider data is found"
                               Foreground="{DynamicResource Tc.TextMuted}" FontSize="10" Margin="2,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Height="1" Background="{DynamicResource Tc.Border}" Margin="0,13" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="LOCAL EVENTS" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                    <TextBlock x:Name="EventCountText" Text="0" FontSize="17" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,12,0">
                    <TextBlock Text="LAST EVENT" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                    <TextBlock x:Name="LastEventText" Text="—" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="SHARING" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                    <TextBlock x:Name="UploadStatusText" Text="User initiated only" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{DynamicResource Tc.Border}" Margin="0,13" />

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <WrapPanel>
                    <Button x:Name="ShareDeviceButton" Content="Share device report" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="ShareDeviceReport_Click" />
                    <Button Content="Preview data" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="Preview_Click" />
                    <Button Content="Export bundle" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="Export_Click" />
                    <Button Content="Hardware log" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="OpenHardwareLog_Click" ToolTip="Open the local ThinkControl hardware-service log" />
                    <Button Content="Bug report" Style="{StaticResource TcButton}" Margin="0,0,7,7" Click="OpenBugReport_Click" />
                </WrapPanel>
                <Button Grid.Column="1" Content="Delete local data" Style="{StaticResource TcButton}" Margin="8,0,0,7" Click="Delete_Click" />
            </Grid>

            <TextBlock x:Name="StatusText"
                       Text="A device report contains hardware model, provider/capability results and sanitized sensor types only. You review the GitHub issue before submitting it."
                       Foreground="{DynamicResource Tc.TextFaint}"
                       FontSize="9.5"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0" />
        </StackPanel>
    </Border>
</UserControl>