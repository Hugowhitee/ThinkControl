<UserControl x:Class="ThinkControl.UI.Controls.TouchpadPanel"
             xmlns:ui="clr-namespace:ThinkControl.UI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
             MinWidth="520">
    <UserControl.Resources>
        <Style x:Key="TouchpadLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tc.TextMuted}" />
            <Setter Property="FontSize" Value="{x:Static ui:TypographyScale.Secondary}" />
        </Style>
        <Style x:Key="TouchpadValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tc.Text}" />
            <Setter Property="FontSize" Value="{x:Static ui:TypographyScale.Body}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Touchpad" Style="{StaticResource TcText.PageTitle}" />
                <TextBlock Text="Live touch visualization, edge shortcuts, haptics and gesture feedback." Foreground="{DynamicResource Tc.TextMuted}" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Edge gestures" Foreground="{DynamicResource Tc.TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox x:Name="GestureEnableSwitch" Style="{StaticResource TcSwitch}" Click="GestureEnable_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentGrid" Grid.Row="1" Width="{Binding ActualWidth, ElementName=RootGrid}">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="VisualizerColumn" Width="3*" /><ColumnDefinition x:Name="SettingsColumn" Width="2*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Border x:Name="VisualizerCard" Style="{StaticResource TcSection}" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Live touchpad" FontWeight="SemiBold" />
                            <TextBlock Text="Touch input and edge actions are rendered only while this page is open." Style="{StaticResource TouchpadLabel}" Margin="0,4,170,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="InputStatusText" Text="Touchpad not detected yet" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Secondary}" />
                    </Grid>

                    <Grid Grid.Row="1" Height="340" Margin="0,8,0,0">
                        <controls:TouchpadVisualizer x:Name="Visualizer" />
                    </Grid>
                </Grid>
            </Border>

            <StackPanel x:Name="SettingsStack" Grid.Column="1" Margin="7,0,0,0">
                <Border Style="{StaticResource TcSection}">
                    <StackPanel>
                        <TextBlock Text="Selected edge" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedEdgeDescription" Text="Choose what sliding along this edge controls." Style="{StaticResource TouchpadLabel}" Margin="0,4,0,12" />
                        <TextBlock Text="Action" Style="{StaticResource TouchpadLabel}" />
                        <ComboBox x:Name="ActionCombo" Style="{StaticResource TcComboBox}" Margin="0,5,0,7" SelectionChanged="ActionCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{Binding Icon}" Width="17" Height="17" Stretch="Uniform" Fill="{DynamicResource Tc.TextMuted}" Margin="0,0,9,0" />
                                        <TextBlock Text="{Binding Label}" FontSize="{x:Static ui:TypographyScale.ControlText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="ActionHelpText" Style="{StaticResource TouchpadLabel}" TextWrapping="Wrap" Margin="1,0,1,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Sensitivity" Style="{StaticResource TouchpadLabel}" />
                            <TextBlock x:Name="SensitivityValue" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource TouchpadValue}" />
                        </Grid>
                        <Slider x:Name="SensitivitySlider" Style="{StaticResource TcSlider}" Minimum="0.5" Maximum="1.5" Value="1" SmallChange="0.1" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,5,0,10" ValueChanged="GestureSetting_ValueChanged" />
                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="Invert direction" Foreground="{DynamicResource Tc.TextMuted}" VerticalAlignment="Center" />
                            <CheckBox x:Name="InvertCheck" HorizontalAlignment="Right" Style="{StaticResource TcSwitch}" Click="InvertCheck_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TcSection}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Haptic feedback" FontWeight="SemiBold" />
                                <TextBlock x:Name="HapticStatusText" Text="Checking Windows support..." Style="{StaticResource TouchpadLabel}" Margin="0,4,70,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Name="HapticSwitch" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource TcSwitch}" Click="HapticSwitch_Click" />
                        </Grid>
                        <Grid x:Name="HapticStrengthHeader" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Feedback level" Style="{StaticResource TouchpadLabel}" />
                            <TextBlock x:Name="HapticStrengthValue" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource TouchpadValue}" />
                        </Grid>
                        <Grid Margin="0,5,0,8">
                            <Slider x:Name="HapticStrengthSlider" Panel.ZIndex="1" Style="{StaticResource TcSlider}" Margin="0" TickFrequency="25" SmallChange="25" LargeChange="25" IsSnapToTickEnabled="True" ValueChanged="HapticSlider_ValueChanged" PreviewMouseLeftButtonUp="HapticSlider_MouseUp" />
                            <Grid Panel.ZIndex="0" Margin="13,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Width="2" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource Tc.BorderStrong}" CornerRadius="1" />
                                <Border Grid.Column="2" Width="2" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource Tc.BorderStrong}" CornerRadius="1" />
                                <Border Grid.Column="3" Width="2" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource Tc.BorderStrong}" CornerRadius="1" />
                            </Grid>
                        </Grid>
                        <Grid x:Name="ClickForceHeader" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Click sensitivity" Style="{StaticResource TouchpadLabel}" />
                            <TextBlock x:Name="ClickForceValue" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource TouchpadValue}" />
                        </Grid>
                        <Grid Margin="0,5,0,0">
                            <Slider x:Name="ClickForceSlider" Panel.ZIndex="1" Style="{StaticResource TcSlider}" Margin="0" TickFrequency="50" SmallChange="50" LargeChange="50" IsSnapToTickEnabled="True" ValueChanged="HapticSlider_ValueChanged" PreviewMouseLeftButtonUp="HapticSlider_MouseUp" />
                            <Grid Panel.ZIndex="0" Margin="13,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Width="2" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource Tc.BorderStrong}" CornerRadius="1" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TcSection}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Gesture pop-up" FontWeight="SemiBold" />
                                <TextBlock Text="Taskbar-origin feedback for volume, brightness and media gestures." Style="{StaticResource TouchpadLabel}" Margin="0,4,70,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Name="OsdSwitch" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource TcSwitch}" Click="OsdSwitch_Click" />
                        </Grid>
                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Position" Style="{StaticResource TouchpadLabel}" VerticalAlignment="Center" />
                            <ComboBox x:Name="OsdPositionCombo" Grid.Column="1" Style="{StaticResource TcComboBox}" SelectionChanged="OsdPosition_SelectionChanged" />
                        </Grid>
                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Opacity" Style="{StaticResource TouchpadLabel}" />
                            <TextBlock x:Name="OsdOpacityValue" Grid.Column="1" Style="{StaticResource TouchpadValue}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="OsdOpacitySlider" Style="{StaticResource TcSlider}" Minimum="0" Maximum="100" TickFrequency="5" Margin="0,5,0,0" ValueChanged="OsdOpacity_ValueChanged" PreviewMouseLeftButtonUp="OsdOpacity_MouseUp" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border x:Name="AdvancedCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource TcSection}" Margin="0,12,0,0">
                <Expander Header="Advanced gesture tuning" Foreground="{DynamicResource Tc.Text}" IsExpanded="False">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="22" /><ColumnDefinition /><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid><TextBlock Text="Edge width" FontWeight="SemiBold" /><TextBlock x:Name="EdgeWidthValue" HorizontalAlignment="Right" Style="{StaticResource TouchpadValue}" /></Grid>
                            <TextBlock Text="How close to the physical edge a gesture must start." Style="{StaticResource TouchpadLabel}" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <Slider x:Name="EdgeWidthSlider" Style="{StaticResource TcSlider}" Minimum="2" Maximum="15" ValueChanged="GestureSetting_ValueChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid><TextBlock Text="Activation" FontWeight="SemiBold" /><TextBlock x:Name="ActivationValue" HorizontalAlignment="Right" Style="{StaticResource TouchpadValue}" /></Grid>
                            <TextBlock Text="Movement required before ThinkControl claims the gesture." Style="{StaticResource TouchpadLabel}" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <Slider x:Name="ActivationSlider" Style="{StaticResource TcSlider}" Minimum="0.5" Maximum="8" ValueChanged="GestureSetting_ValueChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Grid><TextBlock Text="Tolerance" FontWeight="SemiBold" /><TextBlock x:Name="ToleranceValue" HorizontalAlignment="Right" Style="{StaticResource TouchpadValue}" /></Grid>
                            <TextBlock Text="How far inward an already claimed gesture may move." Style="{StaticResource TouchpadLabel}" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <Slider x:Name="ToleranceSlider" Style="{StaticResource TcSlider}" Minimum="4" Maximum="30" ValueChanged="GestureSetting_ValueChanged" />
                        </StackPanel>
                    </Grid>
                </Expander>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,0" Background="{DynamicResource Tc.SurfaceAlt}" BorderBrush="{DynamicResource Tc.Border}" BorderThickness="1" CornerRadius="4" Padding="10,7">
            <TextBlock x:Name="GestureStatusText" Text="Edge gestures are off." Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Secondary}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>