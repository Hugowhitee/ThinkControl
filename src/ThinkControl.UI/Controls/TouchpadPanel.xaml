<UserControl x:Class="ThinkControl.UI.Controls.TouchpadPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
             MinWidth="520">
    <UserControl.Resources>
        <Style x:Key="TouchpadLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tc.TextMuted}" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Touchpad" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Live touch visualization, edge shortcuts, haptics and the gesture pop-up." Foreground="{DynamicResource Tc.TextMuted}" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Edge gestures" Foreground="{DynamicResource Tc.TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox x:Name="GestureEnableSwitch" Style="{StaticResource TcSwitch}" Click="GestureEnable_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="VisualizerColumn" Width="3*" /><ColumnDefinition x:Name="SettingsColumn" Width="2*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Border x:Name="VisualizerCard" Style="{StaticResource TcSection}" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Live touchpad" FontWeight="SemiBold" />
                            <TextBlock Text="Touch input and edge actions are rendered only while this page is open." Style="{StaticResource TouchpadLabel}" Margin="0,4,170,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="InputStatusText" Text="Touchpad not detected yet" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" />
                    </Grid>

                    <Grid Grid.Row="1" Height="340" Margin="0,8,0,0">
                        <controls:TouchpadVisualizer x:Name="Visualizer" />
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Padding="9,5" CornerRadius="4" Background="{DynamicResource Tc.SurfaceAlt}" BorderBrush="{DynamicResource Tc.BorderStrong}" BorderThickness="1" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Selected" Style="{StaticResource TouchpadLabel}" Margin="0,0,7,0" /><TextBlock x:Name="SelectedZoneText" Text="Top edge" FontWeight="SemiBold" FontSize="10.5" /></StackPanel>
                        </Border>
                        <Border x:Name="GestureFeedbackOverlay"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MinWidth="172"
                                MaxWidth="260"
                                Padding="12,9"
                                CornerRadius="5"
                                Background="{DynamicResource Tc.SurfaceAlt}"
                                BorderBrush="{DynamicResource Tc.BorderStrong}"
                                BorderThickness="1"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <controls:PackIconLucide x:Name="GestureFeedbackIcon" Kind="Touchpad" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Tc.Text}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="GestureFeedbackTitle" Text="Gesture" FontSize="10.5" Foreground="{DynamicResource Tc.TextMuted}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="GestureFeedbackValue" Text="Ready" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Border>

            <StackPanel x:Name="SettingsStack" Grid.Column="1" Margin="7,0,0,0">
                <Border Style="{StaticResource TcSection}">
                    <StackPanel>
                        <TextBlock Text="Selected edge" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedEdgeDescription" Text="Choose what sliding along this edge controls." Style="{StaticResource TouchpadLabel}" Margin="0,4,0,12" />
                        <TextBlock Text="Action" Style="{StaticResource TouchpadLabel}" />
                        <ComboBox x:Name="ActionCombo" Style="{StaticResource TcComboBox}" Margin="0,5,0,7" SelectionChanged="ActionCombo_SelectionChanged" />
                        <TextBlock x:Name="ActionHelpText" Style="{StaticResource TouchpadLabel}" TextWrapping="Wrap" Margin="1,0,1,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Sensitivity" Style="{StaticResource TouchpadLabel}" />
                            <TextBlock x:Name="SensitivityValue" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource TouchpadLabel}" />
                        </Grid>
                        <Slider x:Name="SensitivitySlider" Style="{StaticResource TcSlider}" Minimum="0.5" Maximum="2" Value="1" Margin="0,5,0,10" ValueChanged="GestureSetting_ValueChanged" />
                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="Invert direction" Foreground="{DynamicResource Tc.TextMuted}" VerticalAlignment="Center" />
                            <CheckBox x:Name="InvertCheck" HorizontalAlignment="Right" Style="{StaticResource TcSwitch}" Click="InvertCheck_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TcSection}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Haptic feedback" FontWeight="SemiBold" />
                                <TextBlock x:Name="HapticStatusText" Text="Checking Windows support..." Style="{StaticResource TouchpadLabel}" Margin="0,4,70,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Name="HapticSwitch" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource TcSwitch}" Click="HapticSwitch_Click" />
                        </Grid>
                        <Grid x:Name="HapticStrengthHeader" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Feedback level" Style="{StaticResource TouchpadLabel}" />
                            <TextBlock x:Name="HapticStrengthValue" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource TouchpadLabel}" />
                        </Grid>
                        <Grid Margin="0,5,0,8">
                            <Slider x:Name="HapticStrengthSlider" Panel.ZIndex="1" Style="{StaticResource TcSlider}" Margin="0" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="HapticSlider_ValueChanged" PreviewMouseLeftButtonUp="HapticSlider_MouseUp" />
                            <Grid Panel.ZIndex="0" Margin="12,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Width="2" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource Tc.BorderStrong}" CornerRadius="1" />
                                <Border Grid.Column="2" Width="2" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource Tc.BorderStrong}" CornerRadius="1" />
                                <Border Grid.Column="3" Width="2" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource Tc.BorderStrong}" CornerRadius="1" />
                            </Grid>
                        </Grid>
                        <Grid x:Name="ClickForceHeader" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Click sensitivity" Style="{StaticResource TouchpadLabel}" />
                            <TextBlock x:Name="ClickForceValue" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource TouchpadLabel}" />
                        </Grid>
                        <Grid Margin="0,5,0,0">
                            <Slider x:Name="ClickForceSlider" Panel.ZIndex="1" Style="{StaticResource TcSlider}" Margin="0" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="HapticSlider_ValueChanged" PreviewMouseLeftButtonUp="HapticSlider_MouseUp" />
                            <Grid Panel.ZIndex="0" Margin="12,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Width="2" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource Tc.BorderStrong}" CornerRadius="1" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TcSection}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Gesture pop-up" FontWeight="SemiBold" />
                                <TextBlock Text="Windows-style feedback for volume and brightness gestures." Style="{StaticResource TouchpadLabel}" Margin="0,4,70,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Name="OsdSwitch" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource TcSwitch}" Click="OsdSwitch_Click" />
                        </Grid>
                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Position" Style="{StaticResource TouchpadLabel}" VerticalAlignment="Center" />
                            <ComboBox x:Name="OsdPositionCombo" Grid.Column="1" Style="{StaticResource TcComboBox}" SelectionChanged="OsdPosition_SelectionChanged" />
                        </Grid>
                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Opacity" Style="{StaticResource TouchpadLabel}" />
                            <TextBlock x:Name="OsdOpacityValue" Grid.Column="1" Style="{StaticResource TouchpadLabel}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="OsdOpacitySlider" Style="{StaticResource TcSlider}" Minimum="65" Maximum="100" TickFrequency="5" Margin="0,5,0,0" ValueChanged="OsdOpacity_ValueChanged" PreviewMouseLeftButtonUp="OsdOpacity_MouseUp" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border x:Name="AdvancedCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource TcSection}" Margin="0,12,0,0">
                <Expander Header="Advanced gesture tuning" Foreground="{DynamicResource Tc.Text}" IsExpanded="False">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="22" /><ColumnDefinition /><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid><TextBlock Text="Edge width" FontWeight="SemiBold" /><TextBlock x:Name="EdgeWidthValue" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextMuted}" /></Grid>
                            <TextBlock Text="How close to the physical edge a gesture must start." Style="{StaticResource TouchpadLabel}" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <Slider x:Name="EdgeWidthSlider" Style="{StaticResource TcSlider}" Minimum="2" Maximum="15" ValueChanged="GestureSetting_ValueChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid><TextBlock Text="Activation" FontWeight="SemiBold" /><TextBlock x:Name="ActivationValue" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextMuted}" /></Grid>
                            <TextBlock Text="Movement required before ThinkControl claims the gesture." Style="{StaticResource TouchpadLabel}" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <Slider x:Name="ActivationSlider" Style="{StaticResource TcSlider}" Minimum="0.5" Maximum="8" ValueChanged="GestureSetting_ValueChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Grid><TextBlock Text="Tolerance" FontWeight="SemiBold" /><TextBlock x:Name="ToleranceValue" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextMuted}" /></Grid>
                            <TextBlock Text="How far inward an already claimed gesture may move." Style="{StaticResource TouchpadLabel}" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <Slider x:Name="ToleranceSlider" Style="{StaticResource TcSlider}" Minimum="4" Maximum="30" ValueChanged="GestureSetting_ValueChanged" />
                        </StackPanel>
                    </Grid>
                </Expander>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,0" Background="{DynamicResource Tc.SurfaceAlt}" BorderBrush="{DynamicResource Tc.Border}" BorderThickness="1" CornerRadius="4" Padding="10,7">
            <TextBlock x:Name="GestureStatusText" Text="Edge gestures are off." Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
