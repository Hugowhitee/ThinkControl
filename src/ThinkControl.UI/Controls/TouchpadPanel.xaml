<UserControl x:Class="ThinkControl.UI.Controls.TouchpadPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
             MinWidth="620">
    <UserControl.Resources>
        <Style x:Key="TouchpadCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Tc.Text}" />
            <Setter Property="Background" Value="{DynamicResource Tc.SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tc.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style x:Key="TouchpadLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tc.TextMuted}" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Touchpad" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Configure edge gestures and haptic feedback." Foreground="{DynamicResource Tc.TextMuted}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Edge gestures" Foreground="{DynamicResource Tc.TextMuted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <CheckBox x:Name="GestureEnableSwitch" Style="{StaticResource TcSwitch}" Click="GestureEnable_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="VisualizerColumn" Width="3*" />
                <ColumnDefinition x:Name="SettingsColumn" Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="VisualizerCard" Style="{StaticResource TcSection}" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Gesture map" FontWeight="SemiBold" />
                        <TextBlock x:Name="InputStatusText" Text="Touchpad not detected yet" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" />
                    </Grid>
                    <controls:TouchpadVisualizer x:Name="Visualizer" Grid.Row="1" Margin="0,10,0,0" Height="300" />
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Selected zone" Style="{StaticResource TouchpadLabel}" />
                            <TextBlock x:Name="SelectedZoneText" Text="Top edge" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="TestModeSwitch" Grid.Column="1" Content="Test gestures" VerticalAlignment="Center" Foreground="{DynamicResource Tc.TextMuted}" Checked="TestMode_Checked" Unchecked="TestMode_Unchecked" />
                    </Grid>
                </Grid>
            </Border>

            <StackPanel x:Name="SettingsStack" Grid.Column="1" Margin="7,0,0,0">
                <Border Style="{StaticResource TcSection}">
                    <StackPanel>
                        <TextBlock Text="Selected edge" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedEdgeDescription" Text="Choose what sliding along this edge controls." Style="{StaticResource TouchpadLabel}" Margin="0,4,0,12" />

                        <TextBlock Text="Action" Style="{StaticResource TouchpadLabel}" />
                        <ComboBox x:Name="ActionCombo" Style="{StaticResource TouchpadCombo}" Margin="0,5,0,12" SelectionChanged="ActionCombo_SelectionChanged" />

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Sensitivity" Style="{StaticResource TouchpadLabel}" />
                            <TextBlock x:Name="SensitivityValue" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource TouchpadLabel}" />
                        </Grid>
                        <Slider x:Name="SensitivitySlider" Style="{StaticResource TcSlider}" Minimum="0.5" Maximum="2" Value="1" Margin="0,5,0,10" ValueChanged="GestureSetting_ValueChanged" />
                        <CheckBox x:Name="InvertCheck" Content="Invert direction" Foreground="{DynamicResource Tc.TextMuted}" Click="InvertCheck_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TcSection}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Haptic feedback" FontWeight="SemiBold" />
                                <TextBlock x:Name="HapticStatusText" Text="Checking Windows support..." Style="{StaticResource TouchpadLabel}" Margin="0,4,70,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Name="HapticSwitch" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource TcSwitch}" Click="HapticSwitch_Click" />
                        </Grid>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Feedback strength" Style="{StaticResource TouchpadLabel}" />
                            <TextBlock x:Name="HapticStrengthValue" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource TouchpadLabel}" />
                        </Grid>
                        <Slider x:Name="HapticStrengthSlider" Style="{StaticResource TcSlider}" Margin="0,5,0,8" ValueChanged="HapticSlider_ValueChanged" PreviewMouseLeftButtonUp="HapticSlider_MouseUp" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Click sensitivity" Style="{StaticResource TouchpadLabel}" />
                            <TextBlock x:Name="ClickForceValue" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource TouchpadLabel}" />
                        </Grid>
                        <Slider x:Name="ClickForceSlider" Style="{StaticResource TcSlider}" Margin="0,5,0,0" ValueChanged="HapticSlider_ValueChanged" PreviewMouseLeftButtonUp="HapticSlider_MouseUp" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border x:Name="AdvancedCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource TcSection}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Grid><TextBlock Text="Edge width" FontWeight="SemiBold" /><TextBlock x:Name="EdgeWidthValue" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextMuted}" /></Grid>
                        <TextBlock Text="How close to the physical edge a gesture must start." Style="{StaticResource TouchpadLabel}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <Slider x:Name="EdgeWidthSlider" Style="{StaticResource TcSlider}" Minimum="2" Maximum="15" ValueChanged="GestureSetting_ValueChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Grid><TextBlock Text="Activation distance" FontWeight="SemiBold" /><TextBlock x:Name="ActivationValue" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextMuted}" /></Grid>
                        <TextBlock Text="Movement required before ThinkControl claims the gesture." Style="{StaticResource TouchpadLabel}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <Slider x:Name="ActivationSlider" Style="{StaticResource TcSlider}" Minimum="0.5" Maximum="8" ValueChanged="GestureSetting_ValueChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <Grid><TextBlock Text="Edge tolerance" FontWeight="SemiBold" /><TextBlock x:Name="ToleranceValue" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextMuted}" /></Grid>
                        <TextBlock Text="How far inward a claimed gesture may move." Style="{StaticResource TouchpadLabel}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <Slider x:Name="ToleranceSlider" Style="{StaticResource TcSlider}" Minimum="4" Maximum="30" ValueChanged="GestureSetting_ValueChanged" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,14,0,0" Background="{DynamicResource Tc.SurfaceAlt}" BorderBrush="{DynamicResource Tc.Border}" BorderThickness="1" CornerRadius="3" Padding="10,7">
            <TextBlock x:Name="GestureStatusText" Text="Edge gestures are off." Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" />
        </Border>
    </Grid>
</UserControl>
