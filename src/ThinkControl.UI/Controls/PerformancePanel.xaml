<UserControl x:Class="ThinkControl.UI.Controls.PerformancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThinkControl.UI.Controls">
    <StackPanel>
        <Grid>
            <TextBlock Text="Performance" FontSize="24" FontWeight="SemiBold" />
            <Button Content="Reset" Style="{StaticResource TcButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,4" FontSize="10.5" Click="Reset_Click" ToolTip="Restore Balanced for battery and plugged-in power" />
        </Grid>
        <TextBlock Text="Power behavior is stored separately for battery and plugged in. Cooling is a global fan profile and does not change when the charger is connected or removed."
                   Foreground="{DynamicResource Tc.TextMuted}" Margin="0,6,0,18" TextWrapping="Wrap" />

        <Border Style="{StaticResource TcSection}">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Battery profile" FontWeight="SemiBold" />
                        <TextBlock Text="Used automatically when the laptop runs from its battery." Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border x:Name="BatteryActiveBadge" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4" Padding="8,4" Background="{DynamicResource Tc.SurfaceAlt}" BorderBrush="{DynamicResource Tc.Border}" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="On battery" Foreground="{DynamicResource Tc.TextMuted}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <controls:PackIconLucide Kind="Battery" Width="13" Height="13" Margin="7,0,0,0" Foreground="{DynamicResource Tc.Accent}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <RadioButton x:Name="BatteryEfficiency" GroupName="BatteryPower" Style="{StaticResource TcSegment}" Content="Efficiency" Tag="Battery:Quiet" Click="PowerPreference_Click" Margin="0,0,5,0" />
                    <RadioButton x:Name="BatteryBalanced" Grid.Column="1" GroupName="BatteryPower" Style="{StaticResource TcSegment}" Content="Balanced" Tag="Battery:Balanced" Click="PowerPreference_Click" Margin="2,0" />
                    <RadioButton x:Name="BatteryPerformance" Grid.Column="2" GroupName="BatteryPower" Style="{StaticResource TcSegment}" Content="Performance" Tag="Battery:Performance" Click="PowerPreference_Click" Margin="5,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource TcSection}" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Plugged-in profile" FontWeight="SemiBold" />
                        <TextBlock Text="Used automatically while AC power is connected." Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border x:Name="AcActiveBadge" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4" Padding="8,4" Background="{DynamicResource Tc.SurfaceAlt}" BorderBrush="{DynamicResource Tc.Border}" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Plugged in" Foreground="{DynamicResource Tc.TextMuted}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <controls:PackIconLucide Kind="BatteryCharging" Width="13" Height="13" Margin="7,0,0,0" Foreground="{DynamicResource Tc.Accent}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <RadioButton x:Name="AcEfficiency" GroupName="AcPower" Style="{StaticResource TcSegment}" Content="Efficiency" Tag="Ac:Quiet" Click="PowerPreference_Click" Margin="0,0,5,0" />
                    <RadioButton x:Name="AcBalanced" Grid.Column="1" GroupName="AcPower" Style="{StaticResource TcSegment}" Content="Balanced" Tag="Ac:Balanced" Click="PowerPreference_Click" Margin="2,0" />
                    <RadioButton x:Name="AcPerformance" Grid.Column="2" GroupName="AcPower" Style="{StaticResource TcSegment}" Content="Performance" Tag="Ac:Performance" Click="PowerPreference_Click" Margin="5,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource TcSection}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Current power source" FontWeight="SemiBold" />
                    <TextBlock x:Name="CurrentSourceText" Text="Checking…" FontSize="17" FontWeight="Light" Margin="0,8,0,0" />
                    <TextBlock x:Name="CurrentPowerText" Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Cooling stays independent" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="Quiet / Balanced / Max cooling is selected on the Fans page and remains unchanged across AC/DC transitions." Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="70,8,0,0" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="360" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="On the verified X9, the active power choice also coordinates Lenovo Intelligent Cooling's platform policy. A custom fan profile, when selected, remains the separate fan-control owner."
                   Foreground="{DynamicResource Tc.TextFaint}" FontSize="9.5" Margin="2,12,2,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
