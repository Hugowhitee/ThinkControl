<UserControl x:Class="ThinkControl.UI.Controls.AudioPanel"
             xmlns:ui="clr-namespace:ThinkControl.UI"
             xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="AudioFullOnly" TargetType="FrameworkElement">
            <Style.Triggers><DataTrigger Binding="{Binding OverviewOnly, RelativeSource={RelativeSource AncestorType=controls:AudioPanel}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AudioLevelCard" TargetType="Border" BasedOn="{StaticResource TcSection}">
            <Style.Triggers><DataTrigger Binding="{Binding OverviewOnly, RelativeSource={RelativeSource AncestorType=controls:AudioPanel}}" Value="True"><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AudioLevelLabel" TargetType="StackPanel">
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Style.Triggers><DataTrigger Binding="{Binding OverviewOnly, RelativeSource={RelativeSource AncestorType=controls:AudioPanel}}" Value="True"><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="VerticalAlignment" Value="Center" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AudioLevelTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{x:Static ui:TypographyScale.SectionTitle}" />
            <Style.Triggers><DataTrigger Binding="{Binding OverviewOnly, RelativeSource={RelativeSource AncestorType=controls:AudioPanel}}" Value="True"><Setter Property="FontWeight" Value="Normal" /><Setter Property="Foreground" Value="{DynamicResource Tc.TextMuted}" /><Setter Property="FontSize" Value="13" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AudioLevelSlider" TargetType="Slider" BasedOn="{StaticResource TcSlider}">
            <Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,14,0,0" />
            <Style.Triggers><DataTrigger Binding="{Binding OverviewOnly, RelativeSource={RelativeSource AncestorType=controls:AudioPanel}}" Value="True"><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="0" /><Setter Property="Height" Value="30" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AudioLevelActions" TargetType="StackPanel">
            <Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Orientation" Value="Horizontal" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers><DataTrigger Binding="{Binding OverviewOnly, RelativeSource={RelativeSource AncestorType=controls:AudioPanel}}" Value="True"><Setter Property="VerticalAlignment" Value="Center" /></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <controls:AdvancedPageHeader Style="{StaticResource AudioFullOnly}" Title="Audio"
                                     Subtitle="System audio and Dolby controls.">
            <controls:AdvancedPageHeader.Actions>
                <Button Content="Defaults"
                        controls:AdvancedPageHeader.ActionRole="Defaults"
                        Style="{StaticResource TcPageHeaderAction}"
                        Click="Reset_Click"
                        ToolTip="Restore Dolby Dynamic" />
            </controls:AdvancedPageHeader.Actions>
        </controls:AdvancedPageHeader>

        <Border Style="{StaticResource AudioLevelCard}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Style="{StaticResource AudioLevelLabel}">
                        <TextBlock Text="System volume" Style="{StaticResource AudioLevelTitle}" />
                        <TextBlock x:Name="VolumeDeviceText" Visibility="{Binding OverviewOnly, RelativeSource={RelativeSource AncestorType=controls:AudioPanel}, Converter={StaticResource TcQuickVisibility}}" Text="Default Windows output" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,4,90,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource AudioLevelActions}">
                        <TextBlock x:Name="VolumeValueText" Text="—" FontSize="{x:Static ui:TypographyScale.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button x:Name="MuteButton" Visibility="{Binding OverviewOnly, RelativeSource={RelativeSource AncestorType=controls:AudioPanel}, Converter={StaticResource TcQuickVisibility}}" Content="Mute" Style="{StaticResource TcButton}" Padding="10,4" Click="Mute_Click" />
                    </StackPanel>
                <Slider x:Name="VolumeSlider" Style="{StaticResource AudioLevelSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="VolumeSlider_ValueChanged" PreviewMouseLeftButtonDown="VolumeSlider_MouseDown" PreviewMouseLeftButtonUp="VolumeSlider_MouseUp" PreviewKeyDown="VolumeSlider_KeyDown" PreviewKeyUp="VolumeSlider_KeyUp" />
            </Grid>
        </Border>

        <Border Style="{StaticResource AudioLevelCard}" Margin="0,14,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Style="{StaticResource AudioLevelLabel}">
                        <TextBlock Text="Microphone input" Style="{StaticResource AudioLevelTitle}" />
                        <TextBlock x:Name="MicrophoneDeviceText" Visibility="{Binding OverviewOnly, RelativeSource={RelativeSource AncestorType=controls:AudioPanel}, Converter={StaticResource TcQuickVisibility}}" Text="Default Windows input" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,4,90,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource AudioLevelActions}">
                        <TextBlock x:Name="MicrophoneValueText" Text="—" FontSize="{x:Static ui:TypographyScale.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button x:Name="MicrophoneMuteButton" Visibility="{Binding OverviewOnly, RelativeSource={RelativeSource AncestorType=controls:AudioPanel}, Converter={StaticResource TcQuickVisibility}}" Content="Mute" Style="{StaticResource TcButton}" Padding="10,4" Click="MicrophoneMute_Click" />
                    </StackPanel>
                <Slider x:Name="MicrophoneSlider" Style="{StaticResource AudioLevelSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MicrophoneSlider_ValueChanged" PreviewMouseLeftButtonDown="MicrophoneSlider_MouseDown" PreviewMouseLeftButtonUp="MicrophoneSlider_MouseUp" PreviewKeyDown="MicrophoneSlider_KeyDown" PreviewKeyUp="MicrophoneSlider_KeyUp" />
            </Grid>
        </Border>

        <StackPanel Style="{StaticResource AudioFullOnly}">
        <Border Style="{StaticResource TcSection}" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Dolby Atmos" Style="{StaticResource TcText.SectionTitle}" />
                        <TextBlock x:Name="BackendStatusText" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,5,190,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="InstallButton" Content="Install Dolby Access" Style="{StaticResource TcButton}" Click="Install_Click" Visibility="Collapsed" />
                        <Button x:Name="OpenButton" Content="Open Dolby Access" Style="{StaticResource TcButton}" Click="Open_Click" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ProfileGrid" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="DynamicProfile" GroupName="DolbyProfile" Style="{StaticResource TcSegment}" Content="Dynamic" Tag="Dynamic" Click="Profile_Click" Margin="0,0,4,0" />
                    <RadioButton x:Name="MovieProfile" Grid.Column="1" GroupName="DolbyProfile" Style="{StaticResource TcSegment}" Content="Movie" Tag="Movie" Click="Profile_Click" Margin="2,0" />
                    <RadioButton x:Name="MusicProfile" Grid.Column="2" GroupName="DolbyProfile" Style="{StaticResource TcSegment}" Content="Music" Tag="Music" Click="Profile_Click" Margin="2,0" />
                    <RadioButton x:Name="GameProfile" Grid.Column="3" GroupName="DolbyProfile" Style="{StaticResource TcSegment}" Content="Game" Tag="Game" Click="Profile_Click" Margin="2,0" />
                    <RadioButton x:Name="VoiceProfile" Grid.Column="4" GroupName="DolbyProfile" Style="{StaticResource TcSegment}" Content="Voice" Tag="Voice" Click="Profile_Click" Margin="4,0,0,0" />
                </Grid>

                <Border x:Name="FusionControlCard" Background="{DynamicResource Tc.SurfaceAlt}" BorderBrush="{DynamicResource Tc.Border}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,11,0,0" Visibility="Collapsed">
                    <TextBlock Text="Uses Dolby Access for profile changes."
                               Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" />
                </Border>
                <TextBlock x:Name="ActionStatusText" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,11,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border x:Name="SubprofileCard" Style="{StaticResource TcSection}" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Music: Intelligent Equalizer" Style="{StaticResource TcText.SectionTitle}" />
                    </StackPanel>
                    <TextBlock x:Name="SubprofileStatusText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <RadioButton x:Name="BalancedTone" GroupName="DolbyTone" Style="{StaticResource TcSegment}" Content="Balanced" Tag="Balanced" Click="Tone_Click" Margin="0,0,5,0" />
                    <RadioButton x:Name="DetailedTone" Grid.Column="1" GroupName="DolbyTone" Style="{StaticResource TcSegment}" Content="Detailed" Tag="Detailed" Click="Tone_Click" Margin="2,0" />
                    <RadioButton x:Name="WarmTone" Grid.Column="2" GroupName="DolbyTone" Style="{StaticResource TcSegment}" Content="Warm" Tag="Warm" Click="Tone_Click" Margin="2,0" />
                    <RadioButton x:Name="OffTone" Grid.Column="3" GroupName="DolbyTone" Style="{StaticResource TcSegment}" Content="Off" Tag="Off" Click="Tone_Click" Margin="5,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>


        </StackPanel>
    </StackPanel>
</UserControl>
