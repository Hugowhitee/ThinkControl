<UserControl x:Class="ThinkControl.UI.Controls.AudioPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <TextBlock Text="Audio" FontSize="24" FontWeight="SemiBold" />
            <Button Content="Defaults" Style="{StaticResource TcButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,4" FontSize="10.5" Click="Reset_Click" ToolTip="Restore Dolby Dynamic using the supported control path for this driver" />
        </Grid>
        <TextBlock Text="Windows output volume and Lenovo's installed Dolby processing in one place. ThinkControl uses a verified direct DAX path where available and the official Dolby Access controls on Fusion systems."
                   Foreground="{DynamicResource Tc.TextMuted}" Margin="0,6,0,18" TextWrapping="Wrap" />

        <Border Style="{StaticResource TcSection}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="System volume" FontWeight="SemiBold" />
                        <TextBlock x:Name="VolumeDeviceText" Text="Default Windows output" Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,4,90,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock x:Name="VolumeValueText" Text="—" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button x:Name="MuteButton" Content="Mute" Style="{StaticResource TcButton}" Padding="10,4" Click="Mute_Click" />
                    </StackPanel>
                </Grid>
                <Slider x:Name="VolumeSlider" Style="{StaticResource TcSlider}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,14,0,0" ValueChanged="VolumeSlider_ValueChanged" PreviewMouseLeftButtonUp="VolumeSlider_MouseUp" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource TcSection}" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Microphone input" FontWeight="SemiBold" />
                        <TextBlock x:Name="MicrophoneDeviceText" Text="Default Windows input" Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,4,90,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock x:Name="MicrophoneValueText" Text="—" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button x:Name="MicrophoneMuteButton" Content="Mute" Style="{StaticResource TcButton}" Padding="10,4" Click="MicrophoneMute_Click" />
                    </StackPanel>
                </Grid>
                <Slider x:Name="MicrophoneSlider" Style="{StaticResource TcSlider}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,14,0,0" ValueChanged="MicrophoneSlider_ValueChanged" PreviewMouseLeftButtonUp="MicrophoneSlider_MouseUp" />
                <TextBlock Text="Windows endpoint input gain. Some microphone arrays expose additional processing only in Windows Sound settings or the OEM audio app."
                           Foreground="{DynamicResource Tc.TextFaint}" FontSize="9.5" Margin="0,7,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource TcSection}" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Dolby Atmos" FontWeight="SemiBold" />
                        <TextBlock x:Name="BackendStatusText" Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,5,190,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="InstallButton" Content="Install Dolby Access" Style="{StaticResource TcButton}" Click="Install_Click" Visibility="Collapsed" />
                        <Button x:Name="OpenButton" Content="Open Dolby Access" Style="{StaticResource TcButton}" Click="Open_Click" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ProfileGrid" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="DynamicProfile" GroupName="DolbyProfile" Style="{StaticResource TcSegment}" Content="Dynamic" Tag="Dynamic" Click="Profile_Click" Margin="0,0,4,0" />
                    <RadioButton x:Name="MovieProfile" Grid.Column="1" GroupName="DolbyProfile" Style="{StaticResource TcSegment}" Content="Movie" Tag="Movie" Click="Profile_Click" Margin="2,0" />
                    <RadioButton x:Name="MusicProfile" Grid.Column="2" GroupName="DolbyProfile" Style="{StaticResource TcSegment}" Content="Music" Tag="Music" Click="Profile_Click" Margin="2,0" />
                    <RadioButton x:Name="GameProfile" Grid.Column="3" GroupName="DolbyProfile" Style="{StaticResource TcSegment}" Content="Game" Tag="Game" Click="Profile_Click" Margin="2,0" />
                    <RadioButton x:Name="VoiceProfile" Grid.Column="4" GroupName="DolbyProfile" Style="{StaticResource TcSegment}" Content="Voice" Tag="Voice" Click="Profile_Click" Margin="4,0,0,0" />
                </Grid>

                <Border x:Name="FusionControlCard" Background="{DynamicResource Tc.SurfaceAlt}" BorderBrush="{DynamicResource Tc.Border}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,11,0,0" Visibility="Collapsed">
                    <TextBlock Text="Fusion mode · profile buttons use the official Dolby Access controls only when you click them. No private Fusion profile IDs or background UI automation are used."
                               Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" TextWrapping="Wrap" />
                </Border>
                <TextBlock x:Name="ActionStatusText" Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,11,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border x:Name="SubprofileCard" Style="{StaticResource TcSection}" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Music · Intelligent Equalizer" FontWeight="SemiBold" />
                        <TextBlock Text="These tone choices are shown only for Music when the installed DAX API exposes direct readback."
                                   Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,5,30,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="SubprofileStatusText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{DynamicResource Tc.TextFaint}" FontSize="9.5" />
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <RadioButton x:Name="BalancedTone" GroupName="DolbyTone" Style="{StaticResource TcSegment}" Content="Balanced" Tag="Balanced" Click="Tone_Click" Margin="0,0,5,0" />
                    <RadioButton x:Name="DetailedTone" Grid.Column="1" GroupName="DolbyTone" Style="{StaticResource TcSegment}" Content="Detailed" Tag="Detailed" Click="Tone_Click" Margin="2,0" />
                    <RadioButton x:Name="WarmTone" Grid.Column="2" GroupName="DolbyTone" Style="{StaticResource TcSegment}" Content="Warm" Tag="Warm" Click="Tone_Click" Margin="2,0" />
                    <RadioButton x:Name="OffTone" Grid.Column="3" GroupName="DolbyTone" Style="{StaticResource TcSegment}" Content="Off" Tag="Off" Click="Tone_Click" Margin="5,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource TcSection}" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="Direct when verified" FontWeight="SemiBold" />
                    <TextBlock Text="Legacy DAX systems stay controllable inside ThinkControl when a semantic setter/readback contract is available." Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource TcSection}" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="Fusion on demand" FontWeight="SemiBold" />
                    <TextBlock Text="Modern Fusion systems use semantic controls from the installed Dolby Access app only for the profile change you requested; ThinkControl does not poll or automate it in the background." Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Text="Dolby availability is discovered at runtime because Lenovo ships different DAX/Fusion generations. Unsupported private APIs are never guessed."
                   Foreground="{DynamicResource Tc.TextFaint}" FontSize="9.5" Margin="2,12,2,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
