<UserControl x:Class="ThinkControl.UI.Controls.BrandWordmark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ThinkControl.UI.Controls" IsHitTestVisible="False">
    <Viewbox Stretch="Uniform">
        <Grid Width="182" Height="57">
            <controls:SvgAssetImage Width="174" Height="56" Viewport="0,0,174,56" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0" Asset="{DynamicResource Tc.BrandName}" />
        </Grid>
    </Viewbox>
</UserControl>
