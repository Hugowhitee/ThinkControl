<UserControl x:Class="ThinkControl.UI.Controls.BrandWordmark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
             IsHitTestVisible="False">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Think"
                   FontFamily="Segoe UI"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Tc.Text}"
                   VerticalAlignment="Center" />
        <controls:BrandMark Width="25" Height="25" Margin="1,0,1,0" VerticalAlignment="Center" />
        <TextBlock Text="ontrol"
                   FontFamily="Segoe UI"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Tc.Text}"
                   Margin="-1,1,0,0"
                   VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
