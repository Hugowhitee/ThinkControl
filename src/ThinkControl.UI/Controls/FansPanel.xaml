<UserControl x:Class="ThinkControl.UI.Controls.FansPanel"
             xmlns:ui="clr-namespace:ThinkControl.UI"
             xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <StackPanel>
        <controls:AdvancedPageHeader Title="Fans"
                                     Subtitle="">
            <controls:AdvancedPageHeader.Style><Style TargetType="controls:AdvancedPageHeader"><Style.Triggers><DataTrigger Binding="{Binding Embedded, RelativeSource={RelativeSource AncestorType=controls:FansPanel}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></controls:AdvancedPageHeader.Style>
            <controls:AdvancedPageHeader.Actions>
                <Button Content="Defaults"
                        controls:AdvancedPageHeader.ActionRole="Defaults"
                        Style="{StaticResource TcPageHeaderAction}"
                        Click="Reset_Click" />
            </controls:AdvancedPageHeader.Actions>
        </controls:AdvancedPageHeader>

        <Border x:Name="CalibrationCard" Style="{StaticResource TcSection}" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <StackPanel Margin="0,0,210,0">
                        <TextBlock x:Name="CharacterizationTitleText" Text="Fan calibration required" FontWeight="SemiBold" />
                        <TextBlock x:Name="CalibrationDescriptionText"
                                   Text="Measure fan speeds to enable curves and percentage targets. Auto stays active until calibration completes."
                                   Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="CharacterizeButton" Content="Calibrate now" Style="{StaticResource TcButton}" Padding="12,6" Click="Characterize_Click" />
                        <Button x:Name="StopCharacterizationButton" Content="Stop and return to Auto" Style="{StaticResource TcButton}" Padding="12,6" Click="StopCharacterization_Click" Margin="8,0,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="CharacterizationProgress" Height="4" Minimum="0" Maximum="7" Margin="0,14,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="CharacterizationStatusText" Margin="0,9,0,0" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" />
                <ItemsControl x:Name="CalibrationResults" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding LevelText}" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                                <TextBlock Grid.Column="1" Text="{Binding RpmText}" FontSize="{x:Static ui:TypographyScale.Caption}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding StabilityText}" HorizontalAlignment="Right" FontSize="{x:Static ui:TypographyScale.Caption}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border x:Name="ProfileCard" Style="{StaticResource TcSection}" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <TextBlock Text="Cooling" Style="{StaticResource TcText.SectionTitle}" />
                    <TextBlock x:Name="CoolingOwnerText"
                               Text="Lenovo firmware"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Tc.TextMuted}"
                               FontSize="{x:Static ui:TypographyScale.Caption}" />
                </Grid>

                <Border Height="1" Background="{DynamicResource Tc.Border}" Margin="0,12,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="Cooling profile" FontWeight="SemiBold" />
                        <TextBlock x:Name="CoolingDetailText"
                                   Text="Lenovo firmware"
                                   Foreground="{DynamicResource Tc.TextMuted}"
                                   FontSize="{x:Static ui:TypographyScale.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <Button x:Name="RecoverAutoButton"
                                Content="Return to Lenovo Auto ›"
                                Style="{StaticResource TcInlineButton}"
                                HorizontalAlignment="Left"
                                Padding="2,5"
                                Margin="0,6,0,0"
                                Visibility="Collapsed"
                                Click="RecoverAuto_Click"
                                ToolTip="Return control to automatic cooling." />
                        <TextBlock x:Name="AutoRecoveryResultText"
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource Tc.TextMuted}"
                                   FontSize="{x:Static ui:TypographyScale.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <ComboBox x:Name="ProfileComboBox"
                              Grid.Column="1"
                              Style="{StaticResource TcComboBox}"
                              MinWidth="190"
                              MaxWidth="230"
                              VerticalAlignment="Center"
                              DisplayMemberPath="Name"
                              SelectionChanged="ProfileComboBox_SelectionChanged"
                              DropDownOpened="ProfileComboBox_DropDownOpened" />
                </Grid>

                    <Button x:Name="EditCurvesButton"
                            HorizontalAlignment="Left"
                            Content="Edit curves"
                            Style="{StaticResource TcButton}"
                            Padding="11,6"
                            Margin="0,10,0,0"
                            Click="EditCurves_Click"
                            Visibility="Collapsed" />
                <StackPanel x:Name="ActiveCurvePreview" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="Active curve" FontSize="{x:Static ui:TypographyScale.Caption}" Foreground="{DynamicResource Tc.TextMuted}" />
                        <TextBlock x:Name="LiveCurveStatus" HorizontalAlignment="Right" FontSize="{x:Static ui:TypographyScale.Caption}" Foreground="{DynamicResource Tc.TextMuted}" />
                    </Grid>
                    <ContentControl x:Name="ActiveCurvePreviewHost" Height="138" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Tc.Border}" Margin="0,13,0,12" />
                <TextBlock Text="Live state"
                           Foreground="{DynamicResource Tc.TextMuted}"
                           FontSize="{x:Static ui:TypographyScale.Caption}" />

                <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Control temperature" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                        <TextBlock Text="{Binding ControlTemperatureText}" FontSize="{x:Static ui:TypographyScale.Value}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding ControlTemperatureCaption}" ToolTip="{Binding ControlTemperatureSource}" Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="{DynamicResource Tc.Border}" />

                    <StackPanel Grid.Column="2" Margin="18,0">
                        <TextBlock Text="Fan speed" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                        <ItemsControl ItemsSource="{Binding Fans}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1,0,1">
                                        <TextBlock Text="{Binding Rpm, StringFormat={}{0:N0} RPM}" FontSize="{x:Static ui:TypographyScale.Value}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="—" FontSize="{x:Static ui:TypographyScale.Value}" FontWeight="SemiBold" Margin="0,4,0,0">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Fans.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding FanCountText}" Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Fans.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="3" Width="1" Background="{DynamicResource Tc.Border}" />

                    <StackPanel Grid.Column="4" Margin="18,0,0,0">
                        <TextBlock Text="Fan control" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                        <TextBlock x:Name="AppliedLevelText" Text="Auto" FontSize="{x:Static ui:TypographyScale.Value}" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel x:Name="AdvancedFanControlsExpander" Margin="0,10,0,0">
            <TextBlock x:Name="FanMappingDetailText" Style="{StaticResource TcText.Caption}" TextWrapping="Wrap"
                       ToolTip="{Binding CoolingAvailabilityText, Mode=OneWay}" />
            <TextBlock x:Name="FanProviderDetailText" Visibility="Collapsed" />
        </StackPanel>

        <Expander x:Name="ManualControlExpander" Header="Temporary fan test" Style="{StaticResource TcQuietExpander}" Margin="0,14,0,0">
            <Border Style="{StaticResource TcSection}" Margin="0,8,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Temporary fan target" FontWeight="SemiBold" />
                            <TextBlock x:Name="ManualControlDescriptionText" Text="Try this target for 30 seconds. Your previous profile is restored afterwards."
                                       Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,5,170,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock x:Name="ManualPercentValue" Text="50%" HorizontalAlignment="Right" FontSize="{x:Static ui:TypographyScale.Value}" FontWeight="SemiBold" />
                            <TextBlock Text="30 s test" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Slider x:Name="ManualPercentSlider" Style="{StaticResource TcSlider}" Minimum="0" Maximum="100" Value="50" TickFrequency="1" ValueChanged="ManualPercentSlider_ValueChanged" />
                        <Button x:Name="ManualPercentApplyButton" Grid.Column="1" Content="Start test" Style="{StaticResource TcButton}" Padding="12,5" Margin="12,0,0,0" Click="ManualPercentApply_Click" />
                    </Grid>

                    <Expander x:Name="RawEcStepsExpander" Header="Raw EC diagnostics" Style="{StaticResource TcQuietExpander}" Margin="0,13,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Provider-only diagnostic. These raw states appear only when the active provider explicitly exposes a verified discrete-EC contract. Selecting a state starts the same temporary 30-second test and restores the previous profile automatically."
                                       Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button Content="1" Style="{StaticResource TcButton}" Tag="1" Click="ManualLevel_Click" Margin="0,0,4,0" />
                                <Button Grid.Column="1" Content="2" Style="{StaticResource TcButton}" Tag="2" Click="ManualLevel_Click" Margin="2,0" />
                                <Button Grid.Column="2" Content="3" Style="{StaticResource TcButton}" Tag="3" Click="ManualLevel_Click" Margin="2,0" />
                                <Button Grid.Column="3" Content="4" Style="{StaticResource TcButton}" Tag="4" Click="ManualLevel_Click" Margin="2,0" />
                                <Button Grid.Column="4" Content="5" Style="{StaticResource TcButton}" Tag="5" Click="ManualLevel_Click" Margin="2,0" />
                                <Button Grid.Column="5" Content="6" Style="{StaticResource TcButton}" Tag="6" Click="ManualLevel_Click" Margin="2,0" />
                                <Button Grid.Column="6" Content="7" Style="{StaticResource TcButton}" Tag="7" Click="ManualLevel_Click" Margin="4,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </Expander>
    </StackPanel>
</UserControl>
