<UserControl x:Class="ThinkControl.UI.Controls.KeyboardEffectsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="520">
    <Border Style="{StaticResource TcSection}" Margin="0,14,0,0">
        <StackPanel>
            <Grid>
                <TextBlock Text="Effects" FontWeight="SemiBold" />
                <TextBlock Text="{Binding KeyboardModeText}"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource Tc.TextMuted}" />
            </Grid>

            <TextBlock Margin="0,7,0,12"
                       Text="ThinkControl uses the X9's verified Off / Low / High levels as building blocks. If Lenovo firmware fades level changes, Breathing inherits that smooth transition without pretending the keyboard has a 0–100% PWM API."
                       Foreground="{DynamicResource Tc.TextMuted}"
                       FontSize="10.5"
                       TextWrapping="Wrap" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="EffectAuto" GroupName="AdvancedKeyboardEffect" Style="{StaticResource TcSegment}" Content="Auto" Tag="Auto" Click="Effect_Click" IsEnabled="{Binding CanKeyboardBacklight}" Margin="0,0,5,0" />
                <RadioButton x:Name="EffectBreathing" Grid.Column="1" GroupName="AdvancedKeyboardEffect" Style="{StaticResource TcSegment}" Content="Breathing" Tag="Breathing" Click="Effect_Click" IsEnabled="{Binding CanKeyboardBacklight}" Margin="2,0" />
                <RadioButton x:Name="EffectReactive" Grid.Column="2" GroupName="AdvancedKeyboardEffect" Style="{StaticResource TcSegment}" Content="Reactive" Tag="Reactive" Click="Effect_Click" IsEnabled="{Binding CanKeyboardBacklight}" Margin="2,0" />
                <RadioButton x:Name="EffectAudio" Grid.Column="3" GroupName="AdvancedKeyboardEffect" Style="{StaticResource TcSegment}" Content="Audio" Tag="Audio" Click="Effect_Click" IsEnabled="{Binding CanKeyboardBacklight}" Margin="5,0,0,0" />
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Resting level" VerticalAlignment="Center" Foreground="{DynamicResource Tc.TextMuted}" />
                <RadioButton x:Name="BaseLow" Grid.Column="1" GroupName="AdvancedKeyboardBase" Style="{StaticResource TcSegment}" Content="Low" Tag="Low" Click="BaseLevel_Click" Margin="0,0,4,0" />
                <RadioButton x:Name="BaseHigh" Grid.Column="2" GroupName="AdvancedKeyboardBase" Style="{StaticResource TcSegment}" Content="High" Tag="High" Click="BaseLevel_Click" Margin="4,0,0,0" />
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="62" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Effect speed" VerticalAlignment="Center" Foreground="{DynamicResource Tc.TextMuted}" />
                <Slider x:Name="EffectSpeed"
                        Grid.Column="1"
                        Minimum="0.5"
                        Maximum="2.0"
                        SmallChange="0.1"
                        LargeChange="0.25"
                        Value="{Binding KeyboardEffectSpeed, Mode=OneWay}"
                        Style="{StaticResource TcSlider}"
                        Margin="0,0,12,0"
                        ValueChanged="EffectSpeed_ValueChanged" />
                <TextBlock Grid.Column="2"
                           Text="{Binding KeyboardEffectSpeed, StringFormat={}{0:0.0}×}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>

            <TextBlock Margin="0,10,0,0"
                       Text="Reactive responds to keyboard activity only. Audio mode reads a local loopback RMS level and stores no audio. Hardware writes are deduplicated and rate-limited."
                       Foreground="{DynamicResource Tc.TextFaint}"
                       FontSize="9.5"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
