<UserControl x:Class="ThinkControl.UI.Controls.BatteryTelemetryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ThinkControl.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:AppState, IsDesignTimeCreatable=True}"
             d:DesignWidth="640"
             MinWidth="520">
    <Border Style="{StaticResource TcSection}" Margin="0,14,0,0">
        <StackPanel>
            <TextBlock Text="Live telemetry" FontWeight="SemiBold" />

            <Grid Margin="0,13,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="POWER" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                    <TextBlock Text="{Binding BatteryPowerText}" d:Text="18.4 W" FontSize="16" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="ETA" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                    <TextBlock Text="{Binding BatteryEtaText}" d:Text="~1h 12m to full" FontSize="16" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="HEALTH" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                    <TextBlock Text="{Binding BatteryHealthText}" d:Text="98% health" FontSize="16" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="10,0,0,0">
                    <TextBlock Text="ENERGY" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                    <TextBlock Text="{Binding BatteryCapacityText}" d:Text="46.2 / 80.0 Wh" FontSize="16" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding BatteryAveragePowerText}" d:Text="17.9 W avg" FontSize="11" Foreground="{DynamicResource Tc.TextMuted}" />
                <TextBlock Grid.Column="1" Text="{Binding BatterySource}" d:Text="Windows ACPI battery" FontSize="10.5" Foreground="{DynamicResource Tc.TextFaint}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </Grid>

            <TextBlock Margin="0,9,0,0"
                       Text="ETA is calculated from remaining battery energy and a median-filtered moving average of the recent charge/discharge rate. It deliberately changes slowly instead of copying a noisy one-sample estimate."
                       Foreground="{DynamicResource Tc.TextFaint}"
                       FontSize="9.5"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
