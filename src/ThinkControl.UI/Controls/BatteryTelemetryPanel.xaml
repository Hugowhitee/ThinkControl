<UserControl x:Class="ThinkControl.UI.Controls.BatteryTelemetryPanel" xmlns:ui="clr-namespace:ThinkControl.UI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="clr-namespace:ThinkControl.UI.Controls" xmlns:viewModels="clr-namespace:ThinkControl.UI.ViewModels" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=viewModels:AppState, IsDesignTimeCreatable=True}" d:DesignWidth="860" MinWidth="520" Loaded="BatteryTelemetryPanel_Loaded" Unloaded="BatteryTelemetryPanel_Unloaded">
  <StackPanel>
    <TextBlock Text="CURRENT BATTERY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextFaint}" Margin="0,0,0,12" />
    <Grid MinHeight="80">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.63*" />
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource TcSection}" Padding="14" Margin="0,0,24,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="86" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <controls:BatteryGauge x:Name="CurrentBatteryGauge" MotionPreference="{Binding BatteryMotionPreference}" Width="78" Height="31" Percent="{Binding BatteryPercent}" IsCharging="{Binding BatteryCharging}" IsDischarging="{Binding BatteryDischarging}" VerticalAlignment="Center" HorizontalAlignment="Left" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding BatteryPercentText}" Style="{StaticResource TcText.ValueLarge}" />
              <controls:PackIconLucide Kind="Lightning" Width="18" Height="18" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Tc.Success}" Opacity="{Binding ChargingSymbolOpacity, ElementName=CurrentBatteryGauge}" ToolTip="Charging" AutomationProperties.Name="Charging">
                <controls:PackIconLucide.Style><Style TargetType="controls:PackIconLucide"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding BatteryCharging}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></controls:PackIconLucide.Style>
              </controls:PackIconLucide>
            </StackPanel>
            <TextBlock Text="{Binding BatteryEtaText}" Style="{StaticResource TcText.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Border>
      <controls:TelemetryMetric Grid.Column="1" Label="HEALTH" Value="{Binding BatteryHealthValueText}" Caption="Current capacity" />
      <controls:TelemetryMetric Grid.Column="2" Label="CYCLES" Value="{Binding BatteryCycleCountValueText}" Caption="Firmware cycles" />
      <controls:TelemetryMetric Grid.Column="3" Label="POWER" Value="{Binding BatteryPowerText}" Caption="Live draw" />
    </Grid>
    <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.12*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource TcSection}" Margin="0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Battery preservation" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource TcText.SectionTitle}" TextWrapping="Wrap" Margin="0,0,12,0" />
            <CheckBox x:Name="ChargeProtectionSwitch" Grid.Column="1" Style="{StaticResource TcSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Battery preservation" IsEnabled="False" Click="ChargeProtectionSwitch_Click" ToolTip="Turn the verified OEM battery charge window on or off" />
          </Grid>
          <TextBlock Text="Charge limit" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,12,0,0" />
          <Grid Margin="0,4,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="ChargeLimitValue" Text="—" Style="{StaticResource TcText.ValueLarge}" />
              <TextBlock x:Name="ChargeProtectionStateText" Text="Checking…" FontSize="{x:Static ui:TypographyScale.Caption}" Foreground="{DynamicResource Tc.TextMuted}" VerticalAlignment="Center" Margin="12,0,8,0" />
            </StackPanel>
            <Button x:Name="CustomChargeLimitsButton" Grid.Column="1" Content="Edit" ToolTip="Edit custom charge limits" Style="{StaticResource TcButton}" HorizontalAlignment="Right" IsEnabled="False" Click="CustomChargeLimits_Click" />
          </Grid>
          <ListBox x:Name="ChargeProtectionComboBox" BorderThickness="0" Background="Transparent" Padding="0" Margin="-3,0" IsEnabled="False" SelectionChanged="ChargeProtection_SelectionChanged">
            <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate></ListBox.Template>
            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="3,0" />
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <RadioButton Content="{TemplateBinding Content}" ToolTip="{TemplateBinding ToolTip}" GroupName="ChargePreservationLimit" Style="{StaticResource TcSegment}" Padding="4,7" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              </ControlTemplate></Setter.Value></Setter>
            </Style></ListBox.ItemContainerStyle>
            <ListBoxItem Content="80%" ToolTip="80% (strong protection)" Tag="75,80" />
            <ListBoxItem Content="85%" ToolTip="85% (recommended)" Tag="80,85" />
            <ListBoxItem Content="90%" ToolTip="90% (more runtime)" Tag="85,90" />
            <ListBoxItem Content="95%" ToolTip="95% (light protection)" Tag="90,95" />
          </ListBox>

          <StackPanel x:Name="CustomChargeEditor" Visibility="Collapsed" Margin="0,6,0,9">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Resume below" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                <ComboBox x:Name="CustomChargeStartComboBox" Style="{StaticResource TcComboBox}" Margin="0,5,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Stop at" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                <ComboBox x:Name="CustomChargeStopComboBox" Style="{StaticResource TcComboBox}" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
            <TextBlock x:Name="CustomChargeValidationText" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,5,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
              <Button Content="Cancel" Style="{StaticResource TcInlineButton}" Click="CustomChargeCancel_Click" />
              <Button x:Name="CustomChargeApplyButton" Content="Apply limits" Style="{StaticResource TcButton}" Margin="8,0,0,0" Click="CustomChargeApply_Click" />
            </StackPanel>
          </StackPanel>
          <controls:BatteryProtectionGauge IsPluggedIn="{Binding BatteryPluggedIn}" Height="54" Margin="0,8,0,0" FlowPhase="{Binding ChargingFlowPhase, ElementName=CurrentBatteryGauge}" ProtectionEnabled="{Binding BatteryProtectionEnabled}" StartPercent="{Binding BatteryProtectionStartPercent}" StopPercent="{Binding BatteryProtectionStopPercent}" CurrentPercent="{Binding BatteryPercent}" IsCharging="{Binding BatteryCharging}" ToolTip="Current charge, resume threshold and charge limit." />
          <TextBlock x:Name="ChargeProtectionImpactText" Text="Checking the active charge limit…" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,7,0,0" />
          <TextBlock x:Name="ChargeProtectionWearText" Text="Checking charging guidance…" Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" ToolTip="Battery aging depends on time at high charge, temperature, depth of discharge, use and chemistry; a charge cap does not measure this battery's actual wear." />
          <TextBlock x:Name="ChargeProtectionProviderText" Text="Verified OEM charge-threshold provider." Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed" />
          <Button x:Name="ChargeProtectionFallbackButton" Content="Lenovo battery settings ↗" Style="{StaticResource TcExternalSettingsLink}" Margin="-7,7,0,0" Click="OpenVantage_Click" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource TcSection}">
        <StackPanel>
          <TextBlock Text="Charge session" Style="{StaticResource TcText.SectionTitle}" />
          <TextBlock x:Name="SessionStateText" Text="No recorded charge session" Style="{StaticResource TcText.Caption}" Margin="0,12,0,0" />
          <TextBlock x:Name="SessionRangeText" Text="—" Style="{StaticResource TcText.ValueLarge}" Margin="0,7,0,0" />
          <Border Height="1" Background="{DynamicResource Tc.Divider}" Margin="0,14" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <controls:TelemetryMetric Label="DURATION" x:Name="SessionDurationMetric" ValueFontSize="15" Value="—" />
            <controls:TelemetryMetric Grid.Column="1" Label="AVERAGE" x:Name="SessionPowerMetric" ValueFontSize="15" Value="—" />
            <controls:TelemetryMetric Grid.Column="2" Label="ENERGY" x:Name="SessionEnergyMetric" ValueFontSize="15" Value="—" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
    <Border Style="{StaticResource TcSection}" Margin="0,16,0,0">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Battery history" Style="{StaticResource TcText.SectionTitle}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Grid.Column="1">
            <RadioButton x:Name="BatteryHistoryChargeTab" Content="Charge" Tag="Charge" GroupName="BatteryHistoryView" Style="{StaticResource TcSegment}" IsChecked="True" Click="HistoryTab_Click" MinWidth="100" Margin="0,0,8,0" />
            <RadioButton Content="Discharge" Tag="Discharge" GroupName="BatteryHistoryView" Style="{StaticResource TcSegment}" Click="HistoryTab_Click" MinWidth="100" Margin="0,0,8,0" />
            <RadioButton Content="Health" Tag="Health" GroupName="BatteryHistoryView" Style="{StaticResource TcSegment}" Click="HistoryTab_Click" MinWidth="80" Margin="0,0,8,0" />
            <RadioButton x:Name="BatteryHistoryCyclesTab" Content="Cycles" Tag="Cycles" GroupName="BatteryHistoryView" Style="{StaticResource TcSegment}" Click="HistoryTab_Click" MinWidth="80" />
          </StackPanel>
        </Grid>
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Grid x:Name="HistoryChartHost">
            <Border Style="{StaticResource TcSection}" Padding="0" BorderThickness="0" Visibility="Collapsed" x:Name="CycleHistoryView">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="150" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Firmware cycle count" FontWeight="SemiBold" />
                <controls:TimeSeriesChart Grid.Row="1" Margin="0,9,0,0" Values="{Binding BatteryCycleCountTimeline}" Unit="cycles" ValueFormat="0" IncludeZero="False" />
                <TextBlock Grid.Row="2" Text="{Binding BatteryCycleTrendText}" Style="{StaticResource TcText.Caption}" TextWrapping="Wrap" Margin="0,9,0,0" />
              </Grid>
            </Border>
            <Border Style="{StaticResource TcSection}" Padding="0" BorderThickness="0" Visibility="Visible" x:Name="ChargeHistoryView">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="150" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                  <TextBlock Text="Charge history" FontWeight="SemiBold" />
                  <TextBlock Text="Battery level" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                </Grid>
                <controls:TimeSeriesChart x:Name="ChargePercentChart" Grid.Row="1" Margin="0,9,0,0" Unit="%" ValueFormat="0" IncludeZero="False" IsLive="{Binding BatteryCharging}" LiveWindowMinutes="60" />
                <TextBlock Grid.Row="2" Text="{Binding BatteryCurrentSessionText}" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,9,0,0" TextWrapping="Wrap" />
              </Grid>
            </Border>
            <Border Style="{StaticResource TcSection}" Padding="0" BorderThickness="0" Visibility="Collapsed" x:Name="DischargeHistoryView">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="150" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                  <TextBlock Text="Discharge history" FontWeight="SemiBold" />
                  <TextBlock Text="Battery level" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                </Grid>
                <controls:TimeSeriesChart x:Name="DischargePercentChart" Grid.Row="1" Margin="0,9,0,0" Unit="%" ValueFormat="0" IncludeZero="False" LiveWindowMinutes="90" />
                <controls:TimeSeriesChart x:Name="DischargeChart" Visibility="Collapsed" Height="0" Unit="W" ValueFormat="0.0" IncludeZero="True" />
                <TextBlock x:Name="DischargeSummaryText" Grid.Row="2" Text="Learning from battery use" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,9,0,0" TextWrapping="Wrap" />
              </Grid>
            </Border>
            <Border Style="{StaticResource TcSection}" Padding="0" BorderThickness="0" Visibility="Collapsed" x:Name="HealthHistoryView">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="125" />
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="Battery health trend" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding BatteryHealthTrendText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Compares full-charge capacity with the battery's original capacity. Charging limits do not affect this calculation." Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <controls:TimeSeriesChart Grid.Row="2" Margin="0,8,0,0" Values="{Binding BatteryHealthTrendTimeline}" Unit="%" ValueFormat="0.0" IncludeZero="False" />
              </Grid>
            </Border>
          </Grid>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Recorded activity" Style="{StaticResource TcText.ControlLabel}" />
            <TextBlock Text="Charging, discharge and capacity trends stay together here." Style="{StaticResource TcText.Caption}" TextWrapping="Wrap" Margin="0,12,0,20" />
            <Button Content="View sessions" Style="{StaticResource TcButton}" Click="BatterySessions_Click" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
    <StackPanel x:Name="BatteryDetails" Margin="0,16,0,0">
      <TextBlock Text="Battery details" Style="{StaticResource TcText.SectionTitle}" />
      <Border Style="{StaticResource TcSection}" Margin="0,12,0,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <controls:TelemetryMetric Label="ENERGY CAPACITY" Value="{Binding BatteryCapacityText}" Caption="Remaining / full capacity" Margin="0,0,20,0" />
            <controls:TelemetryMetric Grid.Column="1" Label="{Binding BatteryTemperatureLabel}" Value="{Binding BatteryTemperatureText}" Caption="Battery sensor" />
          </Grid>
          <Border Height="1" Background="{DynamicResource Tc.Border}" Margin="0,18,0,18" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="Typical battery endurance" Style="{StaticResource TcText.ControlLabel}" />
              <TextBlock Text="{Binding BatteryTypicalRuntimeText}" Style="{StaticResource TcText.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
              <TextBlock Text="Estimate from partial recorded use; actual runtime varies with workload." Style="{StaticResource TcText.Caption}" TextWrapping="Wrap" Margin="0,4,0,16" />
              <TextBlock Text="Typical charging power" Style="{StaticResource TcText.ControlLabel}" />
              <TextBlock Text="{Binding BatteryTypicalChargeText}" Style="{StaticResource TcText.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
              <TextBlock Text="Learned from recorded charging sessions." Style="{StaticResource TcText.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Battery usage ↗" Style="{StaticResource TcExternalSettingsLink}" VerticalAlignment="Top" Click="OpenBatteryUsage_Click" ToolTip="Open energy use by app in Windows Settings" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel x:Name="BatterySessions" Margin="0,16,0,0">
      <TextBlock Text="Recorded sessions" Style="{StaticResource TcText.SectionTitle}" />
      <Border Style="{StaticResource TcSection}" Margin="0,12,0,0">
        <StackPanel>
          <StackPanel>
            <TextBlock Text="Open a day, then select a session to see its measurements and graphs." Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel x:Name="RecentSessionItems" Margin="0,10,0,0" />
          <Button x:Name="HistoryRangeButton" Content="Show older" Style="{StaticResource TcExternalSettingsLink}" HorizontalAlignment="Left" Margin="-7,4,0,0" Visibility="Collapsed" Click="HistoryRange_Click" />
          <Button x:Name="ManageHistoryButton" Content="History settings" Style="{StaticResource TcInlineButton}" HorizontalAlignment="Left" Margin="0,9,0,0" Click="ManageHistory_Click" />
          <Border x:Name="HistorySettings" Visibility="Collapsed" BorderBrush="{DynamicResource Tc.Border}" BorderThickness="0,1,0,0" Margin="0,8,0,0">
            <StackPanel Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                  <TextBlock Text="Detailed graphs" FontWeight="SemiBold" FontSize="{x:Static ui:TypographyScale.Secondary}" />
                  <TextBlock Text="Older sessions are automatically compacted into small summaries instead of staying as an endless raw list." Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <ComboBox x:Name="BatteryHistoryRetentionComboBox" Grid.Column="1" Style="{StaticResource TcComboBox}" Width="150" MinHeight="38" SelectionChanged="BatteryHistoryRetention_SelectionChanged">
                  <ComboBoxItem Content="7 days" Tag="7" />
                  <ComboBoxItem Content="14 days" Tag="14" />
                  <ComboBoxItem Content="30 days" Tag="30" />
                </ComboBox>
              </Grid>
              <TextBlock x:Name="HistoryStorageSummaryText" Text="Detailed graphs: 7 days. Daily summaries: 1 year." Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,7,0,0" />
              <Border Height="1" Background="{DynamicResource Tc.Border}" Margin="0,10,0,9" />
              <Grid>
                <StackPanel Margin="0,0,170,0">
                  <TextBlock Text="Reset history" FontWeight="SemiBold" FontSize="{x:Static ui:TypographyScale.Secondary}" />
                  <TextBlock Text="This also resets ThinkControl's learned charge/discharge estimates. Current firmware battery health, cycle count and charge protection are not changed." Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <Button Content="Reset all history…" Style="{StaticResource TcButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ResetHistory_Click" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
    <Grid Margin="2,10,2,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="History is saved on this device. Daily summaries are kept for one year." FontSize="{x:Static ui:TypographyScale.Caption}" Foreground="{DynamicResource Tc.TextFaint}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" Text="{Binding BatterySource}" FontSize="{x:Static ui:TypographyScale.Caption}" Foreground="{DynamicResource Tc.TextFaint}" HorizontalAlignment="Right" Margin="18,0,0,0" TextTrimming="CharacterEllipsis" />
    </Grid>
  </StackPanel>
</UserControl>
