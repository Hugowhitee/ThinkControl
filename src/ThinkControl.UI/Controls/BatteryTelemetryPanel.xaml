<UserControl x:Class="ThinkControl.UI.Controls.BatteryTelemetryPanel"
             xmlns:ui="clr-namespace:ThinkControl.UI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
             xmlns:viewModels="clr-namespace:ThinkControl.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:AppState, IsDesignTimeCreatable=True}"
             d:DesignWidth="860"
             MinWidth="520">
    <StackPanel>
        <Border Style="{StaticResource TcSection}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="245" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="CHARGE" FontSize="{x:Static ui:TypographyScale.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                    <controls:BatteryGauge Width="205" Height="60" HorizontalAlignment="Left" Margin="0,11,0,0" Percent="{Binding BatteryPercent}" IsCharging="{Binding BatteryCharging}" />
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="{Binding BatteryPercentText}" FontSize="{x:Static ui:TypographyScale.ValueHero}" FontWeight="Light" />
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BatteryStatus}" HorizontalAlignment="Right" FontSize="{x:Static ui:TypographyScale.Secondary}" Foreground="{DynamicResource Tc.TextMuted}" />
                            <TextBlock Text="{Binding BatteryEtaText}" HorizontalAlignment="Right" FontSize="{x:Static ui:TypographyScale.Caption}" FontWeight="Medium" Foreground="{DynamicResource Tc.TextMuted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Grid.RowSpan="2" Width="1" HorizontalAlignment="Right" Background="{DynamicResource Tc.Border}" Margin="0,3,8,3" />
                    <Border Grid.Column="1" Grid.RowSpan="2" Width="1" HorizontalAlignment="Right" Background="{DynamicResource Tc.Border}" Margin="0,3,8,3" />
                    <StackPanel Margin="0,0,16,12"><TextBlock Text="POWER" FontSize="{x:Static ui:TypographyScale.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" /><TextBlock Text="{Binding BatteryPowerText}" FontSize="{x:Static ui:TypographyScale.Value}" Margin="0,5,0,0" /><TextBlock Text="{Binding BatteryAveragePowerText}" FontSize="{x:Static ui:TypographyScale.Caption}" Foreground="{DynamicResource Tc.TextFaint}" Margin="0,2,0,0" /></StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,16,12"><TextBlock Text="HEALTH" FontSize="{x:Static ui:TypographyScale.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" /><TextBlock Text="{Binding BatteryHealthText}" FontSize="{x:Static ui:TypographyScale.Value}" Margin="0,5,0,0" /></StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0,0,12"><TextBlock Text="CYCLES" FontSize="{x:Static ui:TypographyScale.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" /><TextBlock Text="{Binding BatteryCycleCountText}" FontSize="{x:Static ui:TypographyScale.Value}" Margin="0,5,0,0" /></StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,3,16,0"><TextBlock Text="ENERGY" FontSize="{x:Static ui:TypographyScale.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" /><TextBlock Text="{Binding BatteryCapacityText}" FontSize="{x:Static ui:TypographyScale.Value}" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,3,16,0"><TextBlock Text="{Binding BatteryTemperatureLabel}" FontSize="{x:Static ui:TypographyScale.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" /><TextBlock Text="{Binding BatteryTemperatureText}" FontSize="{x:Static ui:TypographyScale.Value}" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,3,0,0"><TextBlock Text="LEARNED" FontSize="{x:Static ui:TypographyScale.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" /><TextBlock Text="{Binding BatteryTypicalChargeText}" FontSize="{x:Static ui:TypographyScale.Value}" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource TcSection}" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Charge history" FontWeight="SemiBold" />
                        <TextBlock Text="Battery level" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                    </Grid>
                    <controls:TimeSeriesChart x:Name="ChargePercentChart" Grid.Row="1" Margin="0,9,0,0" Unit="%" ValueFormat="0" IncludeZero="False" IsLive="{Binding BatteryCharging}" LiveWindowMinutes="60" />
                    <TextBlock Grid.Row="2" Text="{Binding BatteryCurrentSessionText}" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,9,0,0" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource TcSection}" Margin="7,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Discharge history" FontWeight="SemiBold" />
                        <TextBlock Text="Battery level" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                    </Grid>
                    <controls:TimeSeriesChart x:Name="DischargePercentChart" Grid.Row="1" Margin="0,9,0,0" Unit="%" ValueFormat="0" IncludeZero="False" LiveWindowMinutes="90" />
                    <controls:TimeSeriesChart x:Name="DischargeChart" Visibility="Collapsed" Height="0" Unit="W" ValueFormat="0.0" IncludeZero="True" />
                    <TextBlock x:Name="DischargeSummaryText" Grid.Row="2" Text="Learning from battery use" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,9,0,0" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource TcSection}" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="125" /></Grid.RowDefinitions>
                    <Grid><TextBlock Text="Battery health trend" FontWeight="SemiBold" /><TextBlock Text="{Binding BatteryHealthTrendText}" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" /></Grid>
                    <controls:TimeSeriesChart Grid.Row="1" Margin="0,8,0,0" Values="{Binding BatteryHealthTrendTimeline}" Unit="%" ValueFormat="0.0" IncludeZero="False" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource TcSection}" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="Charge protection" FontWeight="SemiBold" />
                    <TextBlock Text="A charge limit is only written when a verified OEM battery provider exposes it. Until then ThinkControl leaves the firmware setting untouched." Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Button Content="Battery settings ↗" Style="{StaticResource TcExternalSettingsLink}" Margin="-7,9,0,0" Click="OpenVantage_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource TcSection}" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Battery history" FontWeight="SemiBold" />
                        <TextBlock Text="Days stay compact. Open a day to see its charge and usage sessions, then open a session for graphs and essential statistics." Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,3,150,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Content="Clear history" Style="{StaticResource TcButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ClearHistory_Click" />
                </Grid>
                <StackPanel x:Name="RecentSessionItems" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <Grid Margin="2,10,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="History: local only · recent session graphs · one year of compact summaries" FontSize="{x:Static ui:TypographyScale.Caption}" Foreground="{DynamicResource Tc.TextFaint}" />
            <TextBlock Grid.Column="1" Text="{Binding BatterySource}" FontSize="{x:Static ui:TypographyScale.Caption}" Foreground="{DynamicResource Tc.TextFaint}" HorizontalAlignment="Right" Margin="18,0,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>
    </StackPanel>
</UserControl>
