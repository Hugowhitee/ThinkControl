<Window x:Class="ThinkControl.UI.SensorDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
        Title="ThinkControl · Sensor details"
        Width="900" Height="700" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Tc.Window}"
        Foreground="{DynamicResource Tc.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <controls:SensorsPanel x:Name="SensorsPanelControl" />
        </ScrollViewer>
        <Button Grid.Row="1" Content="Close" Style="{StaticResource TcButton}"
                HorizontalAlignment="Right" Padding="14,6" Margin="0,12,0,0" Click="Close_Click" />
    </Grid>
</Window>
