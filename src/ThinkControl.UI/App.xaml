<Application x:Class="ThinkControl.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/MaterialSymbols.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="Tc.Window" Color="#101214" />
            <SolidColorBrush x:Key="Tc.Surface" Color="#171A1D" />
            <SolidColorBrush x:Key="Tc.SurfaceAlt" Color="#1D2024" />
            <SolidColorBrush x:Key="Tc.SurfaceHover" Color="#25292E" />
            <SolidColorBrush x:Key="Tc.Border" Color="#34383D" />
            <SolidColorBrush x:Key="Tc.BorderStrong" Color="#474C52" />
            <SolidColorBrush x:Key="Tc.Text" Color="#F2F3F4" />
            <SolidColorBrush x:Key="Tc.TextMuted" Color="#A8ADB4" />
            <SolidColorBrush x:Key="Tc.TextFaint" Color="#858B92" />
            <SolidColorBrush x:Key="Tc.Accent" Color="#E32929" />
            <SolidColorBrush x:Key="Tc.AccentHover" Color="#F13B3B" />
            <SolidColorBrush x:Key="Tc.Success" Color="#4CCB7A" />
            <SolidColorBrush x:Key="Tc.Warning" Color="#E7A640" />

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{DynamicResource Tc.Text}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource Tc.SurfaceAlt}" />
                <Setter Property="Foreground" Value="{DynamicResource Tc.Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Tc.BorderStrong}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="TcSection" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Tc.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Tc.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="TcButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource Tc.Text}" />
                <Setter Property="Background" Value="{DynamicResource Tc.SurfaceAlt}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Tc.BorderStrong}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <Grid ClipToBounds="True">
                                    <Border x:Name="InteractionOverlay" Background="White" Opacity="0" CornerRadius="2" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="InteractionOverlay" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="InteractionOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10" /></Storyboard></BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Tc.Accent}" />
                                    <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.13" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.42" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TcIconButton" TargetType="Button" BasedOn="{StaticResource TcButton}">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="TcInlineButton" TargetType="Button" BasedOn="{StaticResource TcButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Tc.TextMuted}" />
                <Setter Property="Padding" Value="5,3" />
                <Setter Property="FontSize" Value="10.5" />
            </Style>

            <Style x:Key="TcSegment" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource Tc.Text}" />
                <Setter Property="Background" Value="{DynamicResource Tc.SurfaceAlt}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Tc.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <Grid ClipToBounds="True">
                                    <Border x:Name="InteractionOverlay" Background="White" Opacity="0" CornerRadius="2" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="InteractionOverlay" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="InteractionOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10" /></Storyboard></BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.12" /></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Tc.Accent}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Tc.Accent}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.42" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TcNav" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource Tc.TextMuted}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="{TemplateBinding Background}">
                                <Border x:Name="Indicator" Width="2" Background="Transparent" HorizontalAlignment="Left" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Tc.SurfaceHover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Tc.Text}" />
                                    <Setter Property="Background" Value="{DynamicResource Tc.SurfaceAlt}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Tc.Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TcSwitch" TargetType="CheckBox">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="42" Height="22">
                                <Border x:Name="Track"
                                        CornerRadius="11"
                                        Background="{DynamicResource Tc.SurfaceAlt}"
                                        BorderBrush="{DynamicResource Tc.BorderStrong}"
                                        BorderThickness="1" />
                                <Ellipse x:Name="Thumb"
                                         Width="16" Height="16"
                                         Margin="3"
                                         Fill="{DynamicResource Tc.TextMuted}"
                                         HorizontalAlignment="Left" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Tc.TextFaint}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource Tc.Accent}" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Tc.Accent}" />
                                    <Setter TargetName="Thumb" Property="Fill" Value="White" />
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Slider buttons have explicit templates so Windows does not flash a
                 bright stock RepeatButton when hovering the track. The 24px thumb
                 is the hit target; the visible dot remains compact at 13px. -->
            <Style x:Key="TcSliderDecrease" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Height" Value="5" />
                <Setter Property="Background" Value="{DynamicResource Tc.Accent}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border x:Name="Line" Height="5" Margin="0,0,-12,0" CornerRadius="2.5,0,0,2.5" Background="{TemplateBinding Background}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource Tc.AccentHover}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TcSliderIncrease" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Height" Value="5" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border x:Name="Line" Height="5" Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TcSlider" TargetType="Slider">
                <Setter Property="Height" Value="30" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Background="Transparent" ClipToBounds="True">
                                <Border Height="5" VerticalAlignment="Center" CornerRadius="2.5" Background="{DynamicResource Tc.BorderStrong}" />
                                <Track x:Name="PART_Track" Margin="12,0" VerticalAlignment="Center">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TcSliderDecrease}" Margin="-12,0,0,0" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="26" Height="26" Background="Transparent">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid Background="Transparent">
                                                        <Ellipse x:Name="Dot" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Fill="{DynamicResource Tc.Text}" Stroke="{DynamicResource Tc.BorderStrong}" StrokeThickness="1" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Dot" Property="Width" Value="17" />
                                                            <Setter TargetName="Dot" Property="Height" Value="17" />
                                                            <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Tc.TextMuted}" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="Dot" Property="Width" Value="18" />
                                                            <Setter TargetName="Dot" Property="Height" Value="18" />
                                                            <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Tc.Accent}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TcSliderIncrease}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- WPF's stock scrollbar uses system chrome and stays bright in a dark app.
                 Keep the native interaction model, but use a compact Fluent-like thumb
                 so every scrollable page follows the same theme. -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Tc.BorderStrong}" />
                <Setter Property="Width" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent" SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track"
                                       Orientation="{TemplateBinding Orientation}"
                                       IsDirectionReversed="True"
                                       Focusable="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton x:Name="DecreaseButton"
                                                      Command="{x:Static ScrollBar.PageUpCommand}"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False"
                                                      Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="ScrollThumb" MinHeight="28" MinWidth="28" Margin="2,1">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBody"
                                                            Background="{DynamicResource Tc.BorderStrong}"
                                                            CornerRadius="3" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource Tc.TextFaint}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton x:Name="IncreaseButton"
                                                      Command="{x:Static ScrollBar.PageDownCommand}"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False"
                                                      Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Width" Value="Auto" />
                                    <Setter Property="Height" Value="10" />
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                    <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                                    <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                                    <Setter TargetName="ScrollThumb" Property="Margin" Value="1,2" />
                                </Trigger>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter Property="Width" Value="10" />
                                    <Setter Property="Height" Value="Auto" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
