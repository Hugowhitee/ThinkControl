<Window x:Class="ThinkControl.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ThinkControl"
        Width="390" Height="500"
        MinWidth="390" MinHeight="500"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource Tc.Window}"
        Foreground="{DynamicResource Tc.Text}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- CompactDashboard is the only compact runtime surface. Compact behaves as
         a persistent quick-control window: clicking another app must not dismiss
         it. Users explicitly hide it with the close button or the tray toggle. -->
    <Grid>
        <controls:CompactDashboard x:Name="Dashboard" />
        <Border x:Name="TransitionOutline"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Panel.ZIndex="30"
                Margin="1"
                CornerRadius="8"
                BorderThickness="2"
                BorderBrush="{DynamicResource Tc.Accent}"
                Opacity="0.88" />
    </Grid>
</Window>
