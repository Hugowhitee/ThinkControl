<Window x:Class="ThinkControl.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ThinkControl"
        Width="410" Height="770"
        MinWidth="410" MinHeight="770"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource Tc.Window}"
        Foreground="{DynamicResource Tc.Text}"
        FontFamily="Segoe UI"
        Deactivated="Window_Deactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="7" GlassFrameThickness="0" ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Tc.Window}"
            BorderBrush="{DynamicResource Tc.BorderStrong}"
            BorderThickness="1"
            CornerRadius="7">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="146" />
                <RowDefinition Height="118" />
                <RowDefinition Height="176" />
                <RowDefinition Height="102" />
                <RowDefinition Height="64" />
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" shell:WindowChrome.IsHitTestVisibleInChrome="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="SemiBold">
                        <Run Text="Think" /><Run Text="Control" />
                    </TextBlock>
                    <TextBlock Text="{Binding DeviceName}" FontSize="11.5" Foreground="{DynamicResource Tc.TextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource TcIconButton}" Content="—" Click="Hide_Click" ToolTip="Hide to tray" />
                <Button Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource TcIconButton}" Content="×" Click="Hide_Click" ToolTip="Hide to tray" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource TcSection}" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CPU" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                            <TextBlock Text="{Binding CpuTemperatureText}" FontSize="26" FontWeight="Light" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="FAN" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                            <TextBlock Text="{Binding FanRpmText}" FontSize="21" FontWeight="Light" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding FanStateText}" FontSize="10.5" Foreground="{DynamicResource Tc.Accent}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <controls:Sparkline Values="{Binding TemperatureHistory}" />
                        <TextBlock Text="60 sec" FontSize="9.5" Foreground="{DynamicResource Tc.TextFaint}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,3" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource TcSection}" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Performance mode" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Width="26" Height="24" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Tc.TextMuted}" Content="›" FontSize="22" Click="OpenSection_Click" Tag="Performance" ToolTip="Open Performance" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="QuietMode" GroupName="CompactMode" Style="{StaticResource TcSegment}" Click="Mode_Click" Tag="Quiet" Margin="0,0,4,0" ToolTip="Best power efficiency. Noise values are estimates, not live sound measurements.">
                            <StackPanel><TextBlock Text="Quiet" HorizontalAlignment="Center" /><TextBlock Text="≈29 dB*" FontSize="10" Foreground="{DynamicResource Tc.TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="BalancedMode" Grid.Column="1" GroupName="CompactMode" Style="{StaticResource TcSegment}" Click="Mode_Click" Tag="Balanced" Margin="2,0" ToolTip="Windows balanced power mode. Noise values are estimates, not live sound measurements.">
                            <StackPanel><TextBlock Text="Balanced" HorizontalAlignment="Center" /><TextBlock Text="≈36 dB*" FontSize="10" Foreground="{DynamicResource Tc.TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="PerformanceMode" Grid.Column="2" GroupName="CompactMode" Style="{StaticResource TcSegment}" Click="Mode_Click" Tag="Performance" Margin="4,0,0,0" ToolTip="Best performance. Noise values are estimates, not live sound measurements.">
                            <StackPanel><TextBlock Text="Performance" HorizontalAlignment="Center" /><TextBlock Text="≈43 dB*" FontSize="10" Foreground="{DynamicResource Tc.TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                        </RadioButton>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource TcSection}" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <RowDefinition Height="48" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="39" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource Tc.TextMuted}" />
                            <TextBlock Text="Display" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Width="26" Height="24" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Tc.TextMuted}" Content="›" FontSize="22" Click="OpenSection_Click" Tag="Display" ToolTip="Open Display" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,7,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <RadioButton x:Name="RefreshAuto" GroupName="CompactRefresh" Style="{StaticResource TcSegment}" Content="Auto" Click="RefreshAuto_Click" Margin="0,0,4,0" />
                        <RadioButton x:Name="Refresh60" Grid.Column="1" GroupName="CompactRefresh" Style="{StaticResource TcSegment}" Content="60 Hz" Click="Refresh60_Click" Margin="2,0" />
                        <RadioButton x:Name="RefreshMax" Grid.Column="2" GroupName="CompactRefresh" Style="{StaticResource TcSegment}" Content="Max" Click="RefreshMax_Click" Margin="4,0,0,0" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Brightness" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Tc.TextMuted}" />
                        <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource TcSlider}" Value="{Binding Brightness}" IsEnabled="{Binding BrightnessAvailable}" ValueChanged="BrightnessSlider_ValueChanged" />
                        <TextBlock Grid.Column="2" Text="{Binding BrightnessText}" FontSize="10.5" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Grid.Row="3">
                        <TextBlock Text="Adaptive brightness" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Tc.TextMuted}" />
                        <CheckBox x:Name="AdaptiveSwitch" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource TcSwitch}" IsEnabled="{Binding AdaptiveBrightnessAvailable}" Click="AdaptiveSwitch_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource TcSection}" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="25" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE765;" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource Tc.TextMuted}" />
                            <TextBlock Text="Keyboard backlight" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Width="26" Height="24" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Tc.TextMuted}" Content="›" FontSize="22" Click="OpenSection_Click" Tag="Keyboard" ToolTip="Open Keyboard" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <RadioButton x:Name="KeyboardOff" GroupName="CompactKeyboard" Style="{StaticResource TcSegment}" Content="Off" Tag="Off" Click="Keyboard_Click" Margin="0,0,3,0" />
                        <RadioButton x:Name="KeyboardLow" Grid.Column="1" GroupName="CompactKeyboard" Style="{StaticResource TcSegment}" Content="Low" Tag="Low" Click="Keyboard_Click" Margin="1,0" />
                        <RadioButton x:Name="KeyboardHigh" Grid.Column="2" GroupName="CompactKeyboard" Style="{StaticResource TcSegment}" Content="High" Tag="High" Click="Keyboard_Click" Margin="1,0" />
                        <RadioButton x:Name="KeyboardAuto" Grid.Column="3" GroupName="CompactKeyboard" Style="{StaticResource TcSegment}" Content="Auto" Tag="Auto" Click="Keyboard_Click" Margin="3,0,0,0" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="5" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource TcSection}" Padding="12" Margin="0,0,4,0" MouseLeftButtonUp="BatteryCard_Click" Cursor="Hand">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Battery" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding BatteryPercentText}" FontSize="17" />
                                <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource Tc.TextFaint}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BatteryStatus}" FontSize="10.5" Foreground="{DynamicResource Tc.TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="›" FontSize="22" Foreground="{DynamicResource Tc.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource TcSection}" Padding="12" Margin="4,0,0,0" MouseLeftButtonUp="FanCard_Click" Cursor="Hand">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Fan control" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                            <TextBlock Text="{Binding FanStateText}" FontSize="11" Foreground="{DynamicResource Tc.Accent}" Margin="0,6,18,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="›" FontSize="22" Foreground="{DynamicResource Tc.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                <Button Style="{StaticResource TcIconButton}" FontFamily="Segoe Fluent Icons" Content="&#xE713;" Click="OpenSettings_Click" ToolTip="Settings" />
                <Button Grid.Column="1" Margin="7,0,0,0" Style="{StaticResource TcIconButton}" FontFamily="Segoe Fluent Icons" Content="&#xE946;" Click="OpenSystem_Click" ToolTip="System status" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0">
                    <TextBlock Text="{Binding HardwareAccess}" FontSize="9.5" Foreground="{DynamicResource Tc.TextFaint}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="ThinkControl runs from the tray" FontSize="9.5" Foreground="{DynamicResource Tc.TextFaint}" />
                </StackPanel>
                <Button Grid.Column="3" x:Name="ExpandButton" Width="40" Height="40" Style="{StaticResource TcButton}" Click="Expand_Click" ToolTip="Open advanced window">
                    <Viewbox Width="16" Height="16">
                        <Path Stroke="{DynamicResource Tc.Text}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,7 L1,1 L7,1 M1,1 L8,8 M15,9 L15,15 L9,15 M15,15 L8,8" />
                    </Viewbox>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
