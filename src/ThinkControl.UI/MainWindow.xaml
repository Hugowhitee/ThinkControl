<Window x:Class="ThinkControl.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ThinkControl"
        Width="410" Height="640"
        MinWidth="410" MinHeight="640"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource Tc.Window}"
        Foreground="{DynamicResource Tc.Text}"
        FontFamily="Segoe UI"
        Deactivated="Window_Deactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="7" GlassFrameThickness="0" ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Tc.Window}"
            BorderBrush="{DynamicResource Tc.BorderStrong}"
            BorderThickness="1"
            CornerRadius="7">
        <Grid Margin="13">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="120" />
                <RowDefinition Height="88" />
                <RowDefinition Height="150" />
                <RowDefinition Height="84" />
                <RowDefinition Height="66" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" shell:WindowChrome.IsHitTestVisibleInChrome="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="20" FontWeight="SemiBold">
                            <Run Text="Think" /><Run Text="Control" />
                        </TextBlock>
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource Tc.Accent}" Margin="4,12,0,0" VerticalAlignment="Top" />
                    </StackPanel>
                    <TextBlock Text="{Binding DeviceName}" FontSize="10.5" Foreground="{DynamicResource Tc.TextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource TcIconButton}" Click="Hide_Click" ToolTip="Hide to tray">
                    <Viewbox Width="12" Height="12">
                        <Path Stroke="{DynamicResource Tc.TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,2 L14,14 M14,2 L2,14" />
                    </Viewbox>
                </Button>
            </Grid>

            <!-- Telemetry -->
            <Border Grid.Row="1" Style="{StaticResource TcSection}" Margin="0,0,0,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CPU" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                            <TextBlock Text="{Binding CpuTemperatureText}" FontSize="24" FontWeight="Light" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="FAN" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                            <TextBlock Text="{Binding FanRpmText}" FontSize="19" FontWeight="Light" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding FanStateText}" FontSize="9.5" Foreground="{DynamicResource Tc.Accent}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <controls:Sparkline Values="{Binding TemperatureHistory}" />
                        <TextBlock Text="60 s" FontSize="9" Foreground="{DynamicResource Tc.TextFaint}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,2" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Performance -->
            <Border Grid.Row="2" Style="{StaticResource TcSection}" Margin="0,0,0,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Performance" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Width="24" Height="20" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Tc.TextMuted}" Content="›" FontSize="19" Click="OpenSection_Click" Tag="Performance" ToolTip="Open Performance" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="QuietMode" GroupName="CompactMode" Style="{StaticResource TcSegment}" Click="Mode_Click" Tag="Quiet" Margin="0,0,4,0" ToolTip="Prefer efficiency and lower thermal activity">
                            <StackPanel><TextBlock Text="Quiet" HorizontalAlignment="Center" /><TextBlock Text="Efficient" FontSize="9.5" Foreground="{DynamicResource Tc.TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="BalancedMode" Grid.Column="1" GroupName="CompactMode" Style="{StaticResource TcSegment}" Click="Mode_Click" Tag="Balanced" Margin="2,0" ToolTip="Balanced Windows power behavior">
                            <StackPanel><TextBlock Text="Balanced" HorizontalAlignment="Center" /><TextBlock Text="Everyday" FontSize="9.5" Foreground="{DynamicResource Tc.TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="PerformanceMode" Grid.Column="2" GroupName="CompactMode" Style="{StaticResource TcSegment}" Click="Mode_Click" Tag="Performance" Margin="4,0,0,0" ToolTip="Prefer maximum performance response">
                            <StackPanel><TextBlock Text="Performance" HorizontalAlignment="Center" /><TextBlock Text="Maximum" FontSize="9.5" Foreground="{DynamicResource Tc.TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" /></StackPanel>
                        </RadioButton>
                    </Grid>
                </Grid>
            </Border>

            <!-- Display: one segment with internal separators -->
            <Border Grid.Row="3" Style="{StaticResource TcSection}" Margin="0,0,0,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="35" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="Monitor" Width="13" Height="13" Margin="0,0,7,0" Foreground="{DynamicResource Tc.TextMuted}" />
                            <TextBlock Text="Display" FontSize="10.5" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Width="24" Height="20" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Tc.TextMuted}" Content="›" FontSize="19" Click="OpenSection_Click" Tag="Display" ToolTip="Open Display" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,7,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <RadioButton x:Name="RefreshAuto" GroupName="CompactRefresh" Style="{StaticResource TcSegment}" Content="Auto" Click="RefreshAuto_Click" Margin="0,0,4,0" />
                        <RadioButton x:Name="Refresh60" Grid.Column="1" GroupName="CompactRefresh" Style="{StaticResource TcSegment}" Content="60 Hz" Click="Refresh60_Click" Margin="2,0" />
                        <RadioButton x:Name="RefreshMax" Grid.Column="2" GroupName="CompactRefresh" Style="{StaticResource TcSegment}" Content="Max" Click="RefreshMax_Click" Margin="4,0,0,0" />
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource Tc.Border}" />
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Brightness" FontSize="10.5" VerticalAlignment="Center" Foreground="{DynamicResource Tc.TextMuted}" />
                        <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource TcSlider}" Value="{Binding Brightness}" IsEnabled="{Binding BrightnessAvailable}" ValueChanged="BrightnessSlider_ValueChanged" />
                        <TextBlock Grid.Column="2" Text="{Binding BrightnessText}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Grid.Row="4" Background="{DynamicResource Tc.Border}" />
                    <Grid Grid.Row="5">
                        <TextBlock Text="Adaptive brightness" FontSize="10.5" VerticalAlignment="Center" Foreground="{DynamicResource Tc.TextMuted}" />
                        <CheckBox x:Name="AdaptiveSwitch" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource TcSwitch}" IsEnabled="{Binding AdaptiveBrightnessAvailable}" Click="AdaptiveSwitch_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Keyboard -->
            <Border Grid.Row="4" Style="{StaticResource TcSection}" Margin="0,0,0,7">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="Keyboard" Width="13" Height="13" Margin="0,0,7,0" Foreground="{DynamicResource Tc.TextMuted}" />
                            <TextBlock Text="Keyboard" FontSize="10.5" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Width="24" Height="20" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Tc.TextMuted}" Content="›" FontSize="19" Click="OpenSection_Click" Tag="Keyboard" ToolTip="Open Keyboard effects" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <RadioButton x:Name="KeyboardOff" GroupName="CompactKeyboard" Style="{StaticResource TcSegment}" Content="Off" Tag="Off" Click="Keyboard_Click" Margin="0,0,3,0" />
                        <RadioButton x:Name="KeyboardLow" Grid.Column="1" GroupName="CompactKeyboard" Style="{StaticResource TcSegment}" Content="Low" Tag="Low" Click="Keyboard_Click" Margin="1,0" />
                        <RadioButton x:Name="KeyboardHigh" Grid.Column="2" GroupName="CompactKeyboard" Style="{StaticResource TcSegment}" Content="High" Tag="High" Click="Keyboard_Click" Margin="1,0" />
                        <RadioButton x:Name="KeyboardAuto" Grid.Column="3" GroupName="CompactKeyboard" Style="{StaticResource TcSegment}" Content="Auto" Tag="Auto" Click="Keyboard_Click" Margin="3,0,0,0" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Quick status links -->
            <Grid Grid.Row="5" Margin="0,0,0,7">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource TcSection}" Padding="10" Margin="0,0,4,0" MouseLeftButtonUp="BatteryCard_Click" Cursor="Hand">
                    <Grid>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Battery" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding BatteryPercentText}" FontSize="15" />
                                <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource Tc.TextFaint}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BatteryPowerText}" FontSize="9.5" Foreground="{DynamicResource Tc.TextMuted}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding BatteryEtaText}" FontSize="9" Foreground="{DynamicResource Tc.TextFaint}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="›" FontSize="19" Foreground="{DynamicResource Tc.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource TcSection}" Padding="10" Margin="4,0,0,0" MouseLeftButtonUp="FanCard_Click" Cursor="Hand">
                    <Grid>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Fan control" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextMuted}" />
                            <TextBlock Text="{Binding FanStateText}" FontSize="10.5" Foreground="{DynamicResource Tc.Accent}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="›" FontSize="19" Foreground="{DynamicResource Tc.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                <Button Style="{StaticResource TcIconButton}" Click="OpenSettings_Click" ToolTip="Settings">
                    <iconPacks:PackIconLucide Kind="Settings" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>
                <Button Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource TcIconButton}" Click="OpenSystem_Click" ToolTip="System status">
                    <iconPacks:PackIconLucide Kind="Laptop" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,8,0">
                    <TextBlock Text="{Binding HardwareAccess}" FontSize="9" Foreground="{DynamicResource Tc.TextFaint}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="v0.1.0-alpha.1" FontSize="8.5" Foreground="{DynamicResource Tc.TextFaint}" />
                </StackPanel>
                <Button Grid.Column="3" x:Name="ExpandButton" Width="38" Height="38" Style="{StaticResource TcButton}" Click="Expand_Click" ToolTip="Open advanced window">
                    <Viewbox Width="14" Height="14">
                        <Path Stroke="{DynamicResource Tc.Text}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,7 L1,1 L7,1 M1,1 L8,8 M15,9 L15,15 L9,15 M15,15 L8,8" />
                    </Viewbox>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
