<Window x:Class="ThinkControl.UI.BootstrapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
        Width="420" Height="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{DynamicResource Tc.Window}"
            BorderBrush="{DynamicResource Tc.BorderStrong}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:BrandMark Width="30" Height="30" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ThinkControl" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Starting" FontSize="10.5" Foreground="{DynamicResource Tc.TextFaint}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0">
                <TextBlock Text="Preparing controls" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Detecting the device and Windows capabilities."
                           Foreground="{DynamicResource Tc.TextMuted}"
                           FontSize="10.5"
                           Margin="0,5,0,0" />
            </StackPanel>

            <Grid Grid.Row="2" Height="3" Margin="0,18,0,0" ClipToBounds="True">
                <Border Background="{DynamicResource Tc.Border}" CornerRadius="1.5" />
                <Border x:Name="ProgressBar"
                        Width="92"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource Tc.Accent}"
                        CornerRadius="1.5">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ProgressTransform" X="-92" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
