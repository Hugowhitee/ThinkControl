<Window x:Class="ThinkControl.UI.AdvancedWindow" xmlns:ui="clr-namespace:ThinkControl.UI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ThinkControl.UI.Controls" xmlns:iconPacks="clr-namespace:ThinkControl.UI.Controls" Title="ThinkControl" Width="1200" Height="780" MinWidth="980" MinHeight="650" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Background="{DynamicResource Tc.Window}" Foreground="{DynamicResource Tc.Text}" FontFamily="{StaticResource Tc.Font}">
  <Border Background="{DynamicResource Tc.Window}" BorderThickness="0" CornerRadius="0">
    <Grid>
      <Grid x:Name="AdvancedBody">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="222" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource Tc.Rail}">
          <Grid x:Name="SidebarGrid">
            <Grid.RowDefinitions>
              <RowDefinition Height="110" />
              <RowDefinition Height="*" />
              <RowDefinition Height="186" />
            </Grid.RowDefinitions>
            <Grid>
              <controls:BrandWordmark Width="182" Height="57" Margin="18,11,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
              <Button x:Name="DeviceLearningIndicator" Visibility="Collapsed" Style="{StaticResource TcInlineButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,64,0,0" Padding="0" MinHeight="18" FontSize="11" />
              <Border Background="{DynamicResource Tc.Divider}" Height="1" VerticalAlignment="Top" Margin="20,86,20,0" />
            </Grid>
            <controls:AdvancedScrollViewer x:Name="SidebarNavigationScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <RadioButton x:Name="NavHome" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Home" Checked="Nav_Checked">
                  <StackPanel Orientation="Horizontal">
                    <controls:PackIconLucide Kind="House" Width="20" Height="20" Margin="0,0,14,0" />
                    <TextBlock Text="Overview" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavPerformance" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Performance" Checked="Nav_Checked">
                  <StackPanel Orientation="Horizontal">
                    <controls:PackIconLucide Kind="Gauge" Width="20" Height="20" Margin="0,0,14,0" />
                    <TextBlock Text="Power &amp; cooling" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavBattery" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Battery" Checked="Nav_Checked">
                  <StackPanel Orientation="Horizontal">
                    <controls:PackIconLucide Kind="Battery" Width="20" Height="20" Margin="0,0,14,0" />
                    <TextBlock Text="Battery" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavDisplay" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Display" Checked="Nav_Checked">
                  <StackPanel Orientation="Horizontal">
                    <controls:PackIconLucide Kind="Monitor" Width="20" Height="20" Margin="0,0,14,0" />
                    <TextBlock Text="Display &amp; input" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavAudio" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Audio" Checked="Nav_Checked">
                  <StackPanel Orientation="Horizontal">
                    <controls:PackIconLucide Kind="Audio" Width="20" Height="20" Margin="0,0,14,0" />
                    <TextBlock Text="Audio" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavModes" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Modes" Checked="Nav_Checked">
                  <StackPanel Orientation="Horizontal">
                    <controls:PackIconLucide Kind="Tune" Width="20" Height="20" Margin="0,0,14,0" />
                    <TextBlock Text="Modes" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSystem" GroupName="Nav" Style="{StaticResource TcNav}" Tag="System" Checked="Nav_Checked">
                  <StackPanel Orientation="Horizontal">
                    <controls:PackIconLucide Kind="Laptop" Width="20" Height="20" Margin="0,0,14,0" />
                    <TextBlock Text="System" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavFans" Visibility="Collapsed" />
                <RadioButton x:Name="NavKeyboard" Visibility="Collapsed" />
                <RadioButton x:Name="NavTouchpad" Visibility="Collapsed" />
                <RadioButton x:Name="NavAutomation" Visibility="Collapsed" />
                <RadioButton x:Name="NavUpdates" Visibility="Collapsed" />
                <RadioButton x:Name="NavSettings" Visibility="Collapsed" />
              </StackPanel>
            </controls:AdvancedScrollViewer>
            <Border x:Name="SidebarScrollFade" Grid.Row="1" Height="28" VerticalAlignment="Bottom" Background="{DynamicResource Tc.Rail}" IsHitTestVisible="False">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasContentBelow, ElementName=SidebarNavigationScroll}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#FF000000" Offset="1" />
                </LinearGradientBrush>
              </Border.OpacityMask>
            </Border>
            <StackPanel Grid.Row="2" Margin="20,0,14,12">
              <Border Background="{DynamicResource Tc.Divider}" Height="1" Margin="0,0,0,8" />
              <Button Style="{StaticResource TcSidebarAction}" Click="SidebarCompact_Click" ToolTip="Switch to Compact view">
                <StackPanel Orientation="Horizontal">
                  <controls:PackIconLucide Kind="CompactView" Width="20" Height="20" Margin="0,0,14,0" />
                  <TextBlock Text="Compact view" Foreground="{DynamicResource Tc.TextMuted}" />
                </StackPanel>
              </Button>
              <Button x:Name="SidebarNotificationsButton" Style="{StaticResource TcSidebarAction}" Click="SidebarNotifications_Click">
                <StackPanel Orientation="Horizontal">
                  <Grid Width="20" Height="20" Margin="0,0,14,0">
                    <controls:PackIconLucide Kind="Notifications" Width="20" Height="20" />
                    <Ellipse x:Name="SidebarNotificationDot" Width="6" Height="6" Fill="{DynamicResource Tc.Accent}" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" />
                  </Grid>
                  <TextBlock Text="Notifications" Foreground="{DynamicResource Tc.TextMuted}" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource TcSidebarAction}" Tag="Settings" Click="HomeOpenPage_Click">
                <StackPanel Orientation="Horizontal">
                  <controls:PackIconLucide Kind="Settings" Width="20" Height="20" Margin="0,0,14,0" />
                  <TextBlock Text="Preferences" Foreground="{DynamicResource Tc.TextMuted}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="{StaticResource Tc.PageInset}">
          <controls:AdvancedScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <controls:AdvancedPageHeader Title="Overview" Subtitle="Status and the controls you use most" />
              <TextBlock Text="LIVE STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextFaint}" Margin="0,0,0,12" />
              <Grid MinHeight="80">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.63*" />
                  <ColumnDefinition Width="1.1*" />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource TcSection}" Padding="14" Margin="0,0,24,0" Cursor="Hand" MouseLeftButtonUp="HomeBattery_Click">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="86" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <controls:BatteryGauge Width="78" Height="31" Percent="{Binding BatteryPercent}" IsCharging="{Binding BatteryCharging}" IsDischarging="{Binding BatteryDischarging}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding BatteryPercentText}" Style="{StaticResource TcText.ValueLarge}" />
                      <TextBlock Text="{Binding BatteryEtaText}" Style="{StaticResource TcText.Caption}" Foreground="{DynamicResource Tc.TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                  </Grid>
                </Border>
                <controls:TelemetryMetric Grid.Column="1" Label="CPU" Value="{Binding CpuTemperatureText}" Caption="CPU package" />
                <controls:TelemetryMetric Grid.Column="2" Label="FANS" Value="{Binding FanRpmText}" Caption="{Binding CoolingProfileDisplay}" />
                <controls:TelemetryMetric Grid.Column="3" Label="POWER" Value="{Binding BatteryPowerText}" Caption="Live draw" />
              </Grid>
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource TcSection}" MinHeight="164">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                      <controls:PackIconLucide Kind="Gauge" Width="20" Height="20" Foreground="{DynamicResource Tc.TextMuted}" />
                      <TextBlock Text="Power profile" FontSize="{x:Static ui:TypographyScale.SectionTitle}" FontWeight="SemiBold" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="HomePowerSourceText" Text="Current power source" Style="{StaticResource TcText.Secondary}" />
                    <Grid Margin="0,12,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <RadioButton x:Name="HomeQuiet" Grid.Column="0" GroupName="HomePower" Style="{StaticResource TcSegment}" Content="Efficiency" Tag="Current:Quiet" Click="HomePowerMode_Click" Margin="0,0,4,0" FontSize="13" Padding="4,7" />
                      <RadioButton x:Name="HomeBalanced" Grid.Column="1" GroupName="HomePower" Style="{StaticResource TcSegment}" Content="Balanced" Tag="Current:Balanced" Click="HomePowerMode_Click" Margin="4,0,4,0" FontSize="13" Padding="4,7" />
                      <RadioButton x:Name="HomePerformance" Grid.Column="2" GroupName="HomePower" Style="{StaticResource TcSegment}" Content="Performance" Tag="Current:Performance" Click="HomePowerMode_Click" Margin="4,0,4,0" FontSize="13" Padding="4,7" />
                    </Grid>
                    <TextBlock x:Name="HomePowerOtherText" Text="Separate battery and plugged-in preferences" Style="{StaticResource TcText.Caption}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource TcSection}" MinHeight="164">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                      <controls:PackIconLucide Kind="Fan" Width="20" Height="20" Foreground="{DynamicResource Tc.TextMuted}" />
                      <TextBlock Text="Cooling" FontSize="{x:Static ui:TypographyScale.SectionTitle}" FontWeight="SemiBold" Margin="10,0,0,0" />
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource Tc.Divider}" Margin="0,-2,0,14" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="CONTROLLER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextFaint}" />
                        <TextBlock Text="{Binding CoolingProfileDisplay}" Style="{StaticResource TcText.SectionTitle}" Margin="0,8,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="DIRECT CURVES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextFaint}" />
                        <TextBlock x:Name="HomeCurveAvailabilityText" Text="Checking…" Style="{StaticResource TcText.Secondary}" Margin="0,8,0,0" />
                      </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Tc.Divider}" Margin="0,8,0,8" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="142" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding CoolingAvailabilityText}" Style="{StaticResource TcText.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CoolingAvailabilityText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <Button Grid.Column="1" Content="Fan settings" Style="{StaticResource TcButton}" Click="HomeOpenPage_Click" Tag="Fans" />
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource TcSection}" MinHeight="151">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                      <controls:PackIconLucide Kind="Monitor" Width="20" Height="20" Foreground="{DynamicResource Tc.TextMuted}" />
                      <TextBlock Text="Display" FontSize="{x:Static ui:TypographyScale.SectionTitle}" FontWeight="SemiBold" Margin="10,0,0,0" />
                    </StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Refresh rate" Style="{StaticResource TcText.Secondary}" VerticalAlignment="Center" />
                      <RadioButton x:Name="HomeRefreshAuto" Grid.Column="1" GroupName="HomeRefresh" Style="{StaticResource TcSegment}" Content="Auto" Click="RefreshAuto_Click" Margin="4,0,4,0" FontSize="13" Padding="4,7" />
                      <RadioButton x:Name="HomeRefresh60" Grid.Column="2" GroupName="HomeRefresh" Style="{StaticResource TcSegment}" Content="60 Hz" Click="Refresh60_Click" Margin="4,0,4,0" FontSize="13" Padding="4,7" />
                      <RadioButton x:Name="HomeRefreshMax" Grid.Column="3" GroupName="HomeRefresh" Style="{StaticResource TcSegment}" Content="Max" Click="RefreshMax_Click" Margin="4,0,4,0" FontSize="13" Padding="4,7" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Brightness" Style="{StaticResource TcText.Secondary}" VerticalAlignment="Center" />
                      <Slider x:Name="HomeBrightnessSlider" Grid.Column="1" Style="{StaticResource TcSlider}" Value="{Binding Brightness}" IsEnabled="{Binding BrightnessAvailable}" ValueChanged="BrightnessSlider_ValueChanged" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource TcSection}" MinHeight="151">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                      <controls:PackIconLucide Kind="Audio" Width="20" Height="20" Foreground="{DynamicResource Tc.TextMuted}" />
                      <TextBlock Text="Audio" FontSize="{x:Static ui:TypographyScale.SectionTitle}" FontWeight="SemiBold" Margin="10,0,0,0" />
                    </StackPanel>
                    <controls:AudioPanel x:Name="HomeAudioControl" OverviewOnly="True" />
                  </StackPanel>
                </Border>
              </Grid>
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource TcSection}">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:PackIconLucide Kind="Tune" Width="20" Height="20" Foreground="{DynamicResource Tc.TextMuted}" Margin="0,0,10,0" />
                        <TextBlock x:Name="HomeModeTitle" Text="Mode" Style="{StaticResource TcText.SectionTitle}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Automation" Style="{StaticResource TcText.Caption}" VerticalAlignment="Center" Margin="8,0,8,0" />
                        <CheckBox x:Name="HomeAutomationSwitch" Style="{StaticResource TcSwitch}" MinHeight="40" AutomationProperties.Name="Enable automation triggers" Click="HomeAutomationSwitch_Click" />
                      </StackPanel>
                    </Grid>
                    <TextBlock x:Name="HomeModeModifiedText" TextWrapping="Wrap" Style="{StaticResource TcText.Caption}" Visibility="Collapsed" Margin="0,4,0,10" />
                    <Grid Margin="0,8,0,0">
                      <ComboBox x:Name="HomeModeCombo" Style="{StaticResource TcComboBox}" DisplayMemberPath="Name" SelectionChanged="HomeMode_SelectionChanged" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource TcSection}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                      <controls:PackIconLucide Kind="Keyboard" Width="20" Height="20" Foreground="{DynamicResource Tc.TextMuted}" />
                      <TextBlock Text="Keyboard light" Style="{StaticResource TcText.SectionTitle}" Margin="10,0,0,0" />
                    </StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <RadioButton x:Name="HomeKeyboardOff" GroupName="HomeKeyboard" Style="{StaticResource TcSegment}" Content="Off" Tag="Off" Click="Keyboard_Click" Margin="0,0,4,0" FontSize="13" Padding="4,7" />
                      <RadioButton x:Name="HomeKeyboardLow" Grid.Column="1" GroupName="HomeKeyboard" Style="{StaticResource TcSegment}" Content="Low" Tag="Low" Click="Keyboard_Click" Margin="4,0" FontSize="13" Padding="4,7" />
                      <RadioButton x:Name="HomeKeyboardHigh" Grid.Column="2" GroupName="HomeKeyboard" Style="{StaticResource TcSegment}" Content="High" Tag="High" Click="Keyboard_Click" Margin="4,0" FontSize="13" Padding="4,7" />
                      <RadioButton x:Name="HomeKeyboardAuto" Grid.Column="3" GroupName="HomeKeyboard" Style="{StaticResource TcSegment}" Content="Auto" Tag="Auto" Click="Keyboard_Click" Margin="4,0,0,0" FontSize="13" Padding="4,7" />
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </controls:AdvancedScrollViewer>
          <controls:AdvancedScrollViewer x:Name="PageModes" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <controls:ModesPanel x:Name="ModesPanelControl" Margin="0" />
          </controls:AdvancedScrollViewer>
          <controls:AdvancedScrollViewer x:Name="PageAutomation" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <controls:ModesPanel x:Name="AutomationPanelControl" Margin="0" />
          </controls:AdvancedScrollViewer>
          <controls:AdvancedScrollViewer x:Name="PagePerformance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <controls:PerformancePanel x:Name="PerformancePanelControl" Margin="0" />
              <controls:FansPanel x:Name="FansPanelControl" Embedded="True" />
            </StackPanel>
          </controls:AdvancedScrollViewer>
          <controls:AdvancedScrollViewer x:Name="PageBattery" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <controls:AdvancedPageHeader Title="Battery" Subtitle="Power, health, history and preservation." />
              <controls:BatteryTelemetryPanel x:Name="BatteryTelemetryPanelControl" />
            </StackPanel>
          </controls:AdvancedScrollViewer>
          <controls:AdvancedScrollViewer x:Name="PageDisplay" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <controls:AdvancedPageHeader Title="Display &amp; input" Subtitle="Display, keyboard and touchpad preferences" />
              <controls:ContextTabs Section="DisplayInput" SelectedPage="Display" />
              <Border Style="{StaticResource TcSection}">
                <StackPanel>
                  <TextBlock Text="Refresh rate" Style="{StaticResource TcText.SectionTitle}" />
                  <TextBlock Text="Auto uses 60 Hz on battery when supported and the panel maximum when plugged in." Style="{StaticResource TcText.Caption}" TextWrapping="Wrap" Margin="0,7,0,0" />
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="DisplayRefreshAuto" GroupName="DisplayRefresh" Style="{StaticResource TcSegment}" Content="Auto" Click="RefreshAuto_Click" Margin="0,0,6,0" />
                    <RadioButton x:Name="DisplayRefresh60" Grid.Column="1" GroupName="DisplayRefresh" Style="{StaticResource TcSegment}" Content="60 Hz" Click="Refresh60_Click" Margin="3,0" />
                    <RadioButton x:Name="DisplayRefreshMax" Grid.Column="2" GroupName="DisplayRefresh" Style="{StaticResource TcSegment}" Content="Max" Click="RefreshMax_Click" Margin="6,0,0,0" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource TcSection}" Margin="0,16,0,0">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="Brightness" Style="{StaticResource TcText.SectionTitle}" />
                    <TextBlock Text="{Binding BrightnessText}" Style="{StaticResource TcText.Secondary}" HorizontalAlignment="Right" />
                  </Grid>
                  <Slider x:Name="DisplayBrightnessSlider" Style="{StaticResource TcSlider}" Value="{Binding Brightness}" IsEnabled="{Binding BrightnessAvailable}" ValueChanged="BrightnessSlider_ValueChanged" Margin="0,13,0,0" />
                  <Border Height="1" Background="{DynamicResource Tc.Border}" Margin="0,15" />
                  <Grid>
                    <StackPanel>
                      <TextBlock Text="Adaptive brightness" FontWeight="SemiBold" />
                      <TextBlock Text="Let Windows use the ambient-light sensor when this display exposes the setting." Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,4,70,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox x:Name="DisplayAdaptiveSwitch" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource TcSwitch}" IsEnabled="{Binding AdaptiveBrightnessAvailable}" Click="AdaptiveSwitch_Click" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource TcSection}" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="Display preferences" Style="{StaticResource TcText.SectionTitle}" />
                  <TextBlock Text="Manage resolution, scaling and connected displays in Windows Settings." Style="{StaticResource TcText.Caption}" TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </controls:AdvancedScrollViewer>
          <controls:AdvancedScrollViewer x:Name="PageAudio" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <controls:AudioPanel x:Name="AudioPanelControl" Margin="0" />
          </controls:AdvancedScrollViewer>
          <controls:AdvancedScrollViewer x:Name="PageKeyboard" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <controls:AdvancedPageHeader Title="Display &amp; input" Subtitle="Display, keyboard and touchpad preferences" />
              <controls:ContextTabs Section="DisplayInput" SelectedPage="Keyboard" />
              <Border Style="{StaticResource TcSection}">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="Backlight level" Style="{StaticResource TcText.SectionTitle}" />
                    <TextBlock Text="{Binding KeyboardStatus}" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextMuted}" />
                  </Grid>
                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition />
                      <ColumnDefinition />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="AdvancedKeyboardOff" GroupName="KeyboardMode" Style="{StaticResource TcSegment}" Content="Off" Tag="Off" Click="Keyboard_Click" Margin="0,0,5,0" />
                    <RadioButton x:Name="AdvancedKeyboardLow" Grid.Column="1" GroupName="KeyboardMode" Style="{StaticResource TcSegment}" Content="Low" Tag="Low" Click="Keyboard_Click" Margin="2,0" />
                    <RadioButton x:Name="AdvancedKeyboardHigh" Grid.Column="2" GroupName="KeyboardMode" Style="{StaticResource TcSegment}" Content="High" Tag="High" Click="Keyboard_Click" Margin="2,0" />
                    <RadioButton x:Name="AdvancedKeyboardAuto" Grid.Column="3" GroupName="KeyboardMode" Style="{StaticResource TcSegment}" Content="Auto" Tag="Auto" Click="Keyboard_Click" Margin="5,0,0,0" />
                  </Grid>
                  <TextBlock Text="Choose a backlight level or let your laptop manage it with Auto." Style="{StaticResource TcText.Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
                  <TextBlock Text="Auto: controlled by firmware" Style="{StaticResource TcText.Caption}" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
              <controls:KeyboardEffectsPanel x:Name="KeyboardEffectsPanelControl" Margin="0,16,0,0" />
            </StackPanel>
          </controls:AdvancedScrollViewer>
          <controls:AdvancedScrollViewer x:Name="PageTouchpad" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <controls:TouchpadPanel x:Name="TouchpadPanelControl" Margin="0" />
          </controls:AdvancedScrollViewer>
          <controls:AdvancedScrollViewer x:Name="PageSystem" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <controls:AdvancedPageHeader Title="System" Subtitle="Hardware details, update status, preferences and recovery" />
              <controls:ContextTabs Section="System" SelectedPage="System" />
              <Border Style="{StaticResource TcSection}" MinHeight="162">
                <StackPanel>
                  <TextBlock Text="Device &amp; support" Style="{StaticResource TcText.SectionTitle}" Margin="0,0,0,18" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="112" />
                      <ColumnDefinition Width="220" />
                      <ColumnDefinition Width="112" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition />
                      <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Device" Style="{StaticResource TcText.Caption}" />
                    <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" Text="Processor" Style="{StaticResource TcText.Caption}" />
                    <TextBlock Grid.Column="3" Text="{Binding CpuName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="Memory" Style="{StaticResource TcText.Caption}" Margin="0,18,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RamText}" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Hardware" Style="{StaticResource TcText.Caption}" Margin="0,18,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding HardwareAccessSummary}" TextWrapping="Wrap" Margin="0,18,0,0" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource TcSection}" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="General preferences" Style="{StaticResource TcText.SectionTitle}" Margin="0,0,0,16" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="160" />
                      <ColumnDefinition Width="416" MaxWidth="416" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Theme" VerticalAlignment="Center" Style="{StaticResource TcText.Secondary}" />
                    <Grid Grid.Column="1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource TcSegment}" Content="System" Tag="System" Click="Theme_Click" Margin="0,0,4,0" />
                      <RadioButton x:Name="ThemeDark" Grid.Column="1" GroupName="Theme" Style="{StaticResource TcSegment}" Content="Dark" Tag="Dark" Click="Theme_Click" Margin="4,0" />
                      <RadioButton x:Name="ThemeLight" Grid.Column="2" GroupName="Theme" Style="{StaticResource TcSegment}" Content="Light" Tag="Light" Click="Theme_Click" Margin="4,0,0,0" />
                    </Grid>
                  </Grid>
                  <Grid Margin="0,16,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="416" MaxWidth="416" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="App icon opens" Style="{StaticResource TcText.Secondary}" />
                        <TextBlock Text="The tray icon always opens Compact." Style="{StaticResource TcText.Caption}" TextWrapping="Wrap" Margin="0,4,12,0" />
                      </StackPanel>
                      <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="SettingsOpeningCompact" GroupName="DefaultOpeningView" Content="Compact" Tag="Compact" Click="OpeningView_Click" Style="{StaticResource TcSegment}" Margin="0,0,4,0" />
                        <RadioButton x:Name="SettingsOpeningAdvanced" Grid.Column="1" GroupName="DefaultOpeningView" Content="Advanced" Tag="Advanced" Click="OpeningView_Click" Style="{StaticResource TcSegment}" Margin="4,0,0,0" />
                      </Grid>
                    </Grid>
                  <Grid Margin="0,32,0,0" MaxWidth="576" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}">
                    <TextBlock Text="Start with Windows" VerticalAlignment="Center" />
                    <CheckBox x:Name="StartupSwitch" Style="{StaticResource TcSwitch}" Click="StartupSwitch_Click" HorizontalAlignment="Right" />
                  </Grid>
                  <Border Height="1" Background="{DynamicResource Tc.Divider}" Margin="0,14,0,8" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="190" />
                      <ColumnDefinition />
                      <ColumnDefinition Width="144" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Compact layout" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Choose tiles and status metrics" Style="{StaticResource TcText.Secondary}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="Customize" Style="{StaticResource TcButton}" Click="CompactCustomize_Click" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource TcSection}" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="Windows and device actions" Style="{StaticResource TcText.SectionTitle}" Margin="0,0,0,25" />
                  <UniformGrid Columns="4">
                    <Button Content="Display settings ↗" Style="{StaticResource TcButton}" Tag="ms-settings:display" Click="OpenUrl_Click" Margin="0,0,12,0" />
                    <Button Content="Power &amp; battery ↗" Style="{StaticResource TcButton}" Tag="ms-settings:powersleep" Click="OpenUrl_Click" Margin="0,0,12,0" />
                    <Button Content="Optional updates ↗" Style="{StaticResource TcButton}" Tag="ms-settings:windowsupdate-optionalupdates" Click="OpenUrl_Click" Margin="0,0,12,0" />
                    <Button Content="Hardware details" Style="{StaticResource TcButton}" Click="HardwareDetails_Click" />
                  </UniformGrid>
                </StackPanel>
              </Border>

              <Expander Header="More preferences" Style="{StaticResource TcQuietExpander}" Margin="0,16,0,0">
                <StackPanel Margin="0,10,0,0">

                  <Border Style="{StaticResource TcSettingsRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="132" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Battery history detail" FontWeight="SemiBold" />
                        <TextBlock Text="Older samples become daily summaries; health trends remain." Style="{StaticResource TcText.Caption}" />
                      </StackPanel>
                      <ComboBox x:Name="SettingsBatteryRetention" Grid.Column="1" Style="{StaticResource TcComboBox}" SelectionChanged="BatteryRetention_SelectionChanged">
                        <ComboBoxItem Content="7 days" />
                        <ComboBoxItem Content="14 days" />
                        <ComboBoxItem Content="30 days" />
                      </ComboBox>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource TcSection}">
                    <StackPanel>
                      <TextBlock x:Name="SystemVendorCardTitle" Text="Device &amp; drivers" FontWeight="SemiBold" />
                      <TextBlock x:Name="SystemVendorCardDetail" Style="{StaticResource TcText.Caption}" TextWrapping="Wrap" Margin="0,6,0,12" />
                      <WrapPanel x:Name="SystemVendorButtons">
                        <Button x:Name="SystemVendorPrimaryButton" Visibility="Collapsed" Style="{StaticResource TcButton}" Click="OpenUrl_Click" Margin="0,0,8,0" />
                        <Button Content="Lid &amp; power buttons ↗" Style="{StaticResource TcButton}" Click="PowerOptions_Click" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Expander>
              <Expander x:Name="SystemHardwareDetails" Header="Hardware details" Style="{StaticResource TcQuietExpander}" Margin="2,14,2,0" HorizontalAlignment="Right" MaxWidth="560">
                <Border Style="{StaticResource TcSection}" Margin="0,8,0,0">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="Cooling" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,0,12,12" />
                      <TextBlock Grid.Column="1" Text="{Binding CoolingAvailabilityText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                      <TextBlock Grid.Row="1" Text="Fan reading" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,0,12,12" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FanRpmSource}" TextWrapping="Wrap" Margin="0,0,0,12" />
                      <TextBlock Grid.Row="2" Text="Temperature" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,0,12,12" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ControlTemperatureSource}" TextWrapping="Wrap" Margin="0,0,0,12" />
                      <TextBlock Grid.Row="3" Text="Keyboard" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,0,12,0" />
                      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding KeyboardBackend}" TextWrapping="Wrap" />
                    </Grid>
                    <Expander Header="Provider diagnostics" Style="{StaticResource TcQuietExpander}" Margin="0,14,0,0">
                      <TextBlock Text="{Binding HardwareEvidenceText}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="{x:Static ui:TypographyScale.Caption}" />
                    </Expander>
                  </StackPanel>
                </Border>
              </Expander>
            </StackPanel>
          </controls:AdvancedScrollViewer>
          <controls:AdvancedScrollViewer x:Name="PageUpdates" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <controls:AdvancedPageHeader Title="System" Subtitle="Hardware details, update status, preferences and recovery">
                <controls:AdvancedPageHeader.Actions>
                  <Button Content="Windows Update" Tag="ms-settings:windowsupdate" Style="{StaticResource TcPageHeaderExternalAction}" Click="OpenUrl_Click" />
                </controls:AdvancedPageHeader.Actions>
              </controls:AdvancedPageHeader>
              <controls:ContextTabs Section="System" SelectedPage="Updates" />
              <Border Style="{StaticResource TcSection}" MinHeight="232">
                <StackPanel>
                  <TextBlock Text="ThinkControl updates" Style="{StaticResource TcText.SectionTitle}" Margin="0,0,0,20" />
                  <TextBlock Text="Current version" Style="{StaticResource TcText.Caption}" />
                  <Grid Margin="0,10,0,22">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding AppVersion}" Style="{StaticResource TcText.ValueLarge}" />
                    <Border x:Name="UpdateUpToDateBadge" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Up to date" AutomationProperties.Name="Up to date" Visibility="Collapsed">
                      <Grid Width="22" Height="22">
                        <Ellipse Stroke="{DynamicResource Tc.Success}" StrokeThickness="1.5" />
                        <controls:PackIconLucide Kind="Check" Width="14" Height="14" Foreground="{DynamicResource Tc.Success}" />
                      </Grid>
                    </Border>
                  </Grid>
                  <TextBlock Text="Alpha channel" Style="{StaticResource TcText.Secondary}" />
                  <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource TcText.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                  <TextBlock x:Name="UpdateLastCheckedText" Style="{StaticResource TcText.Caption}" Margin="0,8,0,0" />
                  <ProgressBar x:Name="UpdateCheckProgress" Height="2" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0" />
                  <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="UpdateCheckButton" Content="Check for updates" Style="{StaticResource TcButton}" Click="CheckUpdatesAndPrepare_Click" MinWidth="208" Margin="0,0,16,0" />
                    <Button Content="Open GitHub releases ↗" Style="{StaticResource TcButton}" Click="OpenUrl_Click" Tag="https://github.com/Hugowhitee/ThinkControl/releases" MinWidth="208" />
                    <Button x:Name="OpenReleaseButton" Content="Install update" Style="{StaticResource TcPrimaryButton}" IsEnabled="False" Click="InstallUpdate_Click" Margin="16,0,0,0" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource TcSection}" Margin="0,16,0,0" MinHeight="148">
                <StackPanel>
                  <TextBlock Text="Install and restart behavior" Style="{StaticResource TcText.SectionTitle}" />
                  <TextBlock Text="Verified package hashes" FontWeight="SemiBold" Margin="0,22,0,0" />
                  <TextBlock Text="Install now or later from the update notification. Settings are preserved; Windows may ask for confirmation." Style="{StaticResource TcText.Secondary}" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource TcSection}" Margin="0,16,0,0">
                <Grid>
                  <StackPanel Margin="0,0,80,0">
                    <TextBlock Text="Automatic update checks" FontWeight="SemiBold" />
                    <TextBlock Text="Checks periodically. Installation stays manual." Style="{StaticResource TcText.Secondary}" Margin="0,6,0,0" />
                  </StackPanel>
                  <CheckBox x:Name="AutomaticUpdatesSwitch" Style="{StaticResource TcSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AutomaticUpdates_Click" />
                </Grid>
              </Border>
              <Border Style="{StaticResource TcSection}" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="What is new" Style="{StaticResource TcText.SectionTitle}" />
                  <TextBlock Text="Release notes open from the confirmed update or GitHub release." Style="{StaticResource TcText.Secondary}" Margin="0,20,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </controls:AdvancedScrollViewer>
          <controls:AdvancedScrollViewer x:Name="PageDiagnostics" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <controls:AdvancedPageHeader Title="System" Subtitle="Hardware details, update status, preferences and recovery" />
              <controls:ContextTabs Section="System" SelectedPage="Diagnostics" />
              <Border Style="{StaticResource TcSection}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Hardware and sensors" Style="{StaticResource TcText.SectionTitle}" />
                    <TextBlock Text="Review telemetry and available repairs" Style="{StaticResource TcText.Secondary}" Margin="0,6,0,0" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="View sensors" Style="{StaticResource TcButton}" Click="OpenSensors_Click" Margin="12,0,0,0" />
                  <Button Grid.Column="2" Content="Hardware setup" Style="{StaticResource TcButton}" Click="OpenHardwareSetup_Click" Margin="12,0,0,0" />
                </Grid>
              </Border>
              <StackPanel x:Name="SettingsAdvancedBody">
                <controls:DiagnosticsPanel x:Name="DiagnosticsPanelControl" Margin="0" />
                <Border Style="{StaticResource TcSettingsRow}">
                  <Grid>
                    <TextBlock Text="Source &amp; releases" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="GitHub ↗" Style="{StaticResource TcButton}" HorizontalAlignment="Right" Tag="https://github.com/Hugowhitee/ThinkControl" Click="OpenUrl_Click" />
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>
          </controls:AdvancedScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
