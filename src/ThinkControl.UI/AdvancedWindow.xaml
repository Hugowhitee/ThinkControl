<Window x:Class="ThinkControl.UI.AdvancedWindow"
        xmlns:ui="clr-namespace:ThinkControl.UI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
        xmlns:iconPacks="clr-namespace:ThinkControl.UI.Controls"
        Title="ThinkControl"
        Width="1160" Height="760"
        MinWidth="780" MinHeight="620"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{DynamicResource Tc.Window}"
        Foreground="{DynamicResource Tc.Text}"
        FontFamily="Segoe UI">

    <Border Background="{DynamicResource Tc.Window}"
            BorderThickness="0"
            CornerRadius="0">
        <Grid>
            <Grid x:Name="AdvancedBody">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{DynamicResource Tc.Border}" BorderThickness="0,1,1,0" Background="{DynamicResource Tc.Surface}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="48" /></Grid.RowDefinitions>
                        <StackPanel Margin="0,10,0,0">
                            <RadioButton x:Name="NavHome" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Home" Checked="Nav_Checked" IsChecked="True">
                                <StackPanel Orientation="Horizontal"><iconPacks:PackIconLucide Kind="House" Width="15" Height="15" Margin="0,0,12,0" /><TextBlock Text="Home" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavPerformance" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Performance" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><iconPacks:PackIconLucide Kind="Gauge" Width="15" Height="15" Margin="0,0,12,0" /><TextBlock Text="Performance" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavFans" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Fans" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><iconPacks:PackIconLucide Kind="Fan" Width="15" Height="15" Margin="0,0,12,0" /><TextBlock Text="Fans" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavBattery" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Battery" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><iconPacks:PackIconLucide Kind="Battery" Width="15" Height="15" Margin="0,0,12,0" /><TextBlock Text="Battery" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDisplay" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Display" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><iconPacks:PackIconLucide Kind="Monitor" Width="15" Height="15" Margin="0,0,12,0" /><TextBlock Text="Display" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAudio" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Audio" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><iconPacks:PackIconLucide Kind="Audio" Width="15" Height="15" Margin="0,0,12,0" /><TextBlock Text="Audio" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavKeyboard" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Keyboard" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><iconPacks:PackIconLucide Kind="Keyboard" Width="15" Height="15" Margin="0,0,12,0" /><TextBlock Text="Keyboard" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavTouchpad" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Touchpad" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><iconPacks:PackIconLucide Kind="Touchpad" Width="15" Height="15" Margin="0,0,12,0" /><TextBlock Text="Touchpad" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSystem" GroupName="Nav" Style="{StaticResource TcNav}" Tag="System" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><iconPacks:PackIconLucide Kind="Laptop" Width="15" Height="15" Margin="0,0,12,0" /><TextBlock Text="System" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavUpdates" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Updates" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><iconPacks:PackIconLucide Kind="RefreshCw" Width="15" Height="15" Margin="0,0,12,0" /><TextBlock Text="Updates" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource TcNav}" Tag="Settings" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><iconPacks:PackIconLucide Kind="Settings" Width="15" Height="15" Margin="0,0,12,0" /><TextBlock Text="Settings" /></StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="16,0,12,10" VerticalAlignment="Bottom">
                            <TextBlock Text="ThinkControl" FontSize="{x:Static ui:TypographyScale.Caption}" Foreground="{DynamicResource Tc.TextMuted}" />
                            <TextBlock Text="{Binding AppVersion}" FontSize="{x:Static ui:TypographyScale.Caption}" Foreground="{DynamicResource Tc.TextFaint}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="14">
                    <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource TcSection}" Padding="16,13" Height="124">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="1" /><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid Cursor="Hand" MouseLeftButtonUp="HomeBattery_Click"><Grid.ColumnDefinitions><ColumnDefinition Width="122" /><ColumnDefinition /></Grid.ColumnDefinitions><controls:BatteryGauge Width="112" Height="44" VerticalAlignment="Center" HorizontalAlignment="Left" Percent="{Binding BatteryPercent}" IsCharging="{Binding BatteryCharging}" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="BATTERY" FontSize="{x:Static ui:TypographyScale.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextFaint}" /><TextBlock Text="{Binding BatteryPercentText}" FontSize="{x:Static ui:TypographyScale.ValueLarge}" FontWeight="Light" Margin="0,2,0,0" /><TextBlock Text="{Binding BatteryCompactLine}" FontSize="{x:Static ui:TypographyScale.Caption}" Foreground="{DynamicResource Tc.TextMuted}" TextTrimming="CharacterEllipsis" /></StackPanel></Grid>
                                    <Border Grid.Column="1" Background="{DynamicResource Tc.Border}" Margin="14,0" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><controls:PackIconLucide Kind="Cpu" Width="14" Height="14" Foreground="{DynamicResource Tc.TextMuted}" /><TextBlock Text="CPU" FontSize="{x:Static ui:TypographyScale.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextFaint}" Margin="7,0,0,0" /></StackPanel><TextBlock Text="{Binding CpuTemperatureText}" FontSize="{x:Static ui:TypographyScale.ValueLarge}" FontWeight="Light" Margin="0,7,0,0" /><TextBlock Text="Live temperature" FontSize="{x:Static ui:TypographyScale.Caption}" Foreground="{DynamicResource Tc.TextMuted}" /></StackPanel>
                                    <Border Grid.Column="3" Background="{DynamicResource Tc.Border}" Margin="14,0" />
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><controls:PackIconLucide Kind="Fan" Width="14" Height="14" Foreground="{DynamicResource Tc.TextMuted}" /><TextBlock Text="COOLING" FontSize="{x:Static ui:TypographyScale.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Tc.TextFaint}" Margin="7,0,0,0" /></StackPanel><TextBlock Text="{Binding FanRpmText}" FontSize="{x:Static ui:TypographyScale.Value}" FontWeight="Light" Margin="0,8,0,0" /><TextBlock Text="{Binding CoolingProfileDisplay}" FontSize="{x:Static ui:TypographyScale.Caption}" Foreground="{DynamicResource Tc.Accent}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource TcSection}" Margin="0,0,7,7" Height="190">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal"><controls:PackIconLucide Kind="Gauge" Width="15" Height="15" Foreground="{DynamicResource Tc.TextMuted}" /><TextBlock Text="Performance" FontWeight="SemiBold" Margin="8,0,0,0" /></StackPanel>
                                            <TextBlock x:Name="HomePowerSummary" Text="Battery / plugged in" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                                        </Grid>
                                        <TextBlock Text="Separate preferences switch automatically with the power source." Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,5,0,8" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Battery" VerticalAlignment="Center" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                                            <RadioButton x:Name="HomeQuiet" Grid.Column="1" GroupName="HomeBatteryMode" Style="{StaticResource TcSegment}" Content="Efficiency" Tag="Battery:Quiet" Click="HomePowerMode_Click" Margin="0,0,3,0" Padding="2,6"  FontSize="{x:Static ui:TypographyScale.Caption}"/>
                                            <RadioButton x:Name="HomeBalanced" Grid.Column="2" GroupName="HomeBatteryMode" Style="{StaticResource TcSegment}" Content="Balanced" Tag="Battery:Balanced" Click="HomePowerMode_Click" Margin="2,0" Padding="2,6"  FontSize="{x:Static ui:TypographyScale.Caption}"/>
                                            <RadioButton x:Name="HomePerformance" Grid.Column="3" GroupName="HomeBatteryMode" Style="{StaticResource TcSegment}" Content="Performance" Tag="Battery:Performance" Click="HomePowerMode_Click" Margin="3,0,0,0" Padding="2,6"  FontSize="{x:Static ui:TypographyScale.Caption}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Plugged in" VerticalAlignment="Center" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                                            <RadioButton x:Name="HomeAcQuiet" Grid.Column="1" GroupName="HomeAcMode" Style="{StaticResource TcSegment}" Content="Efficiency" Tag="Ac:Quiet" Click="HomePowerMode_Click" Margin="0,0,3,0" Padding="2,6"  FontSize="{x:Static ui:TypographyScale.Caption}"/>
                                            <RadioButton x:Name="HomeAcBalanced" Grid.Column="2" GroupName="HomeAcMode" Style="{StaticResource TcSegment}" Content="Balanced" Tag="Ac:Balanced" Click="HomePowerMode_Click" Margin="2,0" Padding="2,6"  FontSize="{x:Static ui:TypographyScale.Caption}"/>
                                            <RadioButton x:Name="HomeAcPerformance" Grid.Column="3" GroupName="HomeAcMode" Style="{StaticResource TcSegment}" Content="Performance" Tag="Ac:Performance" Click="HomePowerMode_Click" Margin="3,0,0,0" Padding="2,6"  FontSize="{x:Static ui:TypographyScale.Caption}"/>
                                        </Grid>
                                        <Button Content="More performance settings  ›" Style="{StaticResource TcInlineButton}" HorizontalAlignment="Left" Margin="0,9,0,0" Click="HomeOpenPage_Click" Tag="Performance" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource TcSection}" Margin="7,0,0,7" Height="190">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal"><controls:PackIconLucide Kind="Fan" Width="15" Height="15" Foreground="{DynamicResource Tc.TextMuted}" /><TextBlock Text="Fan mode" FontWeight="SemiBold" Margin="8,0,0,0" /></StackPanel>
                                            <TextBlock Text="{Binding ControlTemperatureText}" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" />
                                        </Grid>
                                        <TextBlock Text="Quick cooling presets or an Auto/custom curve." Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,5,0,8" />
                                        <Grid x:Name="HomeFanQuickGrid">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <RadioButton x:Name="HomeFanQuiet" GroupName="HomeFan" Style="{StaticResource TcSegment}" Content="Quiet" Tag="Quiet" Click="HomeFanQuick_Click" Padding="7,6" Margin="0,0,4,0" />
                                            <RadioButton x:Name="HomeFanBalanced" Grid.Column="1" GroupName="HomeFan" Style="{StaticResource TcSegment}" Content="Balanced" Tag="Balanced" Click="HomeFanQuick_Click" Padding="7,6" Margin="2,0" />
                                            <RadioButton x:Name="HomeFanMax" Grid.Column="2" GroupName="HomeFan" Style="{StaticResource TcSegment}" Content="Max" Tag="Max cooling" Click="HomeFanQuick_Click" Padding="7,6" Margin="4,0,0,0" />
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Button x:Name="HomeFanMoreButton" Content="More profiles  ▾" Style="{StaticResource TcButton}" HorizontalAlignment="Stretch" Padding="10,6" Click="HomeFanMore_Click" ToolTip="Show the additional saved fan profiles available on this device" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" ToolTip="Let the firmware or OEM policy take fan ownership">
                                                <TextBlock Text="Auto" Foreground="{DynamicResource Tc.TextMuted}" VerticalAlignment="Center" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,0,9,0" />
                                                <CheckBox x:Name="HomeFanAutoSwitch" VerticalAlignment="Center" Style="{StaticResource TcSwitch}" Click="HomeFanAuto_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource TcSection}" Margin="0,7,7,0" Height="190"><StackPanel><Grid><StackPanel Orientation="Horizontal"><controls:PackIconLucide Kind="Monitor" Width="15" Height="15" Foreground="{DynamicResource Tc.TextMuted}" /><TextBlock Text="Display" FontWeight="SemiBold" Margin="8,0,0,0" /></StackPanel><TextBlock Text="{Binding CurrentRefreshHz, StringFormat={}{0} Hz}" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" /></Grid><Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><RadioButton x:Name="HomeRefreshAuto" GroupName="HomeRefresh" Style="{StaticResource TcSegment}" Content="Auto" Click="RefreshAuto_Click" Margin="0,0,4,0" /><RadioButton x:Name="HomeRefresh60" Grid.Column="1" GroupName="HomeRefresh" Style="{StaticResource TcSegment}" Content="60 Hz" Click="Refresh60_Click" Margin="2,0" /><RadioButton x:Name="HomeRefreshMax" Grid.Column="2" GroupName="HomeRefresh" Style="{StaticResource TcSegment}" Content="Max" Click="RefreshMax_Click" Margin="4,0,0,0" /></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><TextBlock Text="Brightness" Foreground="{DynamicResource Tc.TextMuted}" VerticalAlignment="Center" FontSize="{x:Static ui:TypographyScale.Caption}" /><Slider x:Name="HomeBrightnessSlider" Grid.Column="1" Style="{StaticResource TcSlider}" Value="{Binding Brightness}" IsEnabled="{Binding BrightnessAvailable}" ValueChanged="BrightnessSlider_ValueChanged" /><TextBlock Grid.Column="2" Text="{Binding BrightnessText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="{x:Static ui:TypographyScale.Caption}" /></Grid><Grid Margin="0,7,0,0"><TextBlock Text="Adaptive brightness" Foreground="{DynamicResource Tc.TextMuted}" VerticalAlignment="Center" FontSize="{x:Static ui:TypographyScale.Caption}" /><CheckBox x:Name="HomeAdaptiveSwitch" HorizontalAlignment="Right" Style="{StaticResource TcSwitch}" IsEnabled="{Binding AdaptiveBrightnessAvailable}" Click="AdaptiveSwitch_Click" /></Grid></StackPanel></Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TcSection}" Margin="7,7,0,0" Height="190"><StackPanel><Grid><StackPanel Orientation="Horizontal"><controls:PackIconLucide Kind="Keyboard" Width="15" Height="15" Foreground="{DynamicResource Tc.TextMuted}" /><TextBlock Text="Keyboard light" FontWeight="SemiBold" Margin="8,0,0,0" /></StackPanel><TextBlock Text="{Binding KeyboardStatus}" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" /></Grid><TextBlock Text="Static levels or an idle-aware automatic mode." Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,5,0,10" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><RadioButton x:Name="HomeKeyboardOff" GroupName="HomeKeyboard" Style="{StaticResource TcSegment}" Content="Off" Tag="Off" Click="Keyboard_Click" Margin="0,0,3,0" Padding="5,7" /><RadioButton x:Name="HomeKeyboardLow" Grid.Column="1" GroupName="HomeKeyboard" Style="{StaticResource TcSegment}" Content="Low" Tag="Low" Click="Keyboard_Click" Margin="1,0" Padding="5,7" /><RadioButton x:Name="HomeKeyboardHigh" Grid.Column="2" GroupName="HomeKeyboard" Style="{StaticResource TcSegment}" Content="High" Tag="High" Click="Keyboard_Click" Margin="1,0" Padding="5,7" /><RadioButton x:Name="HomeKeyboardAuto" Grid.Column="3" GroupName="HomeKeyboard" Style="{StaticResource TcSegment}" Content="Auto" Tag="Auto" Click="Keyboard_Click" Margin="3,0,0,0" Padding="5,7" /></Grid><Button Content="Effects &amp; behavior  ›" Style="{StaticResource TcInlineButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="HomeOpenPage_Click" Tag="Keyboard" /></StackPanel></Border>
                            </Grid>

                            <Border Style="{StaticResource TcSection}" Margin="0,14,0,0" Height="112">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                                        <StackPanel Orientation="Horizontal"><controls:PackIconLucide Kind="Audio" Width="15" Height="15" Foreground="{DynamicResource Tc.TextMuted}" /><TextBlock Text="Audio safety" FontWeight="SemiBold" Margin="8,0,0,0" /></StackPanel>
                                        <TextBlock Text="Prevents accidental ThinkControl volume, track and seek actions. Gesture lock blocks only those touchpad actions; keyboard and Windows/app audio still work. Silent also keeps Windows output muted." Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <RadioButton x:Name="HomeAudioSafetyNormal" GroupName="HomeAudioSafetyMode" Style="{StaticResource TcSegment}" Content="Normal" Tag="Normal" Click="HomeAudioSafety_Click" Margin="0,0,4,0" />
                                            <RadioButton x:Name="HomeAudioSafetyMediaLock" Grid.Column="1" GroupName="HomeAudioSafetyMode" Style="{StaticResource TcSegment}" Content="Gesture lock" Tag="MediaLock" Click="HomeAudioSafety_Click" Margin="2,0" />
                                            <RadioButton x:Name="HomeAudioSafetySilent" Grid.Column="2" GroupName="HomeAudioSafetyMode" Style="{StaticResource TcSegment}" Content="Silent" Tag="Silent" Click="HomeAudioSafety_Click" Margin="4,0,0,0" />
                                        </Grid>
                                        <TextBlock x:Name="HomeAudioSafetyStatus" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PagePerformance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <controls:PerformancePanel x:Name="PerformancePanelControl" Margin="0" />
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageFans" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <controls:FansPanel x:Name="FansPanelControl" Margin="0" />
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageBattery" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="900" HorizontalAlignment="Left"><TextBlock Text="Battery" Style="{StaticResource TcText.PageTitle}" /><TextBlock Text="Battery power, energy, health and ETA are read from Windows/ACPI when available. Missing values stay unavailable instead of being invented." Style="{StaticResource TcText.PageSubtitle}" Margin="0,6,0,18" TextWrapping="Wrap" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Border Style="{StaticResource TcSection}" Margin="0,0,7,0"><StackPanel><TextBlock Text="Charge" Foreground="{DynamicResource Tc.TextMuted}" /><TextBlock Text="{Binding BatteryPercentText}" FontSize="{x:Static ui:TypographyScale.ValueHero}" FontWeight="Light" Margin="0,7,0,0" /><TextBlock Text="{Binding BatteryCompactLine}" Margin="0,5,0,0" Foreground="{DynamicResource Tc.TextMuted}" TextWrapping="Wrap" /></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource TcSection}" Margin="7,0,0,0"><StackPanel><TextBlock Text="Battery preservation" FontWeight="SemiBold" /><TextBlock Text="{Binding BatteryProtectionSummaryText}" FontSize="{x:Static ui:TypographyScale.Value}" Foreground="{DynamicResource Tc.Accent}" Margin="0,8,0,0" /><TextBlock Text="{Binding BatteryProtectionBehaviorText}" Foreground="{DynamicResource Tc.TextMuted}" Margin="0,5,0,0" TextWrapping="Wrap" /><Button Content="Manage preservation  ↓" Style="{StaticResource TcInlineButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="BatteryProtectionJump_Click" /></StackPanel></Border></Grid><controls:BatteryTelemetryPanel x:Name="BatteryTelemetryPanelControl" Margin="0,14,0,0" /></StackPanel></ScrollViewer>

                    <ScrollViewer x:Name="PageDisplay" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="Display" Style="{StaticResource TcText.PageTitle}" />
                            <TextBlock Text="Refresh rate, brightness and adaptive brightness are one display segment, with each setting separated clearly instead of scattered across unrelated cards." Foreground="{DynamicResource Tc.TextMuted}" Margin="0,6,0,18" TextWrapping="Wrap" />
                            <Border Style="{StaticResource TcSection}"><StackPanel>
                                <TextBlock Text="Refresh rate" FontWeight="SemiBold" />
                                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><RadioButton x:Name="DisplayRefreshAuto" GroupName="DisplayRefresh" Style="{StaticResource TcSegment}" Content="Auto" Click="RefreshAuto_Click" Margin="0,0,6,0" /><RadioButton x:Name="DisplayRefresh60" Grid.Column="1" GroupName="DisplayRefresh" Style="{StaticResource TcSegment}" Content="60 Hz" Click="Refresh60_Click" Margin="3,0" /><RadioButton x:Name="DisplayRefreshMax" Grid.Column="2" GroupName="DisplayRefresh" Style="{StaticResource TcSegment}" Content="Max" Click="RefreshMax_Click" Margin="6,0,0,0" /></Grid>
                                <TextBlock Text="Auto uses 60 Hz on battery when supported and the panel maximum on AC." Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,8,0,0" />
                                <Border Height="1" Background="{DynamicResource Tc.Border}" Margin="0,15" />
                                <Grid><TextBlock Text="Brightness" FontWeight="SemiBold" /><TextBlock Text="{Binding BrightnessText}" HorizontalAlignment="Right" /></Grid>
                                <Slider x:Name="DisplayBrightnessSlider" Style="{StaticResource TcSlider}" Value="{Binding Brightness}" IsEnabled="{Binding BrightnessAvailable}" ValueChanged="BrightnessSlider_ValueChanged" Margin="0,13,0,0" />
                                <Border Height="1" Background="{DynamicResource Tc.Border}" Margin="0,15" />
                                <Grid><StackPanel><TextBlock Text="Adaptive brightness" FontWeight="SemiBold" /><TextBlock Text="Let Windows use the ambient-light sensor when this display exposes the setting." Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,4,70,0" TextWrapping="Wrap" /></StackPanel><CheckBox x:Name="DisplayAdaptiveSwitch" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource TcSwitch}" IsEnabled="{Binding AdaptiveBrightnessAvailable}" Click="AdaptiveSwitch_Click" /></Grid>
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageAudio" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <controls:AudioPanel x:Name="AudioPanelControl" Margin="0" />
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageKeyboard" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left"><TextBlock Text="Keyboard" Style="{StaticResource TcText.PageTitle}" /><TextBlock Text="Hardware levels and ThinkControl effects are kept separate: Off / Low / High are device states, while Auto / Breathing / Reactive / Audio are user-session policies." Style="{StaticResource TcText.PageSubtitle}" Margin="0,6,0,18" TextWrapping="Wrap" />
                            <Border Style="{StaticResource TcSection}"><StackPanel><Grid><TextBlock Text="Backlight level" FontWeight="SemiBold" /><TextBlock Text="{Binding KeyboardStatus}" HorizontalAlignment="Right" Foreground="{DynamicResource Tc.TextMuted}" /></Grid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><RadioButton x:Name="AdvancedKeyboardOff" GroupName="KeyboardMode" Style="{StaticResource TcSegment}" Content="Off" Tag="Off" Click="Keyboard_Click" Margin="0,0,5,0" /><RadioButton x:Name="AdvancedKeyboardLow" Grid.Column="1" GroupName="KeyboardMode" Style="{StaticResource TcSegment}" Content="Low" Tag="Low" Click="Keyboard_Click" Margin="2,0" /><RadioButton x:Name="AdvancedKeyboardHigh" Grid.Column="2" GroupName="KeyboardMode" Style="{StaticResource TcSegment}" Content="High" Tag="High" Click="Keyboard_Click" Margin="2,0" /><RadioButton x:Name="AdvancedKeyboardAuto" Grid.Column="3" GroupName="KeyboardMode" Style="{StaticResource TcSegment}" Content="Auto" Tag="Auto" Click="Keyboard_Click" Margin="5,0,0,0" /></Grid></StackPanel></Border>
                            <Border Style="{StaticResource TcSection}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Auto behavior" FontWeight="SemiBold" /><TextBlock Text="Active: High     Idle 15 s: Low     Idle 35 s: Off" Margin="0,11,0,0" /><TextBlock Text="Auto is a ThinkControl policy, not a claim that every ThinkPad firmware exposes a native Auto backlight state." Foreground="{DynamicResource Tc.TextMuted}" TextWrapping="Wrap" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,7,0,0" /></StackPanel></Border>
                            <controls:KeyboardEffectsPanel x:Name="KeyboardEffectsPanelControl" Margin="0,14,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageTouchpad" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <controls:TouchpadPanel x:Name="TouchpadPanelControl" Margin="0" />
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageSystem" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="960" HorizontalAlignment="Left"><TextBlock Text="System" Style="{StaticResource TcText.PageTitle}" /><TextBlock Text="Only non-unique hardware identity is shown here. Serial numbers, MAC addresses and disk IDs are not collected." Style="{StaticResource TcText.PageSubtitle}" Margin="0,6,0,18" TextWrapping="Wrap" />
                        <Border Style="{StaticResource TcSection}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CPU" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" /><TextBlock Text="{Binding CpuName}" Margin="0,4,12,13" TextWrapping="Wrap" /><TextBlock Text="GPU" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" /><TextBlock Text="{Binding GpuName}" Margin="0,4,12,13" TextWrapping="Wrap" /><TextBlock Text="RAM" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" /><TextBlock Text="{Binding RamText}" Margin="0,4,0,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="BIOS" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" /><TextBlock Text="{Binding BiosVersion}" Margin="0,4,12,13" /><TextBlock Text="Machine type" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" /><TextBlock Text="{Binding MachineType}" Margin="0,4,12,13" /><TextBlock Text="Hardware access" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" /><TextBlock Text="{Binding HardwareAccess}" Margin="0,4,12,0" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Thermal solution" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" /><TextBlock Text="{Binding ThermalSolution}" Margin="0,4,0,13" TextWrapping="Wrap" /><TextBlock Text="Drivers" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" /><TextBlock Text="{Binding DriverStatus}" Margin="0,4,0,13" TextWrapping="Wrap" /><TextBlock Text="ThinkControl" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" /><TextBlock Text="{Binding AppVersion}" Margin="0,4,0,0" /></StackPanel></Grid></Border>
                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TcSection}" Margin="0,0,7,0"><StackPanel><TextBlock Text="Power &amp; startup" FontWeight="SemiBold" /><TextBlock Text="Windows behavior for sleep, the power button and closing the lid." Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,5,0,12" /><WrapPanel><Button Content="Lid &amp; power buttons ↗" Style="{StaticResource TcExternalSettingsLink}" Margin="0,0,8,8" Click="PowerOptions_Click" /><Button Content="Screen &amp; sleep ↗" Style="{StaticResource TcExternalSettingsLink}" Margin="0,0,8,8" Tag="ms-settings:powersleep" Click="OpenUrl_Click" /><Button Content="Display settings ↗" Style="{StaticResource TcExternalSettingsLink}" Margin="0,0,8,8" Tag="ms-settings:display" Click="OpenUrl_Click" /></WrapPanel></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource TcSection}" Margin="7,0,0,0"><StackPanel><TextBlock x:Name="SystemVendorCardTitle" Text="Device &amp; drivers" FontWeight="SemiBold" /><TextBlock x:Name="SystemVendorCardDetail" Text="Windows driver updates plus one detected-vendor shortcut when it is useful." Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,5,0,12" /><WrapPanel x:Name="SystemVendorButtons"><Button x:Name="SystemVendorPrimaryButton" Visibility="Collapsed" Style="{StaticResource TcButton}" Margin="0,0,8,8" Click="OpenUrl_Click" /><Button Content="Windows Update ↗" Style="{StaticResource TcExternalSettingsLink}" Margin="0,0,8,8" Tag="ms-settings:windowsupdate" Click="OpenUrl_Click" /><Button Content="Optional updates ↗" Style="{StaticResource TcExternalSettingsLink}" Margin="0,0,8,8" Tag="ms-settings:windowsupdate-optionalupdates" Click="OpenUrl_Click" /></WrapPanel></StackPanel></Border>
                        </Grid>
                    </StackPanel></ScrollViewer>

                    <ScrollViewer x:Name="PageUpdates" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Updates" Style="{StaticResource TcText.PageTitle}" /><TextBlock Text="ThinkControl uses GitHub Releases as the update channel. Update installation remains explicit; there is no permanent updater service." Style="{StaticResource TcText.PageSubtitle}" Margin="0,6,0,18" TextWrapping="Wrap" /><Border Style="{StaticResource TcSection}"><StackPanel><TextBlock Text="Current version" Foreground="{DynamicResource Tc.TextMuted}" /><TextBlock Text="{Binding AppVersion}" FontSize="{x:Static ui:TypographyScale.PageTitle}" FontWeight="Light" Margin="0,5,0,16" /><TextBlock Text="{Binding UpdateStatus}" FontSize="{x:Static ui:TypographyScale.Secondary}" /><StackPanel Orientation="Horizontal" Margin="0,15,0,0"><Button Content="Check for updates" Style="{StaticResource TcButton}" Click="CheckUpdates_Click" /><Button x:Name="OpenReleaseButton" Content="Open release" Style="{StaticResource TcButton}" Margin="8,0,0,0" Click="OpenRelease_Click" IsEnabled="False" /></StackPanel></StackPanel></Border></StackPanel></ScrollViewer>

                    <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Settings" Style="{StaticResource TcText.PageTitle}" /><TextBlock Text="Keep the daily surface compact; deeper preferences and compatibility tools live here." Style="{StaticResource TcText.PageSubtitle}" Margin="0,6,0,18" TextWrapping="Wrap" /><Border Style="{StaticResource TcSection}"><StackPanel><TextBlock Text="Theme" FontWeight="SemiBold" /><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource TcSegment}" Content="System" Tag="System" Click="Theme_Click" Margin="0,0,6,0" IsChecked="True" /><RadioButton Grid.Column="1" GroupName="Theme" Style="{StaticResource TcSegment}" Content="Dark" Tag="Dark" Click="Theme_Click" Margin="3,0" /><RadioButton Grid.Column="2" GroupName="Theme" Style="{StaticResource TcSegment}" Content="Light" Tag="Light" Click="Theme_Click" Margin="6,0,0,0" /></Grid></StackPanel></Border><Border Style="{StaticResource TcSection}" Margin="0,14,0,0"><Grid><StackPanel><TextBlock Text="Start with Windows" FontWeight="SemiBold" /><TextBlock Text="Launch ThinkControl directly into the tray after sign-in." Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,4,70,0" /></StackPanel><CheckBox x:Name="StartupSwitch" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource TcSwitch}" Click="StartupSwitch_Click" /></Grid></Border><Border Style="{StaticResource TcSection}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Background behavior" FontWeight="SemiBold" /><TextBlock Text="Closing either window hides it to the tray. Use Quit from the tray menu to stop ThinkControl completely." Foreground="{DynamicResource Tc.TextMuted}" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel></Border><controls:DiagnosticsPanel x:Name="DiagnosticsPanelControl" Margin="0,14,0,0" /></StackPanel></ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
