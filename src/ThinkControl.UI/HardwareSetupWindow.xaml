<Window x:Class="ThinkControl.UI.HardwareSetupWindow"
             xmlns:ui="clr-namespace:ThinkControl.UI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
        Title="ThinkControl · Required component"
        Width="560" Height="360"
        MinWidth="500" MinHeight="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Tc.Window}"
        Foreground="{DynamicResource Tc.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="Assets/ThinkControl.ico">
    <Grid Background="{DynamicResource Tc.Window}">
        <Grid Margin="26,22,22,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:BrandMark Width="28" Height="28" Margin="0,0,11,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ThinkControl" FontSize="{x:Static ui:TypographyScale.Caption}" FontWeight="SemiBold" />
                    <TextBlock Text="Required component" Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Caption}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource TcIconButton}" Width="34" Height="34" Margin="12,-2,-2,0" ToolTip="Close" Click="Close_Click">
                    <controls:PackIconLucide Kind="Close" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource TcSection}" Margin="0,20,0,0" Padding="20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Tc.SurfaceAlt}" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <controls:PackIconLucide x:Name="StatusIcon" Kind="Sensors" Width="17" Height="17" Foreground="{DynamicResource Tc.Warning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="2,0,0,0">
                            <TextBlock x:Name="PrimaryTitleText" Text="Checking required component" FontSize="{x:Static ui:TypographyScale.SectionTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="PrimaryStatusText" Text="ThinkControl is checking what this PC needs." Foreground="{DynamicResource Tc.TextMuted}" FontSize="{x:Static ui:TypographyScale.Secondary}" LineHeight="17" TextWrapping="Wrap" Margin="0,7,0,0" />
                            <TextBlock x:Name="ResultText" Foreground="{DynamicResource Tc.TextFaint}" FontSize="{x:Static ui:TypographyScale.Caption}" TextWrapping="Wrap" Margin="0,9,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" x:Name="ActionRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource TcButton}" MinWidth="88" Margin="0,0,8,0" Click="Close_Click" />
                        <Button x:Name="PrimaryActionButton" Content="Continue" Style="{StaticResource TcButton}" MinWidth="132" Click="PrimaryAction_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
