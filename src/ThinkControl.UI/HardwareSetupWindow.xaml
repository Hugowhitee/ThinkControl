<Window x:Class="ThinkControl.UI.HardwareSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
        Title="ThinkControl Hardware setup"
        Width="700" Height="720"
        MinWidth="600" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Tc.Window}"
        Foreground="{DynamicResource Tc.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="Assets/ThinkControl.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <controls:BrandMark Width="32" Height="32" Margin="0,0,13,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Hardware setup" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="SetupIntroText"
                                   Text="ThinkControl checks the Windows service, sensor providers and detected device-specific hardware providers independently. Nothing is installed or elevated until you choose a repair action."
                                   Foreground="{DynamicResource Tc.TextMuted}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource TcSection}" Margin="0,20,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Hardware check &amp; repair" FontWeight="SemiBold" />
                            <TextBlock Text="Checks current readiness. If a component fails, ThinkControl repairs only that component, then performs one clean provider rebuild and readback."
                                       Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button x:Name="FixDetectedIssuesButton" Grid.Column="1" Content="Check / repair" Style="{StaticResource TcButton}" MinWidth="128" VerticalAlignment="Center" Click="FixDetectedIssues_Click" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource TcSection}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ThinkControl hardware service" FontWeight="SemiBold" />
                            <TextBlock x:Name="ServiceStatusText" Text="Checking…" Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Privileged hardware operations run in the Windows service. The normal ThinkControl UI does not need to run as Administrator."
                                       Foreground="{DynamicResource Tc.TextFaint}" FontSize="9.5" Margin="0,4,16,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="RepairServiceButton" Grid.Column="1" Content="Repair service" Style="{StaticResource TcButton}" MinWidth="112" VerticalAlignment="Center" Click="RepairService_Click" />
                    </Grid>
                </Border>

                <Border x:Name="LowLevelCard" Style="{StaticResource TcSection}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PawnIO hardware access" FontWeight="SemiBold" />
                            <TextBlock x:Name="LowLevelStatusText" Text="Checking…" Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,18,0" />
                            <TextBlock Text="ThinkControl verifies more than the Windows service entry: the hardware service must be able to open the PawnIO device and load the LibreHardwareMonitor LPC module. A registered driver that cannot do that is treated as needing repair."
                                       Foreground="{DynamicResource Tc.TextFaint}" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,16,0" />
                        </StackPanel>
                        <Button x:Name="InstallLowLevelButton" Grid.Column="1" Content="Install PawnIO" Style="{StaticResource TcButton}" MinWidth="128" VerticalAlignment="Center" Click="InstallLowLevel_Click" />
                    </Grid>
                </Border>

                <Border x:Name="SensorProviderCard" Style="{StaticResource TcSection}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Sensors · LibreHardwareMonitor / PawnIO" FontWeight="SemiBold" />
                            <TextBlock x:Name="SensorProviderStatusText" Text="Checking…" Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="LibreHardwareMonitor 0.9.6 contains explicit Lunar Lake support. Provider retries are bounded, and an empty provider is rebuilt only on a deliberate retry or slow recovery cycle."
                                       Foreground="{DynamicResource Tc.TextFaint}" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,16,0" />
                        </StackPanel>
                        <Button x:Name="RetrySensorsButton" Grid.Column="1" Content="Recheck" Style="{StaticResource TcButton}" MinWidth="96" VerticalAlignment="Center" Click="RetryProviders_Click" Tag="Sensors" />
                    </Grid>
                </Border>

                <Border x:Name="FanProviderCard" Style="{StaticResource TcSection}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Fan provider · ThinkPad X9 EC" FontWeight="SemiBold" />
                            <TextBlock x:Name="FanProviderStatusText" Text="Checking…" Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="The verified X9 path now probes the modern ThinkPad 0x1604/0x1600 EC ports first and the legacy 0x66/0x62 pair second, matching established TPFanCtrl behavior. Detection is read-only; fan writes remain limited to levels 1–7 with readback and Lenovo Auto fallback."
                                       Foreground="{DynamicResource Tc.TextFaint}" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,16,0" />
                        </StackPanel>
                        <Button x:Name="RetryFanButton" Grid.Column="1" Content="Recheck" Style="{StaticResource TcButton}" MinWidth="96" VerticalAlignment="Center" Click="RetryProviders_Click" Tag="Fans" />
                    </Grid>
                </Border>

                <Border x:Name="LenovoDriverCard" Style="{StaticResource TcSection}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Keyboard provider · Lenovo platform" FontWeight="SemiBold" />
                            <TextBlock x:Name="LenovoDriverStatusText" Text="Checking…" Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="ThinkControl probes Lenovo PM/EnergyDrv contracts with readback. Lenovo Vantage is only a fallback for platform components; ThinkControl does not need to open it for normal keyboard changes."
                                       Foreground="{DynamicResource Tc.TextFaint}" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,16,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="RetryKeyboardButton" Content="Recheck" Style="{StaticResource TcButton}" MinWidth="96" Click="RetryProviders_Click" Tag="Keyboard" />
                            <Button x:Name="OpenVantageButton" Content="Lenovo Vantage" Style="{StaticResource TcButton}" MinWidth="112" Margin="0,7,0,0" Click="OpenVantage_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource TcSection}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Repair result" FontWeight="SemiBold" />
                        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Administrator permission is requested only when Windows actually needs a service or PawnIO repair. Provider rechecks and read-only diagnostics require no new UAC prompt."
                       Foreground="{DynamicResource Tc.TextFaint}" FontSize="9.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,20,0" />
            <Button Grid.Column="1" Content="Done" HorizontalAlignment="Right" Style="{StaticResource TcButton}" MinWidth="92" Click="Continue_Click" />
        </Grid>
    </Grid>
</Window>
