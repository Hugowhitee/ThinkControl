<Window x:Class="ThinkControl.UI.HardwareSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ThinkControl.UI.Controls"
        Title="ThinkControl Hardware setup"
        Width="620" Height="470"
        MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Tc.Window}"
        Foreground="{DynamicResource Tc.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="Assets/ThinkControl.ico">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <controls:BrandMark Width="32" Height="32" Margin="0,0,13,0" />
                <StackPanel Grid.Column="1"><TextBlock Text="Hardware setup" FontSize="22" FontWeight="SemiBold" /><TextBlock x:Name="SetupIntroText" Text="ThinkControl checks only the controls this PC can use." Foreground="{DynamicResource Tc.TextMuted}" FontSize="11.5" Margin="0,4,0,0" /></StackPanel>
            </Grid>
            <Border Style="{StaticResource TcSection}" Margin="0,22,0,0" Padding="22">
                <StackPanel>
                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Tc.SurfaceAlt}" HorizontalAlignment="Left">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Tc.Warning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="PrimaryTitleText" Text="Checking hardware readiness" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,0" />
                    <TextBlock x:Name="PrimaryStatusText" Text="One moment while ThinkControl checks this PC." Foreground="{DynamicResource Tc.TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <Border Background="{DynamicResource Tc.SurfaceAlt}" BorderBrush="{DynamicResource Tc.Border}" BorderThickness="1" CornerRadius="3" Padding="12,9" Margin="0,18,0,0">
                        <StackPanel><TextBlock Text="What happens next" FontWeight="SemiBold" FontSize="11.5" /><TextBlock x:Name="ProgressStepsText" Text="Check and verify safely" Foreground="{DynamicResource Tc.TextMuted}" FontSize="10.5" Margin="0,4,0,0" /></StackPanel>
                    </Border>
                    <Button x:Name="FixDetectedIssuesButton" Content="Check again" Style="{StaticResource TcButton}" HorizontalAlignment="Left" MinWidth="156" Margin="0,18,0,0" Click="FixDetectedIssues_Click" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="ResultText" Foreground="{DynamicResource Tc.TextFaint}" FontSize="10.5" TextWrapping="Wrap" Margin="2,14,2,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,0"><TextBlock Text="Windows asks for permission only when a repair requires it." Foreground="{DynamicResource Tc.TextFaint}" FontSize="10" VerticalAlignment="Center" /><Button Content="Done" HorizontalAlignment="Right" Style="{StaticResource TcButton}" MinWidth="82" Click="Continue_Click" /></Grid>
    </Grid>
</Window>
