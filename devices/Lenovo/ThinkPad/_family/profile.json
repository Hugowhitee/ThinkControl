{
  "schemaVersion": 2,
  "id": "lenovo.thinkpad.family",
  "displayName": "Lenovo ThinkPad family",
  "status": "beta-untested",
  "match": {
    "manufacturer": "LENOVO",
    "productNameContains": ["ThinkPad"]
  },
  "providers": {
    "windows": ["powerMode", "display", "brightness", "batteryTelemetry"],
    "keyboard": ["IBMPmDrv", "LenovoVantageKeyboardAddin"],
    "fanTelemetry": ["LENOVO_FAN_METHOD", "Lenovo_DT_GetCPUFan", "Lenovo_DT_GetSYSFan", "CIM_Tachometer"],
    "thermalPolicy": ["WindowsPowerMode", "LITSSVC-when-present"]
  },
  "capabilities": {
    "keyboardBacklight": "probe-and-readback",
    "fanRpm": "read-only-probe",
    "fanControl": "profile-specific-only",
    "performanceMode": "windows-safe",
    "batteryTelemetry": "windows-safe",
    "display": "windows-safe"
  },
  "safety": {
    "directEcWrites": false,
    "unknownIoctlWrites": false,
    "remoteMetadataMayEnableWrites": false,
    "betaRequiresProviderProbe": true
  }
}
