{
  "schemaVersion": 2,
  "id": "lenovo.thinkpad.x9-15-gen1",
  "displayName": "ThinkPad X9-15 Gen 1",
  "status": "verified-reference",
  "match": {
    "manufacturer": "LENOVO",
    "machineTypes": ["21Q6", "21Q7"]
  },
  "providers": {
    "windows": ["powerMode", "display", "brightness", "adaptiveBrightness", "batteryTelemetry"],
    "keyboard": ["IBMPmDrv"],
    "fanTelemetry": ["X9ThinkPadEc", "LENOVO_FAN_METHOD", "CIM_Tachometer"],
    "fanControl": ["X9ThinkPadEc"],
    "thermalPolicy": ["WindowsPowerMode", "LITSSVC-research-record"]
  },
  "capabilities": {
    "performanceMode": { "verification": "implemented-windows-api" },
    "lenovoThermalPolicy": { "verification": "research-verified" },
    "cpuTemperature": { "verification": "implemented-read-only-provider" },
    "fanRpm": { "verification": "implemented-research-verified" },
    "fanControl": { "verification": "implemented-research-verified", "implementation": "levels-1-7-plus-lenovo-auto" },
    "keyboardBacklight": { "verification": "implemented-write-readback" },
    "displayRefresh": { "verification": "implemented-windows-api" },
    "adaptiveBrightness": { "verification": "implemented-windows-api-when-supported" },
    "batteryTelemetry": { "verification": "implemented-read-only" }
  },
  "dependencies": {
    "hardwareAccess": {
      "pawnIo": {
        "install": "required-for-direct-x9-ec-backend",
        "capabilities": ["fanRpm", "fanControl"]
      }
    },
    "oemExpected": [
      {
        "id": "lenovoIntelligentThermalSolution",
        "service": "LITSSVC",
        "capabilities": ["lenovoThermalPolicy"]
      },
      {
        "id": "lenovoPowerManagement",
        "service": "IBMPMSVC",
        "capabilities": ["keyboardBacklight"]
      }
    ]
  },
  "research": {
    "fan": {
      "transport": "classic-thinkpad-ec",
      "controlRegister": "0x2F",
      "tachometerRegisters": ["0x84", "0x85"],
      "lenovoAutoValue": "0x80",
      "manualLevels": [1, 2, 3, 4, 5, 6, 7],
      "tachometerPolling": "sparse"
    },
    "lits": {
      "service": "LITSSVC",
      "acpiDevice": "ACPI\\LEN0100",
      "pipe": "com.lenovo.its.pipe.setting"
    }
  },
  "safety": {
    "hardwareWritesEnabled": true,
    "hardwareWritesScope": "verified-x9-fan-and-readback-keyboard-contracts-only",
    "blockedFanValues": ["0x00", "0x40"],
    "remoteMetadataMayEnableWrites": false
  }
}
